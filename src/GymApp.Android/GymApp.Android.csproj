<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Android head (16c): starts the shared GymApp.App on Android 8 (API 26) and later -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GymApp.Android</RootNamespace>
    <ApplicationId>com.gainstreak.app</ApplicationId>
    <ApplicationTitle>GainStreak</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- The versionCode: only goes up. build/release-mobile.sh sets it to the commit count -->
    <ApplicationVersion>1</ApplicationVersion>
    <!-- An APK installs straight onto an emulator or phone. Release builds make the App Bundle for Google Play too
         (build/release-mobile.sh signs both) -->
    <AndroidPackageFormat Condition="'$(Configuration)' != 'Release'">apk</AndroidPackageFormat>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Release'">aab;apk</AndroidPackageFormats>
    <DefaultDebugServerUrl>http://10.0.2.2:5080</DefaultDebugServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- Friend notifications (Phase 22) through Firebase Cloud Messaging -->
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GymApp.App\GymApp.App.csproj" />
  </ItemGroup>

  <!-- Firebase's config for this app (Phase 22), never in the repo: the path in GAINSTREAK_GOOGLE_SERVICES_JSON, or a
       google-services.json next to this file (gitignored). Without it the app builds and runs with friend
       notifications off (AndroidPushNotifications.IsSupported is false) -->
  <PropertyGroup>
    <GoogleServicesFile Condition="'$(GoogleServicesFile)' == ''">$(GAINSTREAK_GOOGLE_SERVICES_JSON)</GoogleServicesFile>
    <GoogleServicesFile Condition="'$(GoogleServicesFile)' == '' and Exists('google-services.json')">google-services.json</GoogleServicesFile>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="google-services.json" />
    <GoogleServicesJson Include="$(GoogleServicesFile)" Link="google-services.json" Condition="'$(GoogleServicesFile)' != '' and Exists('$(GoogleServicesFile)')" />
  </ItemGroup>

  <Import Project="..\MobileHead.targets" />
</Project>
