<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<!-- The social server and the map; the reminders' notifications (16g, asked for when they're turned on) -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- "Verified at gym" (18c): while a live workout is open on screen only; no background location -->
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<application android:label="GainStreak" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
	             android:networkSecurityConfig="@xml/network_security_config">
		<!-- Friend notifications (Phase 22) that Android shows itself while the app is in the background -->
		<meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_notification" />
		<meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="friends" />
	</application>
</manifest>
