<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GymApp.Core\GymApp.Core.csproj" />
    <ProjectReference Include="..\GymApp.Data\GymApp.Data.csproj" />
    <ProjectReference Include="..\GymApp.Social\GymApp.Social.csproj" />
    <ProjectReference Include="..\GymApp.Client\GymApp.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The USDA catalog (Phase 26), built by tools/food-catalog and extracted to the data folder when its version changes -->
    <EmbeddedResource Include="Catalog\foods.db" LogicalName="GymApp.Services.foods.db" />
    <EmbeddedResource Include="Catalog\foods.version" LogicalName="GymApp.Services.foods.version" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The kcal-only food methods (before Phase 27) are internal: the app types macros, the tests still build old-style data -->
    <InternalsVisibleTo Include="GymApp.Tests" />
  </ItemGroup>
</Project>
