<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gainstreak.ico</ApplicationIcon>
    <!-- The executable's name, which the macOS Dock and the Windows taskbar show. Namespaces stay GymApp.Desktop and GymApp.App -->
    <AssemblyName>GainStreak</AssemblyName>
    <RootNamespace>GymApp.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- The release settings from Directory.Build.props, read back by BuildSettings -->
  <ItemGroup>
    <AssemblyMetadata Include="GymAppServerUrl" Value="$(GymAppServerUrl)" Condition="'$(GymAppServerUrl)' != ''" />
    <AssemblyMetadata Include="GymAppUpdateUrl" Value="$(GymAppUpdateUrl)" Condition="'$(GymAppUpdateUrl)' != ''" />
  </ItemGroup>

  <!-- A release published without a server address would only show "can't reach its server" -->
  <Target Name="RequireServerUrl" BeforeTargets="PrepareForPublish"
          Condition="'$(Configuration)' == 'Release' and '$(GymAppServerUrl)' == ''">
    <Error Text="Set GymAppServerUrl (in Directory.Build.props or with -p:GymAppServerUrl=https://...) before publishing a release." />
  </Target>

  <!-- macOS: use Network.framework for HTTPS, which supports TLS 1.3. The default (SecureTransport) stops at
       TLS 1.2, and overpass-api.de (gym fetch) only accepts TLS 1.3. No effect on Windows or Linux. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Net.Security.UseNetworkFramework" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- The startup project for "dotnet ef migrations" on the app's database -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared UI; Core, Data and Services come with it -->
    <ProjectReference Include="..\GymApp.App\GymApp.App.csproj" />
  </ItemGroup>
</Project>
