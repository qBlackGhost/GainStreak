<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             x:Class="GymApp.Desktop.Views.SplitsView"
             x:DataType="vm:SplitsViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="SplitCard" x:DataType="vm:SplitItemViewModel">
            <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="★ Recommended" Foreground="Goldenrod"
                                       IsVisible="{Binding IsRecommended}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <Button Content="{Binding UseLabel}" Command="{Binding UseCommand}"
                                IsEnabled="{Binding !IsSelected}"/>
                        <Button Content="Edit" Command="{Binding EditCommand}" IsVisible="{Binding IsCustom}"/>
                        <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}"
                                IsVisible="{Binding IsCustom}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="24" MaxWidth="720" HorizontalAlignment="Center">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding BackCommand}"/>
                <TextBlock Text="Workout splits" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <TextBlock Text="Presets" FontSize="18" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource SplitCard}"/>

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="+ New split" Command="{Binding NewCommand}"
                        IsEnabled="{Binding CanAddCustom}"/>
                <StackPanel>
                    <TextBlock Text="My splits" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CustomCounter}" Opacity="0.7"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Custom}" ItemTemplate="{StaticResource SplitCard}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
