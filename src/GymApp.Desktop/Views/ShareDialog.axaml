<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             xmlns:v="using:GymApp.Desktop.Views"
             x:Class="GymApp.Desktop.Views.ShareDialog"
             x:DataType="vm:ShareDialogViewModel"
             IsVisible="{Binding IsOpen}">
    <!-- The share popup over Workouts and Splits: what to share, who gets it, and what they'll receive -->
    <UserControl.Styles>
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource Scrim}" Padding="24">
        <Border MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" CornerRadius="18"
                Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="ExtraBold"/>
                        <TextBlock Text="{Binding Explanation}" FontSize="13" Classes="soft"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding CloseCommand}" VerticalAlignment="Top"
                            ToolTip.Tip="Close" AutomationProperties.Name="Close">
                        <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.4"/>
                    </Button>
                </Grid>

                <!-- What -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ChoiceLabel}" Classes="caps" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding NoChoicesText}" FontSize="14" Classes="muted" IsVisible="{Binding HasNoChoices}"/>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShareChoiceViewModel">
                                    <Button Classes="source" Classes.on="{Binding IsSelected}" Command="{Binding ChooseCommand}">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Classes="muted"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Who -->
                <StackPanel Spacing="8">
                    <TextBlock Text="FRIENDS" Classes="caps" FontWeight="SemiBold"/>
                    <StackPanel Spacing="8" IsVisible="{Binding HasNoFriends}">
                        <TextBlock Text="You can share with friends once you've added some." FontSize="14" Classes="muted"/>
                        <Button Classes="btn outline small" HorizontalAlignment="Left" Content="Find friends"
                                Command="{Binding FindFriendsCommand}"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Friends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShareFriendViewModel">
                                    <CheckBox IsChecked="{Binding IsChecked}" MinHeight="44" Padding="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Classes="avatar">
                                                <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <TextBlock Text="{Binding Error}" Classes="error" FontSize="13"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="btn outline" Content="Cancel" Command="{Binding CloseCommand}"/>
                    <Button Classes="btn primary" Command="{Binding SendCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <v:Icon Data="{StaticResource IcShare}" Width="16" Height="16"/>
                            <TextBlock Text="{Binding SendLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
