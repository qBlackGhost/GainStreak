<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             xmlns:v="using:GymApp.Desktop.Views"
             x:Class="GymApp.Desktop.Views.GymPickerView"
             x:DataType="vm:GymPickerViewModel">
    <!-- The gym picker dialog on the Map screen (FRIENDS_GYM_MAP.md 4e): your gym, today's gym, or the home city.
         An overlay over the page with a centred card, max 520 × 680; the list scrolls inside it. -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.gymRow">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.gymRow.current">
            <Setter Property="Background" Value="{DynamicResource LimeTint}"/>
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource Scrim}" Padding="24" TextElement.Foreground="{DynamicResource Ink}">
        <Border Width="520" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20"
                CornerRadius="18" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Control}" BorderThickness="1"
                BoxShadow="0 24 80 0 #B3000000">
            <DockPanel>
                <!-- Title -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="13" Classes="muted"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="btn outline" Width="36" Height="36" MinHeight="36" Padding="0"
                            Foreground="{DynamicResource Soft}" VerticalAlignment="Top" Command="{Binding CloseCommand}"
                            ToolTip.Tip="Close" AutomationProperties.Name="Close">
                        <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.6" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Classes="error" FontSize="13" Margin="0,0,0,8"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Info}" Foreground="{DynamicResource AccentInk}" FontSize="13" Margin="0,0,0,8"
                           IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- ===== Choosing a city ===== -->
                <StackPanel DockPanel.Dock="Top" Spacing="10" IsVisible="{Binding IsChoosingCity}">
                    <TextBlock Text="{Binding CityPrompt}" FontSize="15" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Panel>
                            <TextBox x:Name="CityBox" Classes="field" Padding="36,0,12,0" PlaceholderText="City name, e.g. Timișoara"
                                     Text="{Binding CitySearchText}" MaxLength="100"/>
                            <v:Icon Data="{StaticResource IcSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="2.2" Width="15" Height="15"
                                    HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Panel>
                        <Button Grid.Column="1" Classes="btn light" MinHeight="42" Content="Search" Command="{Binding SearchCityCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding CitySearchMessage}" FontSize="13" Classes="soft"
                               IsVisible="{Binding CitySearchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Button Classes="btn outline small" Content="Retry" HorizontalAlignment="Left"
                            Command="{Binding SearchCityCommand}" IsVisible="{Binding CanRetryCitySearch}"/>
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasCityCandidates}">
                        <ItemsControl ItemsSource="{Binding CityCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CityCandidateViewModel">
                                    <Border Classes="gymRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" Classes="muted"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="btn light small" Content="Choose" Command="{Binding ChooseCommand}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <CheckBox Content="Also make this my home city" IsChecked="{Binding SaveAsHomeCity}" FontSize="13"
                              IsVisible="{Binding Mode, Converter={x:Static v:GymPickerView.IsNotCityMode}}"/>
                    <Button Classes="btn outline small" Content="Cancel" HorizontalAlignment="Left" Command="{Binding CancelChangeCityCommand}"/>
                </StackPanel>

                <!-- ===== Footer of the list ===== -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0" IsVisible="{Binding ShowList}">
                    <CheckBox IsChecked="{Binding MakeMyGym}" FontSize="13" IsVisible="{Binding ShowMakeMyGym}"
                              Content="Make this my gym (preselected at every check-in)"/>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <Panel IsVisible="{Binding !IsGymFormOpen}">
                            <Rectangle Stroke="{DynamicResource ControlHover}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="10" RadiusY="10"/>
                            <Button Classes="btn small" MinHeight="40" Background="Transparent" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"
                                    Command="{Binding StartAddGymCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <v:Icon Data="{StaticResource IcPlus}" StrokeThickness="2.4" Width="16" Height="16"/>
                                    <TextBlock Text="Add custom gym" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Panel>
                        <Button Grid.Column="2" Classes="btn outline small" MinHeight="40" Content="No gym today"
                                Command="{Binding ClearGymCommand}" IsVisible="{Binding HasCurrentGym}"/>
                        <Button Grid.Column="3" Classes="btn outline small" MinHeight="40" Content="Cancel" Command="{Binding CloseCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- ===== Gym list ===== -->
                <DockPanel IsVisible="{Binding ShowList}">
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Panel>
                                <TextBox Classes="field" Padding="36,0,12,0" Text="{Binding SearchText}"
                                         PlaceholderText="{Binding CityName, StringFormat='Search gyms in {0}'}"
                                         AutomationProperties.Name="Search gyms by name"/>
                                <v:Icon Data="{StaticResource IcSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="2.2" Width="15" Height="15"
                                        HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                            </Panel>
                            <Border Grid.Column="1" Padding="3" CornerRadius="10" Background="{DynamicResource Fill}">
                                <v:SegmentedPill SelectedIndex="{Binding SortIndex}" PillInset="0" PillCornerRadius="8">
                                    <Button Classes="seg" Classes.on="{Binding SortByName}" MinHeight="34" Padding="12,0"
                                            CornerRadius="8" Content="A–Z" Command="{Binding SortNameCommand}"/>
                                    <Button Classes="seg" Classes.on="{Binding SortByDistance}" MinHeight="34" Padding="12,0"
                                            CornerRadius="8" Content="Nearest" Command="{Binding SortNearestCommand}"/>
                                </v:SegmentedPill>
                            </Border>
                            <Button Grid.Column="2" Classes="btn outline" Width="42" Height="42" MinHeight="42" Padding="0"
                                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsFetching}"
                                    ToolTip.Tip="{Binding LastUpdatedText, StringFormat='Refresh · {0}'}" AutomationProperties.Name="Refresh gyms">
                                <v:Icon Data="{StaticResource IcRefresh}" StrokeThickness="2.2" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock FontSize="12" Classes="muted">
                                <Run Text="{Binding CountText}"/><Run Text=" in "/><Run Text="{Binding CityName}"/><Run Text=" · "/><Run
                                     Text="{Binding LastUpdatedText}"/>
                            </TextBlock>
                            <Button Grid.Column="1" Classes="link" FontSize="12" Content="Change city" Command="{Binding ChangeCityCommand}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsFetching}">
                            <ProgressBar IsIndeterminate="True" Width="80" Height="4" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FetchingText}" FontSize="12" Classes="muted" VerticalAlignment="Center"/>
                            <Button Classes="link" FontSize="12" Content="Try again" Command="{Binding RestartFetchCommand}"
                                    IsVisible="{Binding IsFetchSlow}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding AddressLookupText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding AddressLookupText}" FontSize="12" Classes="muted" VerticalAlignment="Center"/>
                            <Button Classes="link" FontSize="12" Content="Retry" Command="{Binding RetryAddressLookupCommand}"
                                    IsVisible="{Binding CanRetryAddressLookup}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RefreshNote}" FontSize="12" Foreground="{DynamicResource FlameText}"
                                   IsVisible="{Binding RefreshNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Border Padding="12" CornerRadius="10" Background="{DynamicResource RedTint}" BorderBrush="{DynamicResource RedTintLine}" BorderThickness="1"
                                IsVisible="{Binding FetchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock Text="{Binding FetchError}" FontSize="13" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="btn outline small" Content="Retry" Command="{Binding RetryCommand}"
                                        IsEnabled="{Binding !IsFetching}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Add / edit a custom gym -->
                    <Border DockPanel.Dock="Bottom" Padding="14" CornerRadius="12" Background="{DynamicResource Surface2}" Margin="0,8,0,0"
                            IsVisible="{Binding IsGymFormOpen}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding GymFormTitle}" FontSize="15" FontWeight="Bold"/>
                            <TextBox Classes="field" PlaceholderText="Name" Text="{Binding GymFormName}" MaxLength="{Binding MaxNameLength}"/>
                            <TextBlock Classes="fieldError" Text="{Binding GymFormNameError}"
                                       IsVisible="{Binding GymFormNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="Address (optional)" FontSize="12" Classes="muted"/>
                            <StackPanel Spacing="6" IsVisible="{Binding HasFormAddress}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding FormAddressText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="link" FontSize="12" Content="Change" Command="{Binding ChangeFormAddressCommand}"/>
                                    <Button Grid.Column="2" Classes="link" FontSize="12" Content="Remove" Command="{Binding ClearFormAddressCommand}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowHouseNumber}">
                                    <TextBox Classes="field" Width="100" PlaceholderText="No." Text="{Binding FormHouseNumber}"
                                             MaxLength="{Binding MaxHouseNumberLength}"/>
                                    <TextBlock Text="OpenStreetMap only knows the street here." FontSize="12" Classes="muted" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="6" IsVisible="{Binding ShowAddressSearch}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="AddressBox" Classes="field" PlaceholderText="Street and number, e.g. Calea Aradului 1"
                                             Text="{Binding AddressQuery}" MaxLength="100"/>
                                    <Button Grid.Column="1" Classes="btn outline small" MinHeight="42" Content="Find" Command="{Binding SearchAddressCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding AddressSearchMessage}" FontSize="12" Classes="muted"
                                           IsVisible="{Binding AddressSearchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <Button Classes="link" FontSize="12" Content="Retry" Command="{Binding SearchAddressCommand}"
                                        IsVisible="{Binding CanRetryAddressSearch}"/>
                                <ItemsControl ItemsSource="{Binding AddressCandidates}" IsVisible="{Binding HasAddressCandidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AddressCandidateViewModel">
                                            <Border Classes="gymRow" MinHeight="44">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" Classes="muted"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="btn light small" Content="Use" Command="{Binding PickCommand}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Classes="fieldError" Text="{Binding GymFormAddressError}"
                                       IsVisible="{Binding GymFormAddressError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding GymFormError}" Classes="error" FontSize="13"
                                       IsVisible="{Binding GymFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="btn primary small" Content="Save" Command="{Binding SaveGymFormCommand}"/>
                                <Button Classes="btn outline small" Content="Cancel" Command="{Binding CancelGymFormCommand}"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Classes="muted"
                                       Text="Only you see your custom gyms (up to 10), and friends only ever see their name. With an address they get a distance."/>
                        </StackPanel>
                    </Border>

                    <!-- The list: scrolls inside the card -->
                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="160" Padding="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{Binding EmptyText}" FontSize="14" Classes="muted" Margin="2,16" IsVisible="{Binding !HasGyms}"/>
                                <ItemsControl ItemsSource="{Binding Gyms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GymRowViewModel">
                                            <Border Classes="gymRow" Classes.current="{Binding IsCurrent}">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <WrapPanel ItemSpacing="6" LineSpacing="4">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                <Border Classes="badge" Background="{DynamicResource Accent}" IsVisible="{Binding IsHome}">
                                                                    <TextBlock Text="Your gym" FontSize="11" FontWeight="Bold" Foreground="Black"/>
                                                                </Border>
                                                                <Border Classes="badge" BorderBrush="{DynamicResource ControlHover}" BorderThickness="1" IsVisible="{Binding IsCustom}">
                                                                    <TextBlock Text="Custom" FontSize="11" FontWeight="SemiBold" Classes="light"/>
                                                                </Border>
                                                                <Border Classes="badge" Background="{DynamicResource Fill3}" BorderBrush="{DynamicResource Control}" BorderThickness="1"
                                                                        IsVisible="{Binding HasFriends}">
                                                                    <TextBlock Text="{Binding FriendsLabel}" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding DetailText}" FontSize="12" Classes="muted"
                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <!-- Custom gyms are always the user's own -->
                                                            <Button Classes="link" FontSize="12" Foreground="{DynamicResource Muted}" Content="Edit"
                                                                    Command="{Binding EditCommand}" IsVisible="{Binding IsCustom}"/>
                                                            <Button Classes="link" FontSize="12" Foreground="{DynamicResource Muted}" Content="Delete"
                                                                    Command="{Binding DeleteCommand}" IsVisible="{Binding IsCustom}"/>
                                                            <Button Classes="btn small" Classes.light="{Binding !IsCurrent}" Classes.outline="{Binding IsCurrent}"
                                                                    MinWidth="76" Content="{Binding PickLabel}" Command="{Binding PickCommand}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border Padding="10" CornerRadius="8" Background="{DynamicResource RedTint}" IsVisible="{Binding IsConfirmingDelete}">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                            <TextBlock Text="Delete this gym? If you logged workouts there, it stays in your history."
                                                                       FontSize="12" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Classes="btn light small" Content="Delete" Command="{Binding ConfirmDeleteCommand}"/>
                                                            <Button Grid.Column="2" Classes="btn outline small" Content="Cancel" Command="{Binding CancelDeleteCommand}"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
