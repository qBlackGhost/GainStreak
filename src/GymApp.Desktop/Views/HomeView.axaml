<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             xmlns:v="using:GymApp.Desktop.Views"
             x:Class="GymApp.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <!-- The dashboard, after the "Gym App" design canvas (Dashboard artboard): black, one lime accent, the streak
         gauge turns from cold to fire once today is checked in. Always dark, whatever the system theme. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Accent" Color="#C6F432"/>
        <SolidColorBrush x:Key="Surface" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="Line" Color="#222222"/>
        <SolidColorBrush x:Key="Divider" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="Muted" Color="#9A9A9A"/>
        <SolidColorBrush x:Key="Soft" Color="#B5B5B5"/>
        <SolidColorBrush x:Key="Light" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="MissRed" Color="#FF6B5B"/>
        <SolidColorBrush x:Key="Flame" Color="#FF8A2A"/>
        <FontFamily x:Key="Mono">Cascadia Mono, Menlo, Consolas, DejaVu Sans Mono, monospace</FontFamily>

        <LinearGradientBrush x:Key="ColdBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#3E4C59"/>
            <GradientStop Offset="0.5" Color="#7D93A8"/>
            <GradientStop Offset="1" Color="#B9C8D6"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FireBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#C81D00"/>
            <GradientStop Offset="0.35" Color="#FF4A00"/>
            <GradientStop Offset="0.7" Color="#FF9A00"/>
            <GradientStop Offset="1" Color="#FFD400"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TodayDoneBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#FF4A00"/>
            <GradientStop Offset="1" Color="#FFB000"/>
        </LinearGradientBrush>

        <!-- Icons, on a 24×24 grid (see Icon.cs) -->
        <StreamGeometry x:Key="IcDumbbell">M6 7v10M18 7v10M3 10v4M21 10v4M6 12h12</StreamGeometry>
        <StreamGeometry x:Key="IcGrid">M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z</StreamGeometry>
        <StreamGeometry x:Key="IcCalendar">M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM3 9h18M8 2v4M16 2v4</StreamGeometry>
        <StreamGeometry x:Key="IcFlame">M12 22c4 0 7-3 7-7 0-5-4-7-5-12-2 3-3 5-3 7-1-1-2-2-2-4-2 2-4 5-4 9 0 4 3 7 7 7z</StreamGeometry>
        <StreamGeometry x:Key="IcMap">M9 4L3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14</StreamGeometry>
        <StreamGeometry x:Key="IcFriends">M5.5 8a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M14.5 9a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M16.5 14.2c2.9 0.3 5 2.4 5 5.8</StreamGeometry>
        <StreamGeometry x:Key="IcLogout">M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l5-5-5-5M15 12H3</StreamGeometry>
        <StreamGeometry x:Key="IcCheck">M5 12l5 5 9-10</StreamGeometry>
        <StreamGeometry x:Key="IcMadeUp">M4 12a8 8 0 1 0 3-6.2M4 4v4h4</StreamGeometry>
        <StreamGeometry x:Key="IcX">M6 6l12 12M18 6L6 18</StreamGeometry>
        <StreamGeometry x:Key="IcClock">M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M12 7v5l3 2</StreamGeometry>
        <StreamGeometry x:Key="IcTrophy">M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4</StreamGeometry>
        <StreamGeometry x:Key="IcPin">M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12zM9.5 10a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0</StreamGeometry>
        <StreamGeometry x:Key="IcPlus">M12 5v14M5 12h14</StreamGeometry>
        <StreamGeometry x:Key="IcArc">M 40 240 A 200 200 0 0 1 440 240</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Text -->
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.display">
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.6"/>
            <Setter Property="Foreground" Value="{StaticResource Soft}"/>
        </Style>
        <Style Selector="TextBlock.caps">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
        <Style Selector="TextBlock.soft"><Setter Property="Foreground" Value="{StaticResource Soft}"/></Style>
        <Style Selector="TextBlock.light"><Setter Property="Foreground" Value="{StaticResource Light}"/></Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#FF8A7A"/>
        </Style>

        <!-- Cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Buttons -->
        <Style Selector="Button.btn">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.small">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D8FF5E"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#AEDB1F"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.light">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.light:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E6E6E6"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.light:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CCCCCC"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.outline.strong">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Foreground" Value="#6E6E6E"/>
        </Style>
        <!-- "Logged ✓": done, so not clickable, but it shouldn't look broken -->
        <Style Selector="Button.btn.logged:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2FF8A"/>
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Sidebar -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Soft}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.nav.current">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.nav.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- Wide window: the sidebar on the left. Set here, not on the elements, so the narrow styles can override them -->
        <Style Selector="Border#Side">
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="Width" Value="232"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="20,28"/>
        </Style>
        <Style Selector="Border#Brand">
            <Setter Property="DockPanel.Dock" Value="Top"/>
            <Setter Property="Margin" Value="0,0,0,28"/>
        </Style>
        <Style Selector="Border#ProfileBox">
            <Setter Property="DockPanel.Dock" Value="Bottom"/>
            <Setter Property="Margin" Value="0,28,0,0"/>
        </Style>
        <Style Selector="ScrollViewer#NavScroll">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style Selector="StackPanel#Main">
            <Setter Property="Margin" Value="40,32,40,48"/>
        </Style>
        <Style Selector="Border#LevelPill">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="MinWidth" Value="320"/>
        </Style>
        <Style Selector="Panel#HeroRight">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>

        <!-- Narrow window: the sidebar becomes a bar along the top -->
        <Style Selector="Grid.narrow Border#Side">
            <Setter Property="DockPanel.Dock" Value="Top"/>
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style Selector="Grid.narrow Border#Brand">
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style Selector="Grid.narrow Border#ProfileBox">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
        </Style>
        <Style Selector="Grid.narrow StackPanel#NavItems">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Grid.narrow ScrollViewer#NavScroll">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="Grid.narrow StackPanel#ProfileText">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid.narrow StackPanel#Main">
            <Setter Property="Margin" Value="16,24,16,32"/>
        </Style>

        <!-- Compact content: header and streak hero stack -->
        <Style Selector="StackPanel.compact Border#LevelPill">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="StackPanel.compact Panel#HeroLeft">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="StackPanel.compact Panel#HeroRight">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>

        <!-- Level bar -->
        <Style Selector="ProgressBar.lvl">
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

        <!-- Gauge: once checked in, the fire arc fills and the cold dashes fade out -->
        <Style Selector="Path.fire">
            <Style.Animations>
                <Animation Duration="0:0:1.4" FillMode="Both" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="23"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Path.coldFade">
            <Style.Animations>
                <Animation Duration="0:0:1.4" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="40%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.gaugeTitle">
            <Setter Property="Foreground" Value="#B9C8D6"/>
        </Style>
        <Style Selector="TextBlock.gaugeTitle.rest">
            <Setter Property="Foreground" Value="#8A8A8A"/>
        </Style>
        <Style Selector="TextBlock.gaugeTitle.hot">
            <Setter Property="Foreground" Value="#FF7A00"/>
            <Setter Property="Effect">
                <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="24" Color="#80FF5000"/>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:1.4" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                    <KeyFrame Cue="55%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Week tiles -->
        <Style Selector="Border.tile">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.tile.rest">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style Selector="Border.tile.missed">
            <Setter Property="Background" Value="#1A0F0D"/>
            <Setter Property="BorderBrush" Value="#3A1E1A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.tile.upcoming">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style Selector="Border.tile.todayOpen">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#7D93A8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="TextElement.Foreground" Value="#B9C8D6"/>
        </Style>
        <Style Selector="Border.tile.todayDone">
            <Setter Property="Background" Value="{StaticResource TodayDoneBrush}"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>

        <!-- Missed-day options -->
        <Style Selector="Button.option">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.option.selected">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.option.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Light}"/>
        </Style>
        <Style Selector="Border.tag.skip">
            <Setter Property="BorderBrush" Value="#5A2A24"/>
            <Setter Property="TextElement.Foreground" Value="#FF8A7A"/>
        </Style>

        <!-- Friends tabs -->
        <Style Selector="Button.tab">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Soft}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.tab.on">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.tab.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Border.boardRow.you">
            <Setter Property="Background" Value="#161616"/>
        </Style>

        <!-- Inputs -->
        <Style Selector="TextBox.kcal">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Gym toast slides in -->
        <Style Selector="Border.toast.show">
            <Style.Animations>
                <Animation Duration="0:0:0.45" FillMode="Both" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <ThemeVariantScope RequestedThemeVariant="Dark">
    <Grid x:Name="Root" Background="Black" TextElement.Foreground="White">
    <DockPanel IsEnabled="{Binding !IsCheckingIn}">

        <!-- ===== Sidebar ===== -->
        <Border x:Name="Side" Background="Black" BorderBrush="{StaticResource Line}">
            <DockPanel>
                <Border x:Name="Brand" Padding="8,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Accent}">
                            <v:Icon Data="{StaticResource IcDumbbell}" Stroke="Black" StrokeThickness="2.4" Width="20" Height="20"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="IRONLOG" FontSize="20" FontWeight="ExtraBold" LetterSpacing="0.4" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Profile and log out -->
                <Border x:Name="ProfileBox" Padding="10" CornerRadius="12"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Classes="nav" Padding="0" Command="{Binding ShowProfileCommand}" ToolTip.Tip="Profile">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="18" Background="White">
                                    <TextBlock Text="{Binding Initials}" Foreground="Black" FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel x:Name="ProfileText" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="14" Foreground="White"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="100"/>
                                    <TextBlock Text="Profile" FontSize="12" Classes="muted"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="btn outline" Width="40" Height="40" MinHeight="40" Padding="0"
                                Foreground="{StaticResource Soft}" Command="{Binding LogoutCommand}"
                                ToolTip.Tip="Log out" AutomationProperties.Name="Log out">
                            <v:Icon Data="{StaticResource IcLogout}"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="NavScroll">
                    <StackPanel x:Name="NavItems" Spacing="4">
                        <Button Classes="nav current" Click="OnDashboardClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <v:Icon Data="{StaticResource IcGrid}"/><TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Command="{Binding ShowWorkoutsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <v:Icon Data="{StaticResource IcDumbbell}"/><TextBlock Text="Workouts" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Command="{Binding ShowSplitsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <v:Icon Data="{StaticResource IcCalendar}"/><TextBlock Text="Splits" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Click="OnCaloriesClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <v:Icon Data="{StaticResource IcFlame}"/><TextBlock Text="Calories" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Command="{Binding ShowGymSummaryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <v:Icon Data="{StaticResource IcMap}"/><TextBlock Text="Gyms" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Command="{Binding ShowFriendsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <v:Icon Data="{StaticResource IcFriends}"/><TextBlock Text="Friends" VerticalAlignment="Center"/>
                                <!-- Incoming requests -->
                                <Border Background="#FF6B5B" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                        VerticalAlignment="Center" IsVisible="{Binding HasIncomingRequests}"
                                        ToolTip.Tip="Friend requests waiting">
                                    <TextBlock Text="{Binding IncomingRequests}" Foreground="Black" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Main ===== -->
        <ScrollViewer x:Name="MainScroll">
        <StackPanel x:Name="Main" Spacing="24" MaxWidth="1200">

            <!-- Header: date, greeting, headline, and the level pill -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <StackPanel Spacing="6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding DateText}" FontSize="14" FontWeight="Medium" Classes="muted"/>
                    <TextBlock Text="{Binding Greeting}" FontSize="34" FontWeight="ExtraBold"/>
                    <TextBlock Text="{Binding StreakNote}" FontSize="15" Classes="soft"/>
                    <TextBlock Text="{Binding StreakEndedNotice}" FontSize="13" Classes="muted"
                               IsVisible="{Binding StreakEndedNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <Border x:Name="LevelPill" VerticalAlignment="Bottom"
                        Padding="12,12,16,12" CornerRadius="16" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Accent}" VerticalAlignment="Top">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="LVL" Foreground="Black" FontSize="10" FontWeight="Bold" LetterSpacing="0.8"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LevelNumber}" Foreground="Black" FontSize="22" FontWeight="Black"
                                           HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock FontSize="14" FontWeight="Bold">
                                    <Run Text="{Binding LevelTitle}"/><Run Text=" · "/><Run Text="{Binding PointsText}"/>
                                </TextBlock>
                                <Button Grid.Column="1" Classes="link" FontSize="12" Content="History"
                                        Command="{Binding ShowPointsHistoryCommand}"/>
                            </Grid>
                            <ProgressBar Classes="lvl" Minimum="0" Maximum="1" Value="{Binding LevelProgress}"/>
                            <TextBlock Text="{Binding LevelHint}" FontSize="12" Classes="muted"/>
                            <TextBlock Text="{Binding PointsNotice}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"
                                       IsVisible="{Binding PointsNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding PointsLostNotice}" FontSize="12" FontWeight="SemiBold" Classes="error"
                                       IsVisible="{Binding PointsLostNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Sets logged, no check-in yet -->
            <Border Padding="18,14" CornerRadius="14" BorderBrush="#333333" BorderThickness="1" Background="#111111"
                    IsVisible="{Binding ShowSetsHint}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <v:Icon Data="{StaticResource IcClock}" Stroke="White" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="You logged sets today but haven't checked in yet." FontSize="14"
                               Classes="light" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="btn outline strong small" Content="Check in now"
                            Command="{Binding LogTodayCommand}" IsEnabled="{Binding CanLog}"/>
                </Grid>
            </Border>

            <!-- ===== Streak hero ===== -->
            <Border Classes="card" Padding="24">
                <Grid x:Name="Hero" ColumnDefinitions="*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="32" RowSpacing="24">
                    <Panel x:Name="HeroLeft" VerticalAlignment="Center">
                        <StackPanel Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <v:Icon Data="{StaticResource IcFlame}" Stroke="{StaticResource Accent}" StrokeThickness="2.2"
                                        Width="22" Height="22"/>
                                <TextBlock Text="GYM STREAK" Classes="label" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="{Binding StreakCurrent}" FontSize="100" FontWeight="Black" LetterSpacing="-4" Margin="0,-11,0,-14"
                                           Foreground="{StaticResource Accent}" TextWrapping="NoWrap"
                                           Classes.zero="{Binding !StreakCurrent}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock.zero"><Setter Property="Foreground" Value="#3A3A3A"/></Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,10">
                                    <TextBlock Text="days" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="in a row" FontSize="16" FontWeight="Medium" Classes="muted"/>
                                </StackPanel>
                            </StackPanel>
                            <WrapPanel ItemSpacing="32" LineSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="BEST STREAK" Classes="caps"/>
                                    <TextBlock Text="{Binding BestStreakText}" Classes="mono" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="GYMS THIS MONTH" Classes="caps"/>
                                    <TextBlock Text="{Binding GymsThisMonth}" Classes="mono" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Panel>

                    <Panel x:Name="HeroRight">
                        <!-- Missed-day choice: the day after a missed training day, while a streak is at stake. Check-in waits for it. -->
                        <StackPanel Spacing="16" IsVisible="{Binding HasMissedDay}">
                            <StackPanel Spacing="16" DataContext="{Binding MissedDay}" x:DataType="vm:MissedDayViewModel">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="ExtraBold"/>
                                    <TextBlock Text="{Binding Subheading}" FontSize="14" Classes="soft"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MissedDayOptionViewModel">
                                            <Button Classes="option" Classes.selected="{Binding IsSelected}"
                                                    Command="{Binding ChooseCommand}">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Classes="pill tag" Classes.skip="{Binding IsSkip}">
                                                            <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="Bold"
                                                                       TextWrapping="NoWrap"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Preview}" FontSize="13" Classes="soft"/>
                                                    <ItemsControl ItemsSource="{Binding NewWeek}" IsVisible="{Binding HasNewWeek}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Background="#1E1E1E" CornerRadius="6" Margin="2" Padding="2,4">
                                                                    <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold"
                                                                               TextAlignment="Center"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Notes}" IsVisible="{Binding HasNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" FontSize="12" Classes="muted"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="10" IsVisible="{Binding IsConfirming}">
                                    <TextBlock Text="{Binding ConfirmText}" FontSize="14" Classes="light"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                        <Button Classes="btn outline" Content="Cancel" Command="{Binding CancelCommand}"/>
                                        <Button Classes="btn primary" Content="Confirm choice" Command="{Binding ConfirmCommand}"
                                                IsEnabled="{Binding !IsBusy}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding Error}" Classes="error"
                                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Today's gauge and check-in -->
                        <StackPanel Spacing="14" IsVisible="{Binding !HasMissedDay}" HorizontalAlignment="Center"
                                    MaxWidth="400">
                            <Viewbox Stretch="Uniform" MaxWidth="360" HorizontalAlignment="Center">
                                <Grid Width="480" Height="260">
                                    <Canvas Width="480" Height="260">
                                        <Path Data="{StaticResource IcArc}" Stroke="#1A1A1A" StrokeThickness="28" StrokeLineCap="Round"/>
                                        <!-- Rest day: a plain grey arc -->
                                        <Path Data="{StaticResource IcArc}" Stroke="#2E2E2E" StrokeThickness="28" StrokeLineCap="Round"
                                              IsVisible="{Binding IsRestOpen}"/>
                                        <!-- Training day, not done: a cold arc (it fades out under the fire) -->
                                        <Path Data="{StaticResource IcArc}" Stroke="{StaticResource ColdBrush}" StrokeThickness="28"
                                              StrokeLineCap="Round" Opacity="0.85"
                                              IsVisible="{Binding !IsRestOpen}" Classes.coldFade="{Binding IsDone}"/>
                                        <!-- Done: on fire -->
                                        <Path Data="{StaticResource IcArc}" Stroke="{StaticResource FireBrush}" StrokeThickness="28"
                                              StrokeLineCap="Round" StrokeDashArray="23,30"
                                              IsVisible="{Binding IsDone}" Classes.fire="{Binding IsDone}">
                                            <Path.Effect>
                                                <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="18" Color="#8CFF5A00"/>
                                            </Path.Effect>
                                        </Path>
                                    </Canvas>
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding GaugeKicker}" FontSize="15" FontWeight="SemiBold" LetterSpacing="2.4"
                                                   HorizontalAlignment="Center" Classes="muted" Classes.makeUp="{Binding IsMakeUpDay}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.makeUp"><Setter Property="Foreground" Value="White"/></Style>
                                            </TextBlock.Styles>
                                        </TextBlock>
                                        <Viewbox StretchDirection="DownOnly" MaxWidth="330" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding GaugeTitle}" Classes="gaugeTitle" FontSize="76" FontWeight="Black"
                                                       LetterSpacing="1.5" LineHeight="76" TextWrapping="NoWrap"
                                                       Classes.rest="{Binding IsRestOpen}" Classes.hot="{Binding IsDone}"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding GaugeSub}" FontSize="17" Classes="soft" HorizontalAlignment="Center"
                                                   TextAlignment="Center" MaxWidth="420"/>
                                    </StackPanel>
                                </Grid>
                            </Viewbox>

                            <Border Padding="18,14" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="14" Classes="light"/>
                                        <!-- Today's log only: works until midnight, then the log is read-only -->
                                        <StackPanel Orientation="Horizontal" Spacing="0"
                                                    IsVisible="{Binding TodayGymName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock FontSize="12" Classes="muted" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="220">
                                                <Run Text="at "/><Run Text="{Binding TodayGymName}"/><Run Text=" · "/>
                                            </TextBlock>
                                            <Button Classes="link" FontSize="12" Content="Change gym" Command="{Binding ChooseGymCommand}"/>
                                        </StackPanel>
                                        <Button Classes="link" FontSize="12" Content="Add gym" Command="{Binding ChooseGymCommand}"
                                                IsVisible="{Binding ShowAddGym}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="btn" Classes.primary="{Binding IsTrainingOpen}"
                                                Classes.outline="{Binding !IsTrainingOpen}" Classes.strong="{Binding IsRestOpen}"
                                                Classes.logged="{Binding IsDone}"
                                                Content="{Binding LogLabel}" Command="{Binding LogTodayCommand}"
                                                IsEnabled="{Binding CanLog}"/>
                                        <!-- Today only: undo the check-in (the sets stay) -->
                                        <Button Classes="btn outline" Padding="14,0" FontSize="13" Foreground="{StaticResource Soft}"
                                                Content="Undo" Command="{Binding StartUndoCommand}" IsVisible="{Binding CanUndo}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding GymNotice}" FontSize="12" Classes="muted"
                                       IsVisible="{Binding GymNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Panel>
                </Grid>
            </Border>

            <!-- ===== This week ===== -->
            <Border Classes="card" Padding="24,22">
                <StackPanel Spacing="14" DataContext="{Binding Week}" x:DataType="vm:WeekCardViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="This week" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <WrapPanel Grid.Column="1" ItemSpacing="14" LineSpacing="4" VerticalAlignment="Center">
                            <WrapPanel.Styles>
                                <Style Selector="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
                            </WrapPanel.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <v:Icon Data="{StaticResource IcCheck}" Stroke="{StaticResource Accent}" StrokeThickness="3" Width="13" Height="13"/>
                                <TextBlock Text="Done"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <v:Icon Data="{StaticResource IcMadeUp}" Stroke="White" StrokeThickness="2.6" Width="13" Height="13"/>
                                <TextBlock Text="Made up"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <v:Icon Data="{StaticResource IcX}" Stroke="{StaticResource MissRed}" StrokeThickness="3" Width="13" Height="13"/>
                                <TextBlock Text="Missed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="2" Background="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Text="Rest"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="3" BorderBrush="#6E6E6E" BorderThickness="1" VerticalAlignment="Center"/>
                                <TextBlock Text="Upcoming"/>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Chips}" Margin="-4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeekChipViewModel">
                                <Border Classes="tile" Classes.rest="{Binding IsRest}" Classes.missed="{Binding IsMissed}"
                                        Classes.upcoming="{Binding IsUpcoming}" Classes.todayOpen="{Binding IsTodayOpen}"
                                        Classes.todayDone="{Binding IsTodayDone}" ToolTip.Tip="{Binding Tip}">
                                    <StackPanel Spacing="6" VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="*,Auto" MinHeight="16">
                                            <TextBlock Text="{Binding Day}" FontSize="11" FontWeight="SemiBold" Opacity="0.75"
                                                       VerticalAlignment="Center"/>
                                            <Panel Grid.Column="1">
                                                <v:Icon Data="{StaticResource IcCheck}" Stroke="{StaticResource Accent}" StrokeThickness="3"
                                                        Width="14" Height="14" IsVisible="{Binding IsDone}"/>
                                                <v:Icon Data="{StaticResource IcMadeUp}" Stroke="White" StrokeThickness="2.6"
                                                        Width="14" Height="14" IsVisible="{Binding IsMadeUp}"/>
                                                <v:Icon Data="{StaticResource IcX}" Stroke="{StaticResource MissRed}" StrokeThickness="3"
                                                        Width="14" Height="14" IsVisible="{Binding IsMissed}"/>
                                            </Panel>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Cards: two columns, one when narrow (HomeView.axaml.cs sets ItemWidth) ===== -->
            <WrapPanel x:Name="Cards" ItemSpacing="24" LineSpacing="24">

                <!-- Today's workout: the same plan as the check-in -->
                <Border Classes="card">
                    <StackPanel Spacing="16" DataContext="{Binding TodayWorkout}" x:DataType="vm:TodayWorkoutCardViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Today's workout" Classes="h2"/>
                                <TextBlock Text="{Binding Title}" FontSize="13" Classes="muted"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="link" FontSize="14" Content="Open workouts" VerticalAlignment="Center"
                                    Command="{Binding BuildWorkoutCommand}" IsVisible="{Binding HasExercises}"/>
                        </Grid>
                        <StackPanel IsVisible="{Binding HasExercises}" Grid.IsSharedSizeScope="True">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Sets"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Last"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Exercise" FontSize="12" Classes="muted"/>
                                <TextBlock Grid.Column="1" Text="Sets" FontSize="12" Classes="muted" Margin="20,0"/>
                                <TextBlock Grid.Column="2" Text="Last top set" FontSize="12" Classes="muted" TextAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Exercises}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TodayExerciseViewModel">
                                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Sets"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Last"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Sets}" FontSize="14" Classes="mono soft"
                                                           Margin="20,0" ToolTip.Tip="Warm-up + working sets"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LastTime}" FontSize="14" Classes="mono soft"
                                                           TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border MinHeight="140" CornerRadius="14" BorderBrush="#333333" BorderThickness="1" Padding="20"
                                IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EmptyText}" FontSize="14" Classes="soft" TextAlignment="Center"/>
                                <Button Classes="btn outline small" Content="Build a workout" HorizontalAlignment="Center"
                                        Command="{Binding BuildWorkoutCommand}" IsVisible="{Binding ShowBuildLink}"/>
                                <Button Classes="btn primary small" Content="Pick a split" HorizontalAlignment="Center"
                                        Command="{Binding PickSplitCommand}" IsVisible="{Binding ShowPickSplit}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Calories today -->
                <Border x:Name="CaloriesCard" Classes="card">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Calories today" Classes="h2" VerticalAlignment="Center"/>
                            <Border Classes="pill" IsVisible="{Binding CalorieGoalType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding CalorieGoalType}" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="22">
                            <Grid Width="126" Height="126" ToolTip.Tip="{Binding CaloriesTitle}">
                                <Ellipse Stroke="#222222" StrokeThickness="12"/>
                                <Arc StartAngle="-90" SweepAngle="{Binding CaloriesSweep}" Stroke="White" StrokeThickness="12"
                                     Classes.hit="{Binding CaloriesHit}">
                                    <Arc.Styles>
                                        <Style Selector="Arc.hit"><Setter Property="Stroke" Value="{StaticResource Accent}"/></Style>
                                    </Arc.Styles>
                                </Arc>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding CaloriesCenter}" Classes="mono" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CaloriesCenterSub}" FontSize="11" Classes="soft" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CaloriesTitle}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CaloriesHint}" FontSize="13" Classes="soft" LineHeight="19"/>
                                <TextBlock Text="{Binding GoalReviewHint}" FontSize="12" Foreground="#E8C15A"
                                           IsVisible="{Binding GoalReviewHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8" IsVisible="{Binding ShowCaloriesForm}">
                            <TextBlock Text="Eaten today (kcal)" FontSize="12" Classes="muted"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBox Classes="kcal" PlaceholderText="e.g. 1900" Text="{Binding CaloriesInput}"/>
                                <Button Grid.Column="1" Classes="btn outline" Content="Cancel" Command="{Binding CancelEditCaloriesCommand}"
                                        IsVisible="{Binding IsEditingCalories}"/>
                                <Button Grid.Column="2" Classes="btn light" Content="{Binding LogCaloriesLabel}"
                                        Command="{Binding LogCaloriesCommand}" IsDefault="False"/>
                            </Grid>
                            <TextBlock Classes="fieldError" Text="{Binding CaloriesError}"
                                       IsVisible="{Binding CaloriesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding CaloriesTip}" FontSize="12" Classes="muted"
                                       IsVisible="{Binding CaloriesTip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <Border Padding="14,12" CornerRadius="12" Background="#111111" IsVisible="{Binding !ShowCaloriesForm}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{Binding CaloriesResult}" FontSize="14" Classes="light" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="btn outline small" Content="Edit" Command="{Binding EditCaloriesCommand}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Recent PRs (hidden when there are none) -->
                <Border Classes="card" IsVisible="{Binding RecentPrs.HasAny}">
                    <StackPanel Spacing="12" DataContext="{Binding RecentPrs}" x:DataType="vm:RecentPrsCardViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Recent PRs" Classes="h2"/>
                            <v:Icon Grid.Column="1" Data="{StaticResource IcTrophy}" Stroke="{StaticResource Accent}" Width="22" Height="22"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentPrViewModel">
                                    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" MinHeight="48">
                                        <Grid ColumnDefinitions="*,Auto,52" ColumnSpacing="16" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Exercise}" FontWeight="SemiBold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="14"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Date}" Classes="muted" FontSize="14"
                                                       TextAlignment="Right" TextWrapping="NoWrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Friends: this week's (or all-time) board -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Friends" Classes="h2" VerticalAlignment="Center"/>
                                <!-- Incoming requests -->
                                <Border Background="#FF6B5B" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                        VerticalAlignment="Center" IsVisible="{Binding HasIncomingRequests}"
                                        ToolTip.Tip="Friend requests waiting">
                                    <TextBlock Text="{Binding IncomingRequests}" Foreground="Black" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="1" Padding="3" CornerRadius="10" Background="#161616" IsVisible="{Binding HasFriends}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="tab" Classes.on="{Binding IsThisWeek}" Content="This week"
                                            Command="{Binding ShowBoardWeekCommand}"/>
                                    <Button Classes="tab" Classes.on="{Binding IsAllTime}" Content="All time"
                                            Command="{Binding ShowBoardAllTimeCommand}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Board}" IsVisible="{Binding HasFriends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BoardRowViewModel">
                                    <Border Classes="boardRow" Classes.you="{Binding IsYou}" MinHeight="52" Padding="10,0" CornerRadius="10">
                                        <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Rank}" Classes="mono muted" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                                                ToolTip.Tip="Current streak">
                                                        <v:Icon Data="{StaticResource IcFlame}" Stroke="{StaticResource Flame}"
                                                                StrokeThickness="2.4" Width="12" Height="12"/>
                                                        <TextBlock Text="{Binding Streak}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Flame}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Level}" FontSize="12" Classes="muted"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Points}" Classes="mono" FontWeight="Bold" FontSize="14"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding FriendsTitle}" FontSize="13" Classes="muted"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.ColumnSpan="2" Classes="btn outline small" HorizontalAlignment="Stretch"
                                    Command="{Binding ShowFriendsCommand}" Classes.half="{Binding HasFriends}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <v:Icon Data="{StaticResource IcPlus}" StrokeThickness="2.4" Width="14" Height="14"/>
                                    <TextBlock Text="Add friends" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.Styles>
                                    <Style Selector="Button.half"><Setter Property="Grid.ColumnSpan" Value="1"/></Style>
                                </Button.Styles>
                            </Button>
                            <Button Grid.Column="1" Classes="btn outline small" HorizontalAlignment="Stretch" Content="Full leaderboard"
                                    Command="{Binding ShowLeaderboardCommand}" IsVisible="{Binding HasFriends}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <!-- Check-in popup over Home -->
    <Border Background="#B3000000" IsVisible="{Binding IsCheckingIn}">
        <ContentControl Content="{Binding CheckIn}" Margin="16"/>
    </Border>

    <!-- Undo today's check-in -->
    <Border Background="#B3000000" IsVisible="{Binding IsConfirmingUndo}" Padding="24">
        <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="24" CornerRadius="18" Background="#111111" BorderBrush="#333333" BorderThickness="1">
            <StackPanel Spacing="14">
                <TextBlock Text="Undo today's check-in?" FontSize="22" FontWeight="ExtraBold"/>
                <TextBlock Text="{Binding UndoConfirmText}" FontSize="14" Classes="soft"/>
                <TextBlock Text="{Binding UndoLossText}" Classes="mono" FontSize="14" Foreground="#FF8A7A" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="btn outline" Content="Keep it" Command="{Binding CancelUndoCommand}"/>
                    <Button Classes="btn light" Content="Undo check-in" Command="{Binding ConfirmUndoCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- Optional gym prompt, right after check-in. The workout is already saved. -->
    <Border Classes="toast" Classes.show="{Binding ShowGymPrompt}" IsVisible="{Binding ShowGymPrompt}"
            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,24,16,0" Width="420"
            CornerRadius="16" Background="#161616" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True"
            BoxShadow="0 18 50 0 #B3000000">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource Accent}"/>
            <StackPanel Spacing="12" Margin="18,15,18,18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <v:Icon Data="{StaticResource IcPin}" Stroke="White" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Want to log your gym?" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="icon" Width="32" Height="32" Command="{Binding SkipGymPromptCommand}"
                            ToolTip.Tip="Close" AutomationProperties.Name="Close">
                        <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.4" Width="16" Height="16"/>
                    </Button>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding LastGymLabel}" FontSize="14" Classes="light" IsVisible="{Binding HasLastGym}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    <TextBlock Text="Pick where you trained today." FontSize="14" Classes="light" IsVisible="{Binding !HasLastGym}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="link" Content="Change" Command="{Binding ChooseGymCommand}"
                            IsVisible="{Binding HasLastGym}"/>
                </Grid>
                <CheckBox IsChecked="{Binding DontAskForGym}" FontSize="13" Foreground="{StaticResource Muted}">Don't ask me again</CheckBox>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="btn outline small" HorizontalAlignment="Stretch" MinHeight="42" Content="Not now"
                            Command="{Binding SkipGymPromptCommand}"/>
                    <Button Grid.Column="1" Classes="btn light small" HorizontalAlignment="Stretch" MinHeight="42"
                            Content="Log gym"
                            Command="{Binding LogGymCommand}"/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
    </Grid>
    </ThemeVariantScope>
</UserControl>
