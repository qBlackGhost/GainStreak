<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             x:Class="GymApp.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <ScrollViewer>
    <StackPanel Spacing="14" Width="360" Margin="0,24"
                HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding Welcome}" FontSize="24" HorizontalAlignment="Center"/>

        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="6">
                <TextBlock Text="Today" Opacity="0.7"/>
                <TextBlock Text="{Binding TodayTitle}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TodayHint}" Opacity="0.8" TextWrapping="Wrap"/>
                <Button Content="{Binding LogLabel}" Command="{Binding LogTodayCommand}"
                        IsEnabled="{Binding CanLog}" Margin="0,8,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                <!-- Optional gym prompt, right after check-in. The workout is already saved. -->
                <Border Background="#204682B4" BorderBrush="#804682B4" BorderThickness="1" CornerRadius="8"
                        Padding="12" Margin="0,8,0,0" IsVisible="{Binding ShowGymPrompt}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Want to log your gym?" FontWeight="SemiBold"/>
                        <Button Command="{Binding UseLastGymCommand}" IsVisible="{Binding HasLastGym}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <TextBlock Text="{Binding LastGymLabel}" TextTrimming="CharacterEllipsis"/>
                        </Button>
                        <Button Content="Choose another…" Command="{Binding ChooseGymCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Content="Skip" Command="{Binding SkipGymPromptCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Don't ask me again" Command="{Binding NeverAskForGymCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Today's log only: works until midnight, then the log is read-only -->
                <Button Classes="link" Content="{Binding GymLinkText}" Command="{Binding ChooseGymCommand}"
                        IsVisible="{Binding ShowGymLink}" HorizontalAlignment="Left" Padding="0"
                        Background="Transparent" BorderThickness="0" Foreground="SteelBlue" Cursor="Hand"/>
                <TextBlock Text="{Binding GymNotice}" Opacity="0.8" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding GymNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Level" Opacity="0.7" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="History" Command="{Binding ShowPointsHistoryCommand}"/>
                </Grid>
                <TextBlock Text="{Binding LevelTitle}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PointsText}" Opacity="0.8"/>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding LevelProgress}" Height="8"/>
                <TextBlock Text="{Binding LevelHint}" Opacity="0.8" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PointsNotice}" Foreground="SeaGreen" FontWeight="SemiBold" TextWrapping="Wrap"
                           IsVisible="{Binding PointsNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="6">
                <TextBlock Text="Streak" Opacity="0.7"/>
                <TextBlock Text="{Binding StreakText}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StreakNote}" Opacity="0.8" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="6">
                <TextBlock Text="Calories today" Opacity="0.7"/>
                <TextBlock Text="{Binding CaloriesTitle}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CaloriesHint}" Opacity="0.8" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding GoalReviewHint}" Foreground="DarkGoldenrod" TextWrapping="Wrap"
                           IsVisible="{Binding GoalReviewHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                    <TextBox Watermark="Eaten today (kcal)" Text="{Binding CaloriesInput}"/>
                    <Button Grid.Column="1" Content="{Binding LogCaloriesLabel}" Command="{Binding LogCaloriesCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        
        <Button Content="Workouts" Command="{Binding ShowWorkoutsCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <Button Content="Splits" Command="{Binding ShowSplitsCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <Button Content="Gyms visited" Command="{Binding ShowGymSummaryCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <Button Content="Profile" Command="{Binding ShowProfileCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <Button Content="Log out" Command="{Binding LogoutCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>
    </ScrollViewer>
</UserControl>
