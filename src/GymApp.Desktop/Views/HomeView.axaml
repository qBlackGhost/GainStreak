<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             x:Class="GymApp.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding Welcome}" FontSize="24"/>
        <Button Content="Log out" Command="{Binding LogoutCommand}"/>
    </StackPanel>
</UserControl>
