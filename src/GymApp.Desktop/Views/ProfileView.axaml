<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             x:Class="GymApp.Desktop.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#40808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="24" MaxWidth="720" HorizontalAlignment="Stretch">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding BackCommand}"/>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Username}" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SplitText}" Opacity="0.7" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StreakText}" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Info}" Foreground="SeaGreen" TextWrapping="Wrap"
                       IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- ===== Maintenance calories ===== -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="Maintenance calories" Opacity="0.7"/>
                    <TextBlock Text="{Binding MaintenanceText}" FontSize="26" FontWeight="SemiBold"
                               IsVisible="{Binding HasMaintenance}"/>
                    <TextBlock Text="{Binding MaintenanceNote}" Classes="small"/>
                </StackPanel>
            </Border>

            <!-- ===== Calorie goal ===== -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Calorie goal" FontSize="18" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                        <TextBlock Text="Goal" Classes="label"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding GoalOptions}"
                                  SelectedItem="{Binding SelectedGoal}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GoalOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding GoalText}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GoalRule}" Classes="small"
                                   IsVisible="{Binding GoalRule, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <!-- The suggestion moved since the user last answered it: ask before overwriting -->
                    <Border Background="#20DAA520" BorderBrush="#80DAA520" BorderThickness="1"
                            CornerRadius="8" Padding="12" IsVisible="{Binding SuggestionChanged}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding SuggestionChangedText}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding UseSuggestionLabel}" Command="{Binding UseSuggestionCommand}"/>
                                <Button Content="{Binding KeepGoalLabel}" Command="{Binding KeepGoalCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SuggestionText}"
                                   IsVisible="{Binding SuggestionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding SuggestionNote}" Classes="small"/>
                        <Button Content="{Binding UseSuggestionLabel}" Command="{Binding UseSuggestionCommand}"
                                IsVisible="{Binding CanUseSuggestion}" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Watermark="Your own goal (kcal)" Width="180" Text="{Binding CustomGoalInput}"/>
                        <Button Content="Set my own goal" Command="{Binding SetCustomGoalCommand}"/>
                    </StackPanel>
                    <TextBlock Classes="fieldError" Text="{Binding GoalError}"
                               IsVisible="{Binding GoalError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Classes="small"
                               Text="Safe limits: at least 1,500 kcal for men and 1,200 kcal for women, and never more than 25% under your maintenance."/>

                    <TextBlock Text="Recent days" Opacity="0.7" Margin="0,6,0,0"
                               IsVisible="{Binding HasCalorieHistory}"/>
                    <ItemsControl ItemsSource="{Binding CalorieHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalorieDayRow">
                                <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding DateText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ConsumedText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ResultText}" Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Body data ===== -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Body data" FontSize="18" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Text="Units" Classes="label"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <ComboBox ItemsSource="{Binding UnitSystems}"
                                      SelectedItem="{Binding SelectedUnits}" HorizontalAlignment="Stretch"/>
                            <TextBlock Classes="fieldError" Text="{Binding UnitsError}"
                                       IsVisible="{Binding UnitsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Sex" Classes="label"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <ComboBox ItemsSource="{Binding Sexes}"
                                      SelectedItem="{Binding SelectedSex}" PlaceholderText="Male or female"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Classes="fieldError" Text="{Binding SexError}"
                                       IsVisible="{Binding SexError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Birth date" Classes="label"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                            <DatePicker SelectedDate="{Binding BirthDate}"
                                        MinYear="{Binding MinBirthYear}" MaxYear="{Binding MaxBirthYear}"
                                        HorizontalAlignment="Stretch"/>
                            <TextBlock Classes="fieldError" Text="{Binding BirthDateError}"
                                       IsVisible="{Binding BirthDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Height" Classes="label"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                            <Panel>
                                <TextBox Watermark="Height (cm)" Text="{Binding HeightCmText}"
                                         IsVisible="{Binding IsMetric}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsImperial}">
                                    <TextBox Watermark="ft" Width="80" Text="{Binding HeightFtText}"/>
                                    <TextBox Watermark="in" Width="80" Text="{Binding HeightInText}"/>
                                </StackPanel>
                            </Panel>
                            <TextBlock Classes="fieldError" Text="{Binding HeightError}"
                                       IsVisible="{Binding HeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="Activity" Classes="label"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                        <ComboBox ItemsSource="{Binding ActivityOptions}"
                                  SelectedItem="{Binding SelectedActivity}" PlaceholderText="How much do you walk?"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActivityOption">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding Range}" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                            <TextBlock Classes="fieldError" Text="{Binding ActivityError}"
                                       IsVisible="{Binding ActivityError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="small"
                               Text="Your body data stays in the app's local database on this computer. Pick the activity level that matches your typical daily steps outside the gym."/>
                    <Button Content="Save profile" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ===== Gym: home city and check-in prompt ===== -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Gym" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Home city" Opacity="0.7"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearHomeCityCommand}"
                                IsVisible="{Binding HasHomeCity}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HomeCityText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </DockPanel>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Search" Margin="8,0,0,0"
                                Command="{Binding SearchCityCommand}"/>
                        <TextBox Watermark="Search for a city, e.g. Timișoara" Text="{Binding CitySearchText}"
                                 MaxLength="100">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCityCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Text="{Binding CitySearchMessage}" Classes="small"
                               IsVisible="{Binding CitySearchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Button Content="Retry" Command="{Binding SearchCityCommand}" IsVisible="{Binding CanRetryCitySearch}"
                            HorizontalAlignment="Left"/>

                    <ItemsControl ItemsSource="{Binding CityCandidates}" IsVisible="{Binding HasCityCandidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CityCandidateViewModel">
                                <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Opacity="0.7"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Choose" Command="{Binding ChooseCommand}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ToggleSwitch IsChecked="{Binding AskForGym}" OnContent="" OffContent=""
                                  Content="Ask which gym after check-in"/>
                    <Button Content="Gyms visited per month" Command="{Binding ShowGymSummaryCommand}"
                            HorizontalAlignment="Left"/>

                    <TextBlock Classes="small"
                               Text="The gym picker opens on this city. You can still pick gyms in other cities. City search uses OpenStreetMap (Nominatim)."/>
                </StackPanel>
            </Border>

            <!-- ===== Weight ===== -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Weight" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentWeightText}" FontSize="22" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Watermark="{Binding WeightWatermark}" Width="160" Text="{Binding WeightInput}"/>
                        <Button Content="Log today's weight" Command="{Binding LogWeightCommand}"/>
                    </StackPanel>
                    <TextBlock Classes="fieldError" Text="{Binding WeightError}"
                               IsVisible="{Binding WeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Classes="small" Text="One weigh-in per day. Logging again today replaces today's entry."/>

                    <TextBlock Text="Recent weigh-ins" Opacity="0.7" Margin="0,6,0,0"
                               IsVisible="{Binding HasHistory}"/>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeightEntryViewModel">
                                <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding DateText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding WeightText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteCommand}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding VersionText}" Classes="small" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
