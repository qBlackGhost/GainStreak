<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             x:Class="GymApp.Desktop.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#40808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="24" MaxWidth="720" HorizontalAlignment="Stretch">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding BackCommand}"/>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Username}" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SplitText}" Opacity="0.7" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StreakText}" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Info}" Foreground="SeaGreen" TextWrapping="Wrap"
                       IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- ===== Maintenance calories ===== -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="Maintenance calories" Opacity="0.7"/>
                    <TextBlock Text="{Binding MaintenanceText}" FontSize="26" FontWeight="SemiBold"
                               IsVisible="{Binding HasMaintenance}"/>
                    <TextBlock Text="{Binding MaintenanceNote}" Classes="small"/>
                </StackPanel>
            </Border>

            <!-- ===== Body data ===== -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Body data" FontSize="18" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Text="Units" Classes="label"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding UnitSystems}"
                                  SelectedItem="{Binding SelectedUnits}" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="1" Text="Sex" Classes="label"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Sexes}"
                                  SelectedItem="{Binding SelectedSex}" PlaceholderText="Male or female"
                                  HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="2" Text="Birth date" Classes="label"/>
                        <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding BirthDate}"
                                    MinYear="{Binding MinBirthYear}" MaxYear="{Binding MaxBirthYear}"
                                    HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="3" Text="Height" Classes="label"/>
                        <Panel Grid.Row="3" Grid.Column="1">
                            <TextBox Watermark="Height (cm)" Text="{Binding HeightCmText}"
                                     IsVisible="{Binding IsMetric}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsImperial}">
                                <TextBox Watermark="ft" Width="80" Text="{Binding HeightFtText}"/>
                                <TextBox Watermark="in" Width="80" Text="{Binding HeightInText}"/>
                            </StackPanel>
                        </Panel>

                        <TextBlock Grid.Row="4" Text="Daily steps" Classes="label"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Watermark="e.g. 8000" Text="{Binding StepsText}"/>
                    </Grid>

                    <TextBlock Classes="small"
                               Text="Your body data stays in the app's local database on this computer. Steps are your typical daily average."/>
                    <Button Content="Save profile" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ===== Weight ===== -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Weight" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentWeightText}" FontSize="22" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Watermark="{Binding WeightWatermark}" Width="160" Text="{Binding WeightInput}"/>
                        <Button Content="Log today's weight" Command="{Binding LogWeightCommand}"/>
                    </StackPanel>
                    <TextBlock Classes="small" Text="One weigh-in per day. Logging again today replaces today's entry."/>

                    <TextBlock Text="Recent weigh-ins" Opacity="0.7" Margin="0,6,0,0"
                               IsVisible="{Binding HasHistory}"/>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeightEntryViewModel">
                                <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding DateText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding WeightText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteCommand}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
