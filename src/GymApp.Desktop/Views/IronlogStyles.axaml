<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Class-based styles shared by the screens, in both themes; each screen includes this file -->
    <!-- Text -->
        <Style Selector="TextBlock.display">
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.6"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
        </Style>
        <Style Selector="TextBlock.caps">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
        <Style Selector="TextBlock.soft"><Setter Property="Foreground" Value="{DynamicResource Soft}"/></Style>
        <Style Selector="TextBlock.light"><Setter Property="Foreground" Value="{DynamicResource Light}"/></Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
        </Style>

        <!-- Cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Buttons -->
        <Style Selector="Button.btn">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.small">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D8FF5E"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#AEDB1F"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.light">
            <Setter Property="Background" Value="{DynamicResource Inverse}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>
        <Style Selector="Button.light:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InverseHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>
        <Style Selector="Button.light:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InversePressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.outline.strong">
            <Setter Property="BorderBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        </Style>
        <!-- "Logged ✓": done, so not clickable, but it shouldn't look broken -->
        <Style Selector="Button.btn.logged:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInkHover}"/>
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Sidebar -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.nav.current">
            <Setter Property="Background" Value="{DynamicResource Inverse}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.nav.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Inverse}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>

        <!-- Options inside a SegmentedPill (SegmentedPill.cs): transparent, the pill under them is the selection.
             The text fades between grey and black as the pill slides. -->
        <Style Selector="Button.seg">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.32"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.seg:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.seg.on">
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>
        <Style Selector="Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>

        <!-- Page content next to the sidebar; Sidebar.axaml.cs marks its DockPanel narrow when the window is -->
        <!-- A pickable row in a popup (copy from a day, share, add a shared workout) -->
        <Style Selector="Button.source">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.source:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.source.on">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.source.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
        </Style>

        <Style Selector="StackPanel.page">
            <Setter Property="Margin" Value="40,32,40,48"/>
            <Setter Property="MaxWidth" Value="1200"/>
        </Style>
        <Style Selector="DockPanel.narrow StackPanel.page">
            <Setter Property="Margin" Value="16,24,16,32"/>
        </Style>
</Styles>
