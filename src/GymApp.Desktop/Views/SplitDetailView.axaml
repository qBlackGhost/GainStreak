<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             xmlns:m="using:GymApp.Data.Models"
             x:Class="GymApp.Desktop.Views.SplitDetailView"
             x:DataType="vm:SplitDetailViewModel">
    <UserControl.Styles>
        <Style Selector="Border.cell">
            <Setter Property="BorderBrush" Value="#40808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="84"/>
        </Style>
        <Style Selector="Border.cell.training">
            <Setter Property="Background" Value="#334A90D9"/>
            <Setter Property="BorderBrush" Value="#804A90D9"/>
        </Style>
        <Style Selector="Border.cell.rest">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="24" MaxWidth="900" HorizontalAlignment="Center">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding BackCommand}"/>
                <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="★ Recommended" Foreground="Goldenrod" IsVisible="{Binding IsRecommended}"/>
                <TextBlock Text="✓ Active split" Foreground="SeaGreen" IsVisible="{Binding IsActive}"/>
            </StackPanel>

            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.8"
                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Rotation, StringFormat='Rotation: {0}'}" Opacity="0.8"/>

            <!-- Presets only: custom splits already define their own weekdays -->
            <StackPanel Spacing="12" IsVisible="{Binding IsPreset}">
                <StackPanel Spacing="4" IsVisible="{Binding HasVariants}">
                    <TextBlock Text="Training days per week" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" MinWidth="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="m:SplitVariant">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="First workout day" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding StartDays}" SelectedItem="{Binding StartDay}" MinWidth="220"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Your week" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleCell">
                        <Border Classes="cell"
                                Classes.training="{Binding IsTraining}"
                                Classes.rest="{Binding !IsTraining}">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="▶ Start" FontSize="11" Opacity="0.7"
                                           HorizontalAlignment="Center" IsVisible="{Binding IsStart}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding WeekSummary}" Opacity="0.7"/>

            <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding UseLabel}" Command="{Binding UseCommand}" IsDefault="True"/>
                <Button Content="Edit split" Command="{Binding EditCommand}" IsVisible="{Binding !IsPreset}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
