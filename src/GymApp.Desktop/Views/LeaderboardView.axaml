<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             x:Class="GymApp.Desktop.Views.LeaderboardView"
             x:DataType="vm:LeaderboardViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#40808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <!-- Your own row stands out -->
        <Style Selector="Border.you">
            <Setter Property="Background" Value="#204682B4"/>
            <Setter Property="BorderBrush" Value="#804682B4"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="24" MaxWidth="720" HorizontalAlignment="Stretch">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding BackCommand}"/>
                <Button DockPanel.Dock="Right" Content="Friends" Command="{Binding ShowFriendsCommand}"/>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Leaderboard" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding WeekText}" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                <RadioButton GroupName="period" Content="This week" IsChecked="{Binding IsThisWeek}"/>
                <RadioButton GroupName="period" Content="All time" IsChecked="{Binding IsAllTime}"/>
            </StackPanel>

            <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LeaderboardRowViewModel">
                                <Border Classes.you="{Binding IsYou}" BorderBrush="Transparent" BorderThickness="1"
                                        CornerRadius="8" Padding="10,8" Margin="0,2">
                                    <Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding RankText}" FontSize="18" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LevelText}" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding PointsText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StreakText}" MinWidth="56"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state: only you on the board -->
                    <StackPanel Spacing="6" Margin="0,8,0,0" HorizontalAlignment="Center" IsVisible="{Binding IsAlone}">
                        <TextBlock Text="Add friends to compete" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <Button Classes="link" Content="Find friends" Command="{Binding ShowFriendsCommand}"
                                HorizontalAlignment="Center" Padding="0" Background="Transparent" BorderThickness="0"
                                Foreground="SteelBlue" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
