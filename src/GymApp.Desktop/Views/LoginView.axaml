<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             x:Class="GymApp.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    <StackPanel Spacing="12" Width="320"
                HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Sign in" FontSize="24" FontWeight="SemiBold"/>
        <TextBox Watermark="Username" Text="{Binding Username}"/>
        <TextBox Watermark="Password" PasswordChar="●" Text="{Binding Password}"/>
        <CheckBox Content="Remember me" IsChecked="{Binding RememberMe}"/>
        <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <Button Content="Log in" Command="{Binding LoginCommand}"
                IsDefault="True" HorizontalAlignment="Stretch"/>
        <Button Content="Create an account" Command="{Binding GoToRegisterCommand}"
                HorizontalAlignment="Stretch"/>
    </StackPanel>
</UserControl>
