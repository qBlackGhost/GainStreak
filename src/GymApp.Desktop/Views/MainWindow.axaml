<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GymApp.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GymApp.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/gainstreak.ico"
        Title="GainStreak">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- The global error handler's banner: never the exception text, the details are in errors.log -->
        <Border DockPanel.Dock="Top" Background="#20CD5C5C" BorderBrush="#80CD5C5C" BorderThickness="0,0,0,1"
                Padding="12,8" IsVisible="{Binding HasGlobalError}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding GlobalError}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissGlobalErrorCommand}"/>
            </Grid>
        </Border>
        <ContentControl Content="{Binding Current}" />
    </DockPanel>

</Window>
