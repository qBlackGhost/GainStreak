<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             xmlns:v="using:GymApp.Desktop.Views"
             x:Class="GymApp.Desktop.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">
    <!-- After the "Gym App" design canvas (Friends artboard): the leaderboard and your friends on the left, adding
         friends and requests on the right. Below 880 px of content the right column goes under the left. -->
    <UserControl.Styles>
        <!-- The shared dark styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.avatar.you">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>
        <Style Selector="Border.boardRow">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.boardRow.you">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
        </Style>
        <Style Selector="TextBlock.rank"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
        <Style Selector="TextBlock.rank.first"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Style>
        <Style Selector="StackPanel.streak"><Setter Property="TextElement.Foreground" Value="#6E6E6E"/></Style>
        <Style Selector="StackPanel.streak.lit"><Setter Property="TextElement.Foreground" Value="{StaticResource Flame}"/></Style>
        <Style Selector="Border.listRow">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#1A0F0D"/>
            <Setter Property="BorderBrush" Value="#5A2A24"/>
            <Setter Property="Foreground" Value="#FF8A7A"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Two columns by default; FriendsView.axaml.cs stacks them when narrow -->
        <Style Selector="StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#LeftColumn">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
    </UserControl.Styles>

    <ThemeVariantScope RequestedThemeVariant="Dark">
    <DockPanel Background="Black" TextElement.Foreground="White">
        <v:Sidebar Current="Friends" FriendRequests="{Binding IncomingCount}"/>

        <ScrollViewer>
        <StackPanel Classes="page" Spacing="24">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Friends" FontSize="34" FontWeight="ExtraBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <v:Icon Data="{StaticResource IcLock}" Stroke="{StaticResource Soft}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Friends see your username, level, points and streak. Nothing else." FontSize="14" Classes="soft"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding FriendCountText}" Classes="mono muted" FontSize="13" VerticalAlignment="Bottom"/>
            </Grid>

            <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding StaleNotice}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding StaleNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Grid x:Name="Columns" ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="24">
                <StackPanel x:Name="LeftColumn" Spacing="24">

                    <!-- Leaderboard -->
                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Leaderboard" Classes="h2"/>
                                    <TextBlock Text="{Binding PeriodText}" FontSize="13" Classes="muted"/>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="3" CornerRadius="10" Background="#161616" VerticalAlignment="Center">
                                    <v:SegmentedPill SelectedIndex="{Binding IsAllTime, Converter={x:Static v:SegmentedPill.BoolToIndex}}"
                                                     PillCornerRadius="8" PillInset="0">
                                        <Button Classes="seg" Classes.on="{Binding IsThisWeek}" CornerRadius="8" Content="This week"
                                                Command="{Binding ShowThisWeekCommand}"/>
                                        <Button Classes="seg" Classes.on="{Binding IsAllTime}" CornerRadius="8" Content="All time"
                                                Command="{Binding ShowAllTimeCommand}"/>
                                    </v:SegmentedPill>
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Board}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FriendsBoardRowViewModel">
                                        <Border Classes="boardRow" Classes.you="{Binding IsYou}">
                                            <Grid ColumnDefinitions="40,Auto,*,Auto,76" ColumnSpacing="14" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RankText}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center"
                                                           Classes="rank" Classes.first="{Binding IsFirst}" TextWrapping="NoWrap"/>
                                                <Border Grid.Column="1" Classes="avatar" Classes.you="{Binding IsYou}">
                                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding LevelText}" FontSize="12" Classes="muted"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                            MinWidth="52" ToolTip.Tip="Current streak"
                                                            Classes="streak" Classes.lit="{Binding HasStreak}">
                                                    <v:Icon Data="{StaticResource IcFlame}" StrokeThickness="2.2" Width="15" Height="15"/>
                                                    <TextBlock Text="{Binding StreakText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding PointsText}" Classes="mono" FontSize="15" FontWeight="Bold"
                                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Panel IsVisible="{Binding HasNoFriends}">
                                <Rectangle Stroke="#333333" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="14" RadiusY="14"/>
                                <StackPanel Spacing="6" Margin="22" HorizontalAlignment="Center">
                                    <TextBlock Text="Add friends to compete" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Search for a username to send a request." FontSize="13" Classes="muted" TextAlignment="Center"/>
                                </StackPanel>
                            </Panel>
                            <TextBlock Text="Ranked by points. Ties share a rank. The streak is shown, not used for ranking."
                                       FontSize="12" Foreground="#6E6E6E"/>
                        </StackPanel>
                    </Border>

                    <!-- Your friends -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Your friends" Classes="h2"/>
                            <TextBlock Text="No friends yet." FontSize="14" Classes="muted" IsVisible="{Binding HasNoFriends}"/>
                            <ItemsControl ItemsSource="{Binding Friends}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FriendRowViewModel">
                                        <Border Classes="listRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <Border Classes="avatar">
                                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding SinceText}" FontSize="12" Classes="muted"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="link" FontSize="12" Foreground="{StaticResource Muted}"
                                                        Content="Cancel" Command="{Binding CancelRemoveCommand}"
                                                        IsVisible="{Binding IsConfirmingRemove}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Classes="btn outline small" Foreground="{StaticResource Soft}"
                                                        Classes.danger="{Binding IsConfirmingRemove}" Content="{Binding RemoveLabel}"
                                                        Command="{Binding RemoveCommand}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RightColumn" Spacing="24">

                    <!-- Add friend -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Add friend" Classes="h2"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBox x:Name="SearchBox" Classes="field" PlaceholderText="Username (at least 3 letters)"
                                         Text="{Binding Query}" AutomationProperties.Name="Username"/>
                                <Button Grid.Column="1" Classes="btn light" Content="Search" Command="{Binding SearchCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding SearchHint}" FontSize="12" Classes="error"
                                       IsVisible="{Binding SearchHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FoundUserViewModel">
                                        <Border Classes="listRow" MinHeight="52">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <Border Classes="avatar">
                                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Button Grid.Column="2" Classes="btn light small" Classes.primary="{Binding IsAccept}"
                                                        Content="{Binding ActionLabel}" Command="{Binding ActCommand}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SentCountText}" FontSize="12" Foreground="#6E6E6E"/>
                        </StackPanel>
                    </Border>

                    <!-- Requests -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Requests" Classes="h2" VerticalAlignment="Center"/>
                                <Border MinWidth="22" Height="22" Padding="6,0" CornerRadius="11" Background="{StaticResource Accent}"
                                        VerticalAlignment="Center" IsVisible="{Binding HasIncoming}">
                                    <TextBlock Text="{Binding IncomingCount}" Foreground="Black" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="No pending requests." FontSize="14" Classes="muted" IsVisible="{Binding HasNoRequests}"/>
                            <ItemsControl ItemsSource="{Binding Incoming}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RequestRowViewModel">
                                        <Border Classes="listRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <Border Classes="avatar">
                                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Classes="muted"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="btn outline small" Content="Decline" Command="{Binding DeclineCommand}"/>
                                                <Button Grid.Column="3" Classes="btn primary small" Content="Accept" Command="{Binding AcceptCommand}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Outgoing}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RequestRowViewModel">
                                        <Border Classes="listRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <Border Classes="avatar">
                                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Classes="muted"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="btn outline small" Foreground="{StaticResource Soft}"
                                                        Content="Cancel" Command="{Binding CancelCommand}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </ThemeVariantScope>
</UserControl>
