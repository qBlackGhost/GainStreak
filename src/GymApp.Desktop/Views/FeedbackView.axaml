<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             xmlns:v="using:GymApp.Desktop.Views"
             x:Class="GymApp.Desktop.Views.FeedbackView"
             x:DataType="vm:FeedbackViewModel">
    <!-- The feedback popup over any screen, after the "Gym App" design canvas (Feedback artboard): a centred 560 px
         card like the points history, over a dimmed page. Send goes to the server, which forwards it to the developer's
         Discord. Escape, the close button or a click outside closes it. -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="Border.track">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
        </Style>
        <Style Selector="TextBox.note">
            <Setter Property="MinHeight" Value="148"/>
            <Setter Property="MaxHeight" Value="260"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style Selector="Border.attach">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>
    <Panel TextElement.Foreground="{DynamicResource Ink}">
        <!-- The dimmed page; a click on it closes the popup -->
        <Border x:Name="Scrim" Background="{DynamicResource Scrim}"/>

        <Border Width="560" MaxHeight="720" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="24" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line2}" BorderThickness="1"
                BoxShadow="0 24 80 0 #99000000" ClipToBounds="True">
            <DockPanel>
                <!-- Header: title, close, the two kinds -->
                <Border DockPanel.Dock="Top" Padding="24,24,24,20" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource LimeTint}">
                                <v:Icon Data="{StaticResource IcChat}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.2"
                                        Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Feedback" FontSize="24" FontWeight="ExtraBold"/>
                                <TextBlock Text="{Binding SubtitleText}" FontSize="13" Classes="muted"/>
                            </StackPanel>
                            <Button x:Name="CloseButton" Grid.Column="2" Classes="btn outline" Width="44" Height="44" MinHeight="44"
                                    Padding="0" Foreground="{DynamicResource Light}" VerticalAlignment="Center"
                                    Command="{Binding CloseCommand}" ToolTip.Tip="Close"
                                    AutomationProperties.Name="Close feedback">
                                <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.4" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <Border Classes="track">
                            <v:SegmentedPill SelectedIndex="{Binding KindIndex}" PillInset="0">
                                <Button Classes="seg" Classes.on="{Binding IsProblem}" MinHeight="40" FontSize="14"
                                        Content="Report a problem" Command="{Binding ShowProblemCommand}"/>
                                <Button Classes="seg" Classes.on="{Binding IsIdea}" MinHeight="40" FontSize="14"
                                        Content="Suggest an idea" Command="{Binding ShowIdeaCommand}"/>
                            </v:SegmentedPill>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Footer: send, and where it goes -->
                <Border DockPanel.Dock="Bottom" Padding="24,16" Background="{DynamicResource SurfaceSunken}"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Sent to the developer with your username."/>
                        <Button Grid.Column="1" Classes="btn primary" Command="{Binding SendCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <v:Icon Data="{StaticResource IcSend}" Stroke="Black" StrokeThickness="2.2" Width="16" Height="16"/>
                                <Panel>
                                    <TextBlock Text="Send" VerticalAlignment="Center" IsVisible="{Binding !IsSending}"/>
                                    <TextBlock Text="Sending…" VerticalAlignment="Center" IsVisible="{Binding IsSending}"/>
                                </Panel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20,24,24" Spacing="12">
                        <TextBlock Text="{Binding Prompt}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox x:Name="ProblemBox" Classes="note" Text="{Binding ProblemText}" IsVisible="{Binding IsProblem}"
                                 PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="What happened?"/>
                        <TextBox x:Name="IdeaBox" Classes="note" Text="{Binding IdeaText}" IsVisible="{Binding IsIdea}"
                                 PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="Your idea"/>

                        <!-- A problem carries the error report -->
                        <Border Classes="attach" IsVisible="{Binding IsProblem}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <CheckBox IsChecked="{Binding AttachReport}" VerticalAlignment="Top"
                                          AutomationProperties.Name="Attach the error report"/>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Attach the error report" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="App version, system and errors.log. Nothing about your workouts."
                                               FontSize="12" Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <Button Classes="link" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                            Content="See what's sent" Command="{Binding ToggleReportPreviewCommand}"/>
                                    <Button Classes="link" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                            Content="Show log file" Command="{Binding ShowLogFileCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- The report exactly as it goes, user names already out of file paths -->
                        <Border Classes="attach" Padding="0" IsVisible="{Binding IsReportPreviewOpen}">
                            <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
                                <SelectableTextBlock Text="{Binding ReportPreview}" Margin="14,12" FontSize="11"
                                                     FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Light}"
                                                     TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12"
                                    IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Error}" Classes="error" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <!-- Sending failed: the note can still go by hand -->
                            <Button Classes="link" FontSize="13" FontWeight="SemiBold" Content="Copy instead" Click="CopyInstead"
                                    VerticalAlignment="Center" IsVisible="{Binding CanCopyInstead}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.6"
                                    Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{DynamicResource AccentInk}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
