<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.Desktop.ViewModels"
             x:Class="GymApp.Desktop.Views.PointsHistoryView"
             x:DataType="vm:PointsHistoryViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#40808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="24" MaxWidth="720" HorizontalAlignment="Stretch">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding BackCommand}"/>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Points history" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding LevelText}" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding TotalText}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="No points yet. Log a workout or hit your calorie target to earn some."
                               Opacity="0.7" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"/>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PointsRow">
                                <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding ReasonText}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DateText}" Opacity="0.7" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontWeight="SemiBold"
                                                   Foreground="SeaGreen" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
