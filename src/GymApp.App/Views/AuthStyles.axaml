<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:GymApp.App.Views">
    <!-- Sign in and Create account: the GainStreak card, labelled fields with an icon inside, an accent focus ring -->
    <StyleInclude Source="/Views/IronlogStyles.axaml"/>

    <Style Selector="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Light}"/>
    </Style>
    <Style Selector="TextBlock.fieldError">
        <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
    </Style>

    <Style Selector="TextBox.field">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="44,0,14,0"/>
        <Setter Property="Background" Value="{DynamicResource PageBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource PageBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlHover}"/>
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource PageBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
    </Style>
    <!-- The icon drawn inside the left of a field -->
    <Style Selector="v|Icon.fieldIcon">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="15,0,0,0"/>
        <Setter Property="Stroke" Value="{DynamicResource Muted}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style Selector="Button.btn.block">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="50"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- The column: a centred card on wide screens; on phones (the GainStreak Mobile canvas) the page itself -->
    <Style Selector="StackPanel.authColumn">
        <Setter Property="Width" Value="420"/>
        <Setter Property="Margin" Value="16,40"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector=".phone StackPanel.authColumn">
        <Setter Property="Width" Value="NaN"/>
        <Setter Property="Margin" Value="20,64,20,28"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Spacing" Value="22"/>
    </Style>
    <!-- Log in's bottom row ("New to GainStreak?"): smaller on phones, so the whole screen fits without scrolling -->
    <Style Selector=":is(Control).authFoot">
        <Setter Property="TextElement.FontSize" Value="14"/>
    </Style>
    <Style Selector=".phone :is(Control).authFoot">
        <Setter Property="TextElement.FontSize" Value="13"/>
    </Style>
    <Style Selector="Border.authFootRow">
        <Setter Property="Padding" Value="0,18,0,0"/>
    </Style>
    <Style Selector=".phone Border.authFootRow">
        <Setter Property="Padding" Value="0,12,0,0"/>
    </Style>
    <!-- Log in on phones: a little tighter, so the logo, the form and the note fit one screen -->
    <Style Selector="StackPanel.authColumn.login">
        <Setter Property="Spacing" Value="20"/>
    </Style>
    <Style Selector=".phone StackPanel.authColumn.login">
        <Setter Property="Margin" Value="20,52,20,16"/>
        <Setter Property="Spacing" Value="16"/>
    </Style>
    <Style Selector="Border.authCard">
        <Setter Property="Padding" Value="32"/>
    </Style>
    <Style Selector=".phone Border.authCard">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector=".phone TextBox.field">
        <Setter Property="MinHeight" Value="50"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
    </Style>
    <Style Selector=".phone Button.btn.block">
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Border.authSwitch">
        <Setter Property="Padding" Value="3"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource Fill}"/>
    </Style>
    <!-- The glow: lime fading out from behind the brand -->
    <Style Selector="Ellipse.authGlow">
        <Setter Property="Height" Value="520"/>
        <Setter Property="Margin" Value="-120,-260,-120,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Fill" Value="{DynamicResource AccentInk}"/>
        <Setter Property="Opacity" Value="0.13"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="OpacityMask">
            <RadialGradientBrush>
                <GradientStop Color="White" Offset="0"/>
                <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
        </Setter>
    </Style>
    <!-- Show password, beside the Password label -->
    <Style Selector="Button.showPassword">
        <!-- Never takes focus: the field keeps it, so a tap doesn't close the keyboard -->
        <Setter Property="Focusable" Value="False"/>
        <!-- On press, not release: the keyboard's bar can change during the tap and move the page, which cancels a click
             that waits for the release -->
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <!-- Keeps the 44 pt touch area without making the label's row taller than the others -->
        <Setter Property="Margin" Value="0,-14"/>
    </Style>

    <!-- A whole-form message (wrong password, could not connect) -->
    <Style Selector="Border.formError">
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RedTintLine}"/>
        <Setter Property="Background" Value="{DynamicResource RedTint}"/>
    </Style>
</Styles>
