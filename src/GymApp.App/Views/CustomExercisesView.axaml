<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             x:Class="GymApp.App.Views.CustomExercisesView"
             x:DataType="vm:CustomExercisesViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#40808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="24" MaxWidth="720" HorizontalAlignment="Stretch">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding BackCommand}"/>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="My exercises" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Counter}" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Info}" Foreground="SeaGreen" TextWrapping="Wrap"
                       IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- ===== Create / edit form ===== -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold"/>

                    <StackPanel Spacing="10" IsVisible="{Binding CanAdd}">
                        <StackPanel Spacing="4">
                            <TextBox PlaceholderText="Exercise name" MaxLength="{Binding MaxNameLength}"
                                     Text="{Binding Name}"/>
                            <TextBlock Classes="fieldError" Text="{Binding NameError}"
                                       IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                                      PlaceholderText="Muscle group" HorizontalAlignment="Stretch"/>
                            <TextBlock Classes="fieldError" Text="{Binding GroupError}"
                                       IsVisible="{Binding GroupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" IsDefault="True"/>
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                                    IsVisible="{Binding IsEditing}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="You've reached the limit. Delete one of your exercises to add another."
                               Opacity="0.7" TextWrapping="Wrap" IsVisible="{Binding !CanAdd}"/>
                </StackPanel>
            </Border>

            <!-- ===== The user's own exercises ===== -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Your exercises" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="You haven't added any exercises yet." Opacity="0.7"
                               IsVisible="{Binding IsEmpty}"/>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomExerciseItemViewModel">
                                <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Group}" Opacity="0.7" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <Button Content="Edit" Command="{Binding EditCommand}"/>
                                                <Button Content="Delete" Command="{Binding DeleteCommand}"
                                                        IsVisible="{Binding !IsConfirmingDelete}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Delete confirmation: says what goes with the exercise -->
                                        <StackPanel Spacing="6" IsVisible="{Binding IsConfirmingDelete}">
                                            <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap"
                                                       Foreground="IndianRed"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Yes, delete" Command="{Binding ConfirmDeleteCommand}"/>
                                                <Button Content="Keep it" Command="{Binding CancelDeleteCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
