<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <!-- After the "Gym App" design canvas (Profile artboard): body data and weight on the left, home city, account and
         appearance on the right. Below 880 px of content the right column goes under the left (ProfileView.axaml.cs). -->
    <UserControl.Styles>
        <!-- The streak: orange, or on ice (cold blue) on a rest day that didn't add to it (0.18.1) -->
        <Style Selector="StackPanel.streak > Path"><Setter Property="Fill" Value="{DynamicResource FlameText}"/></Style>
        <Style Selector="StackPanel.streak > TextBlock"><Setter Property="Foreground" Value="{DynamicResource FlameText}"/></Style>
        <Style Selector="StackPanel.streak.ice > TextBlock"><Setter Property="Foreground" Value="{DynamicResource IceText}"/></Style>
        <Style Selector="Border.pill.streak">
            <Setter Property="BorderBrush" Value="{DynamicResource OrangeTintLine}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource FlameText}"/>
        </Style>
        <Style Selector="Border.pill.streak Path"><Setter Property="Fill" Value="{DynamicResource FlameText}"/></Style>
        <Style Selector="Border.pill.streak.ice">
            <Setter Property="BorderBrush" Value="{DynamicResource IceTintLine}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource IceText}"/>
        </Style>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.formLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.track">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        </Style>
        <Style Selector="ComboBox.field">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.unitTag">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- The calories link sits right of the name, or under it when narrow -->
        <Style Selector="Button#CaloriesLink">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid.stack Button#CaloriesLink">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Two columns by default; stacked when narrow -->
        <Style Selector="StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#Columns"><Setter Property="RowSpacing" Value="24"/></Style>
        <!-- The phones show one page's cards at a time, so the stacked columns need no gap between them -->
        <Style Selector=".phone Grid#Columns"><Setter Property="RowSpacing" Value="0"/></Style>
        <Style Selector="Grid.stack StackPanel#LeftColumn">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <!-- Sizes the phones change (the GainStreak Mobile canvas), here so the ".phone" styles can override them -->
        <Style Selector="Border.roomy"><Setter Property="Padding" Value="28"/></Style>
        <Style Selector="Button.bare">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.bare:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.bare:pressed">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="v|AvatarView#Avatar">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="72"/>
        </Style>
        <Style Selector="Button.wideSeg"><Setter Property="MinWidth" Value="130"/></Style>
        <Style Selector=".phone Border.roomy"><Setter Property="Padding" Value="16"/></Style>
        <Style Selector=".phone v|AvatarView#Avatar">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
        </Style>
        <Style Selector=".phone Button.wideSeg"><Setter Property="MinWidth" Value="0"/></Style>
        <!-- The phones' compact body data (design C): small caps labels over tight switches -->
        <Style Selector="TextBlock.bdLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="0.9"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="Border.compactTrack">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style Selector="Border.compactTrack TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <!-- Units and Gender: compact switches, 320 wide at most -->
        <Style Selector="Border.fieldTrack">
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- The phones' header card -->
        <Style Selector="Border.statTile">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
        </Style>
        <Style Selector="Button.rowLink">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.rowLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <!-- The phones' pages (0.23.1): Main, Settings and the pages its rows open. A card's own title gives way to the
             page's back row there -->
        <Style Selector=".phone TextBlock.cardTitle"><Setter Property="IsVisible" Value="False"/></Style>
        <Style Selector="Border.deleteSection">
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,14,0,0"/>
        </Style>
        <Style Selector=".phone Border.deleteSection">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.settingsRow">
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.settingsRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
        </Style>
        <Style Selector="Border.rowDivider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="TextBlock.rowValue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="170"/>
        </Style>
        <Style Selector="TextBlock.rowValue.flame"><Setter Property="Foreground" Value="{DynamicResource FlameText}"/></Style>
        <Style Selector="TextBlock.rowLabel">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="0.9"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="4,0,0,-14"/>
        </Style>
    </UserControl.Styles>
    <DockPanel Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
        <v:Sidebar Current="Profile"/>

        <ScrollViewer x:Name="Scroller">
        <StackPanel Classes="page" Spacing="24">
          <StackPanel Classes="phoneOnly" Spacing="24">
            <!-- Phones, every page but Main: back to where it was opened from, and the page's title -->
            <Button Classes="rowLink" Command="{Binding PageBackCommand}" IsVisible="{Binding IsSubPage}" AutomationProperties.Name="Back">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <v:Icon Data="{StaticResource IcChevronLeft}" StrokeThickness="2.4" Width="22" Height="22" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="ExtraBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
            </Button>
            <!-- Phones (the canvas): a card with the avatar and name, streak / level / points tiles, then the split -->
            <Border Classes="card" IsVisible="{Binding IsMainPage}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Button Classes="bare" Command="{Binding EditAvatarCommand}" AutomationProperties.Name="Change avatar">
                            <v:AvatarView Width="64" Height="64" Choice="{Binding Avatar}" Initials="{Binding Initials}" Level="{Binding AvatarLevel}"
                                          Fallback="{DynamicResource Inverse}" FallbackInk="{DynamicResource OnInverse}"/>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="26" FontWeight="ExtraBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <!-- Settings: account, notifications, Health, home city, appearance -->
                        <Button Grid.Column="2" Classes="bare" Width="44" Height="44" VerticalAlignment="Top" Margin="0,-6,-8,0"
                                Command="{Binding OpenPageCommand}" CommandParameter="{x:Static vm:ProfilePage.Settings}"
                                AutomationProperties.Name="Settings">
                            <v:Icon Data="{StaticResource IcSliders}" Stroke="{DynamicResource Ink}" StrokeThickness="2.2" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Classes="statTile">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Streak" FontSize="12" Classes="muted"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" Classes="streak" Classes.ice="{Binding IsStreakStale}">
                                    <Path Data="{StaticResource IcFlame}" Width="15" Height="15" Stretch="Uniform"
                                          VerticalAlignment="Center" IsVisible="{Binding !IsStreakStale}"/>
                                    <Image Source="{StaticResource IcyFlame}" Width="20" Height="20" VerticalAlignment="Center"
                                           IsVisible="{Binding IsStreakStale}"/>
                                    <TextBlock Text="{Binding CurrentStreak}" FontSize="20" FontWeight="ExtraBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="statTile">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Level" FontSize="12" Classes="muted"/>
                                <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding LevelNumber}" FontSize="20" FontWeight="ExtraBold"/><Run Text=" "/><Run Text="{Binding LevelName}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="statTile">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Points" FontSize="12" Classes="muted"/>
                                <TextBlock Text="{Binding Points}" FontSize="20" FontWeight="ExtraBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Divider}"/>
                    <Button Classes="rowLink" Command="{Binding ShowSplitsCommand}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Split" FontSize="12" Classes="muted"/>
                                <TextBlock Text="{Binding SplitText}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <v:Icon Grid.Column="1" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
          </StackPanel>

            <!-- Header: who you are, your split, streak and level -->
            <Grid x:Name="Header" Classes="wideOnly" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
                <!-- A grid, so the chips wrap on a phone -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <Button Classes="bare" VerticalAlignment="Center" Command="{Binding EditAvatarCommand}"
                            ToolTip.Tip="Change avatar" AutomationProperties.Name="Change avatar">
                        <v:AvatarView x:Name="Avatar" Choice="{Binding Avatar}" Initials="{Binding Initials}" Level="{Binding AvatarLevel}"
                                      Fallback="{DynamicResource Inverse}" FallbackInk="{DynamicResource OnInverse}"/>
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="pageTitle" Text="{Binding Username}" FontWeight="ExtraBold"/>
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button Classes="link" Foreground="{DynamicResource Ink}" FontSize="13" Command="{Binding ShowSplitsCommand}">
                                <Border Background="{DynamicResource Fill2}" CornerRadius="999" Padding="12,5">
                                    <TextBlock Text="{Binding SplitText}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                            </Button>
                            <Border Classes="pill streak" Classes.ice="{Binding IsStreakStale}" Padding="12,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource IcFlame}" Width="13" Height="13" Stretch="Uniform"
                                          VerticalAlignment="Center" IsVisible="{Binding !IsStreakStale}"/>
                                    <Image Source="{StaticResource IcyFlame}" Width="17" Height="17" VerticalAlignment="Center"
                                           IsVisible="{Binding IsStreakStale}"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <Run Text="{Binding CurrentStreak}" FontFamily="{StaticResource Mono}"/><Run Text=" day streak · best "/><Run
                                             Text="{Binding BestStreak}" FontFamily="{StaticResource Mono}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Classes="pill" Padding="12,5">
                                <TextBlock Text="{Binding LevelText}" FontSize="13" FontWeight="SemiBold" Classes="light"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
                <Button x:Name="CaloriesLink" Classes="btn outline" Padding="16,0" VerticalAlignment="Center"
                        Command="{Binding ShowCaloriesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Calorie goal and maintenance" VerticalAlignment="Center"/>
                        <v:Icon Data="{StaticResource IcArrowRight}" StrokeThickness="2.2" Width="16" Height="16"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Saved / done -->
            <Border Padding="18,14" CornerRadius="14" BorderBrush="{DynamicResource LimeTintLine}" BorderThickness="1" Background="{DynamicResource LimeTint}"
                    IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Info}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Grid x:Name="Columns" ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="24"
                  IsVisible="{Binding ShowsCards}">
                <StackPanel x:Name="LeftColumn" Spacing="24">

                    <!-- ===== Body data ===== -->
                    <Border Classes="card roomy" IsVisible="{Binding ShowsBodyData}">
                        <StackPanel Spacing="22">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Body data" Classes="h2 cardTitle"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <v:Icon Data="{StaticResource IcLock}" Stroke="{DynamicResource Muted}" Width="14" Height="14"/>
                                    <TextBlock Classes="muted wideOnly" Text="Stored only on this computer" FontSize="12"/>
                                    <TextBlock Classes="muted phoneOnly" Text="Only on this phone" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Wide: a label beside each field (phones have the compact layout below) -->
                            <v:PhoneGrid Classes="wideOnly" ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="18"
                                         PhoneStack="True">
                                <!-- Units -->
                                <TextBlock Text="Units" Classes="formLabel"/>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Border Classes="track fieldTrack">
                                        <v:SegmentedPill SelectedIndex="{Binding UnitsIndex}" PillInset="0">
                                            <Button Classes="seg" Classes.on="{Binding IsMetric}" MinHeight="32" FontSize="13"
                                                    Content="Metric · kg, cm" Command="{Binding SelectMetricCommand}"/>
                                            <Button Classes="seg" Classes.on="{Binding IsImperial}" MinHeight="32" FontSize="13"
                                                    Content="Imperial · lb, ft" Command="{Binding SelectImperialCommand}"/>
                                        </v:SegmentedPill>
                                    </Border>
                                    <TextBlock Classes="fieldError" Text="{Binding UnitsError}"
                                               IsVisible="{Binding UnitsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Gender -->
                                <TextBlock Grid.Row="1" Text="Gender" Classes="formLabel"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <Border Classes="track fieldTrack">
                                        <v:SegmentedPill SelectedIndex="{Binding SexIndex}" PillInset="0">
                                            <Button Classes="seg" Classes.on="{Binding SexIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=0}"
                                                    MinHeight="32" FontSize="13" Classes.wideSeg="True" Content="Male" Command="{Binding SelectMaleCommand}"/>
                                            <Button Classes="seg" Classes.on="{Binding SexIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=1}"
                                                    MinHeight="32" FontSize="13" Classes.wideSeg="True" Content="Female" Command="{Binding SelectFemaleCommand}"/>
                                        </v:SegmentedPill>
                                    </Border>
                                    <TextBlock Classes="fieldError" Text="{Binding SexError}"
                                               IsVisible="{Binding SexError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Birth date: day, month, year -->
                                <TextBlock Grid.Row="2" Text="Birth date" Classes="formLabel"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" Width="72" TextAlignment="Center" PlaceholderText="Day"
                                                 Text="{Binding BirthDayText}" AutomationProperties.Name="Day"/>
                                        <ComboBox Classes="field" MinWidth="150" ItemsSource="{Binding Months}"
                                                  SelectedItem="{Binding BirthMonth}" PlaceholderText="Month"
                                                  AutomationProperties.Name="Month">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MonthOption">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" Width="96" TextAlignment="Center" PlaceholderText="Year"
                                                 Text="{Binding BirthYearText}" AutomationProperties.Name="Year"/>
                                        <Border Background="{DynamicResource Fill2}" CornerRadius="999" Padding="11,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AgeText}" FontSize="13" FontWeight="SemiBold" Classes="light"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Classes="fieldError" Text="{Binding BirthDateError}"
                                               IsVisible="{Binding BirthDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Height -->
                                <TextBlock Grid.Row="3" Text="Height" Classes="formLabel"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                                    <!-- Sized like the birth date boxes, the unit inside on the right -->
                                    <Panel HorizontalAlignment="Left" IsVisible="{Binding IsMetric}">
                                        <TextBox TextInputOptions.ContentType="Number" Classes="field mono" Width="128" Padding="14,0,40,0" Text="{Binding HeightCmText}"
                                                 AutomationProperties.Name="Height in centimetres"/>
                                        <Border Classes="unitTag"><TextBlock Text="cm" FontSize="13" Classes="muted"/></Border>
                                    </Panel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsImperial}">
                                        <Panel>
                                            <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" Width="96" Padding="14,0,32,0" Text="{Binding HeightFtText}"
                                                     AutomationProperties.Name="Feet"/>
                                            <Border Classes="unitTag"><TextBlock Text="ft" FontSize="13" Classes="muted"/></Border>
                                        </Panel>
                                        <Panel>
                                            <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" Width="96" Padding="14,0,32,0" Text="{Binding HeightInText}"
                                                     AutomationProperties.Name="Inches"/>
                                            <Border Classes="unitTag"><TextBlock Text="in" FontSize="13" Classes="muted"/></Border>
                                        </Panel>
                                    </StackPanel>
                                    <TextBlock Classes="fieldError" Text="{Binding HeightError}"
                                               IsVisible="{Binding HeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Activity -->
                                <TextBlock Grid.Row="4" Text="Activity" Classes="formLabel" VerticalAlignment="Top" Margin="0,18,0,0"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="8">
                                    <Border Classes="track">
                                        <ItemsControl ItemsSource="{Binding ActivityOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <v:SegmentedPill SelectedIndex="{Binding ActivityIndex}" PillInset="0"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ActivityOption">
                                                    <Button Classes="seg" Classes.on="{Binding IsSelected}" MinHeight="58" Padding="6,0"
                                                            Command="{Binding PickCommand}">
                                                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                                                            <TextBlock Text="{Binding Steps}" FontSize="12" Opacity="0.75"
                                                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <TextBlock Text="Pick the one that matches your usual daily steps outside the gym." FontSize="12"
                                               Classes="muted"/>
                                    <TextBlock Classes="fieldError" Text="{Binding ActivityError}"
                                               IsVisible="{Binding ActivityError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </v:PhoneGrid>

                            <!-- Phones (design C): Units and Gender side by side, the birth date on one row, height beside the
                                 age, then three short activity choices -->
                            <StackPanel Classes="phoneOnly" Spacing="14">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="UNITS" Classes="bdLabel"/>
                                        <Border Classes="track compactTrack">
                                            <v:SegmentedPill SelectedIndex="{Binding UnitsIndex}" PillInset="0">
                                                <Button Classes="seg" Classes.on="{Binding IsMetric}" MinHeight="30" FontSize="12" Padding="0"
                                                        Content="Metric" Command="{Binding SelectMetricCommand}"/>
                                                <Button Classes="seg" Classes.on="{Binding IsImperial}" MinHeight="30" FontSize="12" Padding="0"
                                                        Content="Imperial" Command="{Binding SelectImperialCommand}"/>
                                            </v:SegmentedPill>
                                        </Border>
                                        <TextBlock Classes="fieldError" Text="{Binding UnitsError}"
                                                   IsVisible="{Binding UnitsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="GENDER" Classes="bdLabel"/>
                                        <Border Classes="track compactTrack">
                                            <v:SegmentedPill SelectedIndex="{Binding SexIndex}" PillInset="0">
                                                <Button Classes="seg" Classes.on="{Binding SexIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=0}"
                                                        MinHeight="30" FontSize="12" Padding="0" Content="Male" Command="{Binding SelectMaleCommand}"/>
                                                <Button Classes="seg" Classes.on="{Binding SexIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=1}"
                                                        MinHeight="30" FontSize="12" Padding="0" Content="Female" Command="{Binding SelectFemaleCommand}"/>
                                            </v:SegmentedPill>
                                        </Border>
                                        <TextBlock Classes="fieldError" Text="{Binding SexError}"
                                                   IsVisible="{Binding SexError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="BIRTH DATE" Classes="bdLabel"/>
                                    <Grid ColumnDefinitions="64,*,76" ColumnSpacing="8">
                                        <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" TextAlignment="Center" PlaceholderText="Day"
                                                 Text="{Binding BirthDayText}" AutomationProperties.Name="Day"/>
                                        <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch" ItemsSource="{Binding Months}"
                                                  SelectedItem="{Binding BirthMonth}" PlaceholderText="Month" AutomationProperties.Name="Month">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MonthOption">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Column="2" TextInputOptions.ContentType="Digits" Classes="field mono" TextAlignment="Center"
                                                 PlaceholderText="Year" Text="{Binding BirthYearText}" AutomationProperties.Name="Year"/>
                                    </Grid>
                                    <TextBlock Classes="fieldError" Text="{Binding BirthDateError}"
                                               IsVisible="{Binding BirthDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="HEIGHT" Classes="bdLabel"/>
                                        <Panel IsVisible="{Binding IsMetric}">
                                            <TextBox TextInputOptions.ContentType="Number" Classes="field mono" Padding="12,0,38,0" Text="{Binding HeightCmText}"
                                                     AutomationProperties.Name="Height in centimetres"/>
                                            <Border Classes="unitTag"><TextBlock Text="cm" FontSize="13" Classes="muted"/></Border>
                                        </Panel>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding IsImperial}">
                                            <Panel>
                                                <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" MinWidth="0" Padding="10,0,26,0"
                                                         Text="{Binding HeightFtText}" AutomationProperties.Name="Feet"/>
                                                <Border Classes="unitTag" Margin="0,0,10,0"><TextBlock Text="ft" FontSize="12" Classes="muted"/></Border>
                                            </Panel>
                                            <Panel Grid.Column="1">
                                                <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" MinWidth="0" Padding="10,0,26,0"
                                                         Text="{Binding HeightInText}" AutomationProperties.Name="Inches"/>
                                                <Border Classes="unitTag" Margin="0,0,10,0"><TextBlock Text="in" FontSize="12" Classes="muted"/></Border>
                                            </Panel>
                                        </Grid>
                                    </StackPanel>
                                    <!-- The age, worked out from the birth date -->
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="AGE" Classes="bdLabel"/>
                                        <Border MinHeight="44" CornerRadius="10" Padding="12,0" Background="{DynamicResource Fill}">
                                            <TextBlock Text="{Binding AgeNumber}" Classes="mono soft" FontSize="15" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="fieldError" Text="{Binding HeightError}"
                                           IsVisible="{Binding HeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="ACTIVITY · STEPS A DAY" Classes="bdLabel"/>
                                    <Border Classes="track compactTrack">
                                        <ItemsControl ItemsSource="{Binding ActivityOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <v:SegmentedPill SelectedIndex="{Binding ActivityIndex}" PillInset="0"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ActivityOption">
                                                    <Button Classes="seg" Classes.on="{Binding IsSelected}" MinHeight="44" Padding="2,0"
                                                            Command="{Binding PickCommand}" AutomationProperties.Name="{Binding Name}">
                                                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding ShortName}" FontSize="12" FontWeight="Bold" TextWrapping="NoWrap"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ShortSteps}" FontSize="11" Opacity="0.75" TextWrapping="NoWrap"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <TextBlock Classes="fieldError" Text="{Binding ActivityError}"
                                               IsVisible="{Binding ActivityError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Maintenance and save -->
                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Maintenance (estimate)" FontSize="12" Classes="muted"/>
                                        <TextBlock>
                                            <Run Text="{Binding MaintenanceText}" FontFamily="{StaticResource Mono}" FontSize="20"
                                                 FontWeight="Bold"/><Run Text=" kcal / day" FontSize="15" Foreground="{DynamicResource Soft}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding MaintenanceNote}" FontSize="12" Foreground="{DynamicResource FlameText}"
                                                   IsVisible="{Binding MaintenanceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                    <!-- Not on phones, where Save sits right beside the estimate (design C) -->
                                    <Panel Grid.Column="1" Classes="wideOnly" VerticalAlignment="Center">
                                        <TextBlock Text="Unsaved changes" FontSize="13" Classes="soft" IsVisible="{Binding IsDirty}"/>
                                    </Panel>
                                    <Button Grid.Column="2" Classes="btn primary" Padding="22,0" Content="Save profile"
                                            Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- ===== Weight ===== -->
                    <Border Classes="card" IsVisible="{Binding ShowsWeight}">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Weight" Classes="h2"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock>
                                        <Run Text="{Binding CurrentWeightNumber}" FontSize="44" FontWeight="ExtraBold"/><Run Text=" "/><Run
                                             Text="{Binding WeightUnit, Mode=OneWay}" FontSize="18" FontWeight="Bold"
                                             Foreground="{DynamicResource Soft}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CurrentWeightDate}" FontSize="13" Classes="muted"/>
                                </StackPanel>
                                <Border Grid.Column="1" Classes="pill" Padding="12,5" VerticalAlignment="Bottom" IsVisible="{Binding HasHistory}">
                                    <TextBlock Text="{Binding DeltaText}" FontSize="13" FontWeight="SemiBold" Classes="soft"/>
                                </Border>
                            </Grid>
                            <!-- Trend: the last weigh-ins, oldest to newest -->
                            <StackPanel Spacing="6" IsVisible="{Binding HasTrend}">
                                <!-- Tap a dot for that day's weight, like the Health app -->
                                <v:WeightChart Points="{Binding TrendPoints}" Height="150"
                                               AutomationProperties.Name="Weight trend. Tap a point to see its weight."/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding TrendFirstLabel}" Classes="mono" FontSize="11" Foreground="{DynamicResource Faint}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TrendLastLabel}" Classes="mono" FontSize="11" Foreground="{DynamicResource Faint}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock FontSize="12" Classes="muted">
                                    <Run Text="Today's weight ("/><Run Text="{Binding WeightUnit}"/><Run Text=")"/>
                                </TextBlock>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBox TextInputOptions.ContentType="Number" x:Name="WeightBox" Classes="field mono" MinHeight="48" FontSize="16"
                                             PlaceholderText="{Binding WeightWatermark}" Text="{Binding WeightInput}"/>
                                    <Button Grid.Column="1" Classes="btn primary" MinHeight="48" Content="{Binding LogWeightLabel}"
                                            Command="{Binding LogWeightCommand}"/>
                                </Grid>
                                <TextBlock Classes="fieldError" Text="{Binding WeightError}"
                                           IsVisible="{Binding WeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="One weigh-in per day. Logging again today replaces today's entry." FontSize="12"
                                           Classes="muted"/>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasHistory}">
                                <TextBlock Text="RECENT WEIGH-INS" Classes="caps" FontWeight="Bold" LetterSpacing="1.4" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WeightEntryViewModel">
                                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" MinHeight="48">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DateText}" FontSize="14" Classes="light" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding WeightText}" Classes="mono" FontSize="14"
                                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Classes="btn outline small" Width="36" Height="36" MinHeight="36"
                                                            Padding="0" BorderBrush="{DynamicResource Line2}" Foreground="{DynamicResource Muted}"
                                                            Command="{Binding DeleteCommand}" ToolTip.Tip="Delete"
                                                            AutomationProperties.Name="{Binding DateText, StringFormat='Delete weigh-in from {0}'}">
                                                        <v:Icon Data="{StaticResource IcTrash}" Width="16" Height="16"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RightColumn" Spacing="24">
                    <!-- ===== Home city ===== -->
                    <Border Classes="card roomy" IsVisible="{Binding ShowsHomeCity}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Home city" Classes="h2 cardTitle"/>
                                <TextBlock Text="The gym map opens on this city. You can still pick gyms anywhere." FontSize="13" Classes="soft"/>
                            </StackPanel>
                            <Border Padding="16,14" CornerRadius="14" BorderBrush="{DynamicResource Control}" BorderThickness="1"
                                    IsVisible="{Binding HasHomeCity}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Accent}">
                                        <v:Icon Data="{StaticResource IcPin}" Stroke="Black" StrokeThickness="2.2" Width="20" Height="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HomeCityName}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding HomeCityRegion}" FontSize="13" Classes="muted"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="btn outline small" MinHeight="40" Content="Clear"
                                            Command="{Binding ClearHomeCityCommand}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Panel IsVisible="{Binding !HasHomeCity}">
                                <Rectangle Stroke="{DynamicResource ControlHover}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="14" RadiusY="14"/>
                                <TextBlock Text="No home city yet. Search for one below." FontSize="14" Classes="soft" Margin="16,14"/>
                            </Panel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Panel>
                                    <TextBox x:Name="CityBox" Classes="field" MinHeight="48" Padding="42,0,14,0"
                                             PlaceholderText="Search for a city, e.g. Cluj-Napoca" Text="{Binding CitySearchText}"
                                             AutomationProperties.Name="Search for a city"/>
                                    <v:Icon Data="{StaticResource IcSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="2.2"
                                            HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                                </Panel>
                                <Button Grid.Column="1" Classes="btn light" MinHeight="48" Padding="20,0" Content="Search"
                                        Command="{Binding SearchCityCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding CitySearchMessage}" FontSize="13" Classes="soft"
                                       IsVisible="{Binding CitySearchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <Button Classes="btn outline small" Content="Retry" HorizontalAlignment="Left"
                                    Command="{Binding SearchCityCommand}" IsVisible="{Binding CanRetryCitySearch}"/>
                            <Border CornerRadius="14" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True"
                                    IsVisible="{Binding HasCityCandidates}">
                                <ItemsControl ItemsSource="{Binding CityCandidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CityCandidateViewModel">
                                            <Button Classes="btn" MinHeight="52" Padding="16,8" CornerRadius="0" Background="{DynamicResource Surface2}"
                                                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" FontWeight="Normal"
                                                    Foreground="{DynamicResource Ink}" Command="{Binding ChooseCommand}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" Classes="muted"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="Set as home" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="City search uses OpenStreetMap (Nominatim)." FontSize="12" Foreground="{DynamicResource Faint}"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Account: the email you sign in with ===== -->
                    <Border Classes="card" IsVisible="{Binding ShowsAccountCard}">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="14" IsVisible="{Binding ShowsAccountDetails}">
                            <TextBlock Text="Account" Classes="h2 cardTitle"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" IsVisible="{Binding !IsEditingEmail}">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Fill2}">
                                    <v:Icon Data="{StaticResource IcMail}" Stroke="{DynamicResource Ink}" StrokeThickness="2" Width="20" Height="20"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Email" FontSize="12" Classes="muted"/>
                                    <TextBlock Text="{Binding EmailText}" FontSize="15" FontWeight="SemiBold"
                                               Classes.soft="{Binding !HasEmail}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="btn outline small" MinHeight="40" Content="{Binding EditEmailLabel}"
                                        Command="{Binding EditEmailCommand}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding EmailNeedsConfirming}">
                                <TextBlock Text="Not confirmed yet. If this address is wrong, you can't reset your password." FontSize="12"
                                           Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Classes="btn outline small" MinHeight="40" Content="Confirm"
                                        Command="{Binding ConfirmEmailCommand}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Spacing="10" IsVisible="{Binding IsEditingEmail}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="New email" FontSize="12" Classes="muted"/>
                                    <TextBox TextInputOptions.ContentType="Email" Classes="field" MaxLength="254" PlaceholderText="name@example.com"
                                             Text="{Binding NewEmail}" AutomationProperties.Name="New email"/>
                                    <TextBlock Classes="fieldError" Text="{Binding EmailError}"
                                               IsVisible="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Current password" FontSize="12" Classes="muted"/>
                                    <TextBox TextInputOptions.ContentType="Password" Classes="field" MaxLength="128" PasswordChar="●"
                                             Text="{Binding EmailPassword}" AutomationProperties.Name="Current password"/>
                                    <TextBlock Classes="fieldError" Text="{Binding EmailPasswordError}"
                                               IsVisible="{Binding EmailPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                    <Button Classes="btn outline small" MinHeight="40" Content="Cancel" Command="{Binding CancelEmailCommand}"/>
                                    <Button Classes="btn primary" MinHeight="40" Padding="18,0" Content="Save email"
                                            Command="{Binding SaveEmailCommand}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="You can sign in with your username or this email." FontSize="12" Classes="muted"/>

                            <!-- Password -->
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" IsVisible="{Binding !IsChangingPassword}">
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Fill2}">
                                            <v:Icon Data="{StaticResource IcLock}" Stroke="{DynamicResource Ink}" StrokeThickness="2" Width="20" Height="20"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Password" FontSize="12" Classes="muted"/>
                                            <TextBlock Text="●●●●●●●●" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="btn outline small" MinHeight="40" Content="Change"
                                                Command="{Binding ChangePasswordCommand}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Spacing="10" IsVisible="{Binding IsChangingPassword}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Current password" FontSize="12" Classes="muted"/>
                                            <TextBox TextInputOptions.ContentType="Password" Classes="field" MaxLength="128" PasswordChar="●"
                                                     Text="{Binding CurrentPassword}" AutomationProperties.Name="Current password"/>
                                            <TextBlock Classes="fieldError" Text="{Binding CurrentPasswordError}" TextWrapping="Wrap"
                                                       IsVisible="{Binding CurrentPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="New password" FontSize="12" Classes="muted"/>
                                            <TextBox TextInputOptions.ContentType="Password" Classes="field" MaxLength="128" PasswordChar="●"
                                                     Text="{Binding NewPassword}" AutomationProperties.Name="New password"/>
                                            <TextBlock Classes="fieldError" Text="{Binding NewPasswordError}" TextWrapping="Wrap"
                                                       IsVisible="{Binding NewPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Confirm new password" FontSize="12" Classes="muted"/>
                                            <TextBox TextInputOptions.ContentType="Password" Classes="field" MaxLength="128" PasswordChar="●"
                                                     Text="{Binding ConfirmNewPassword}" AutomationProperties.Name="Confirm new password"/>
                                            <TextBlock Classes="fieldError" Text="{Binding ConfirmNewPasswordError}" TextWrapping="Wrap"
                                                       IsVisible="{Binding ConfirmNewPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                            <Button Classes="btn outline small" MinHeight="40" Content="Cancel" Command="{Binding CancelPasswordCommand}"/>
                                            <Button Classes="btn primary" MinHeight="40" Padding="18,0" Content="Save password"
                                                    Command="{Binding SavePasswordCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                          </StackPanel>

                            <!-- Delete account, behind a confirmation that asks for the password (its own page on the phones) -->
                            <Border Classes="deleteSection" BorderBrush="{DynamicResource Line}"
                                    IsVisible="{Binding ShowsAccountDelete}">
                                <StackPanel Spacing="10">
                                    <Button Classes="btn outline small" MinHeight="40" Foreground="{DynamicResource ErrorText}" HorizontalAlignment="Left"
                                            IsVisible="{Binding !IsConfirmingDelete}" Command="{Binding AskDeleteCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <v:Icon Data="{StaticResource IcTrash}" Stroke="{DynamicResource ErrorText}" Width="16" Height="16"/>
                                            <TextBlock Text="Delete account" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Spacing="10" IsVisible="{Binding IsConfirmingDelete}">
                                        <TextBlock Text="Delete your account?" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DeleteWarning}" FontSize="13" Classes="soft" TextWrapping="Wrap"/>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Password" FontSize="12" Classes="muted"/>
                                            <TextBox TextInputOptions.ContentType="Password" Classes="field" MaxLength="128" PasswordChar="●"
                                                     Text="{Binding DeletePassword}" AutomationProperties.Name="Password to delete the account"/>
                                            <TextBlock Classes="fieldError" Text="{Binding DeleteError}" TextWrapping="Wrap"
                                                       IsVisible="{Binding DeleteError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                            <Button Classes="btn outline small" MinHeight="40" Content="Cancel" Command="{Binding CancelDeleteCommand}"/>
                                            <Button Classes="btn outline small" MinHeight="40" Padding="18,0" Foreground="{DynamicResource ErrorText}"
                                                    Content="Delete everything" Command="{Binding DeleteAccountCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== Vacation (0.19.0): freeze the streak for up to 7 days, once every 2 months ===== -->
                    <Border Classes="card" IsVisible="{Binding ShowsVacation}">
                        <StackPanel Spacing="14" DataContext="{Binding Vacation}" x:DataType="vm:VacationCardViewModel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Vacation" FontSize="20" FontWeight="Bold" Classes="cardTitle"/>
                                    <TextBlock Text="{x:Static vm:VacationCardViewModel.Blurb}" FontSize="12" Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <v:Icon Data="{StaticResource IcMoon}" Stroke="{DynamicResource IceText}" StrokeThickness="2.2"
                                            Width="14" Height="14" IsVisible="{Binding HasVacation}"/>
                                    <TextBlock Text="{Binding StateText}" FontSize="13" FontWeight="SemiBold" Classes="soft"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding RefusalText}" FontSize="13" Classes="soft" TextWrapping="Wrap"
                                       IsVisible="{Binding RefusalText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <Button Classes="btn outline small" MinHeight="40" HorizontalAlignment="Left" Content="Plan a vacation"
                                    Command="{Binding PlanCommand}">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="CanPlan"/>
                                        <Binding Path="!IsSheetOpen"/>
                                    </MultiBinding>
                                </Button.IsVisible>
                            </Button>
                            <Button Classes="btn outline small" MinHeight="40" HorizontalAlignment="Left" Content="{Binding EndLabel}"
                                    Command="{Binding AskEndCommand}">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="CanEnd"/>
                                        <Binding Path="!IsConfirmingEnd"/>
                                    </MultiBinding>
                                </Button.IsVisible>
                            </Button>
                            <ContentControl Content="{Binding Sheet}" IsVisible="{Binding IsSheetOpen}"/>
                            <Border IsVisible="{Binding IsConfirmingEnd}" Padding="14" CornerRadius="12"
                                    Background="{DynamicResource Fill3}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding EndTitle}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding EndText}" FontSize="13" Classes="soft" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Error}" FontSize="13" Classes="error" TextWrapping="Wrap"
                                               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                        <Button Classes="btn outline small" MinHeight="40" Content="Keep it" Command="{Binding KeepVacationCommand}"/>
                                        <Button Classes="btn primary small" MinHeight="40" Padding="18,0" Content="{Binding EndButton}"
                                                Command="{Binding EndCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== Notifications: Reminders (16g) and friend notifications (Phase 22, the canvas's Profile ·
                         Notifications); the phones only, each off until turned on, which asks to notify ===== -->
                    <Border Classes="card" IsVisible="{Binding ShowsNotifications}">
                      <StackPanel Spacing="14">
                        <TextBlock Text="Notifications" FontSize="20" FontWeight="Bold" Classes="cardTitle"/>
                        <StackPanel Spacing="14" DataContext="{Binding Reminders}" x:DataType="vm:RemindersViewModel" IsVisible="{Binding IsSupported}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Reminders" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="A nudge on training days, and the morning after a missed one." FontSize="12" Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" OnContent="" OffContent=""
                                              VerticalAlignment="Center" AutomationProperties.Name="Reminders"/>
                            </Grid>
                            <TextBlock Text="{Binding Note}" Classes="error" FontSize="13" TextWrapping="Wrap"
                                       IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <StackPanel Spacing="14" IsVisible="{Binding IsOn}">
                                <Border Height="1" Background="{DynamicResource Divider}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Training days" FontSize="14" Classes="light"/>
                                        <TextBlock Text="If you haven't checked in by then." FontSize="12" Classes="muted"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding TrainingOn}" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" AutomationProperties.Name="Training day reminder"/>
                                </Grid>
                                <v:TimeWheel Time="{Binding TrainingTime}" IsVisible="{Binding TrainingOn}"
                                             AutomationProperties.Name="Training day reminder time"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Missed days" FontSize="14" Classes="light"/>
                                        <TextBlock Text="At 9:00 the next morning, while your streak can still be saved." FontSize="12" Classes="muted"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding MissedOn}" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" AutomationProperties.Name="Missed day reminder"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="14" DataContext="{Binding FriendNotifications}" x:DataType="vm:FriendNotificationsViewModel" IsVisible="{Binding IsSupported}">
                            <Border Height="1" Background="{DynamicResource Divider}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Friend requests" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="When someone sends you a request, accepts yours, or adds you with your QR code." FontSize="12"
                                               Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" OnContent="" OffContent=""
                                              VerticalAlignment="Center" AutomationProperties.Name="Friend request notifications"/>
                            </Grid>
                            <TextBlock Text="{Binding Note}" Classes="error" FontSize="13" TextWrapping="Wrap"
                                       IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="Friend notifications go through Apple or Google and show the friend's username. This phone only."
                                       FontSize="11" Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- ===== Apple Health (Phase 20) on the iPhone, Health Connect (Phase 23) on Android: off until turned on, which
                         shows the system's permission sheet. The words come from the platform (HealthViewModel.Texts) ===== -->
                    <Border Classes="card" IsVisible="{Binding ShowsHealth}">
                        <StackPanel Spacing="14" DataContext="{Binding Health}" x:DataType="vm:HealthViewModel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Texts.Title}" FontSize="20" FontWeight="Bold" Classes="cardTitle"/>
                                    <TextBlock Text="{Binding Texts.Description}" FontSize="12"
                                               Classes="muted" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" OnContent="" OffContent=""
                                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Texts.Title}"/>
                            </Grid>
                            <StackPanel Spacing="8" IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Problem}" Classes="error" FontSize="13" TextWrapping="Wrap"/>
                                <Button Content="Open Settings" Classes="btn outline small" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding CanOpenSettings}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                            <!-- 20c: Health's values where they differ from typed ones, and a level from steps; each answered once -->
                            <StackPanel Spacing="8" IsVisible="{Binding OfferText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Border Height="1" Background="{DynamicResource Divider}"/>
                                <TextBlock Text="{Binding OfferText}" FontSize="14" Classes="light" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding UseStoreText}" Classes="btn primary small" Command="{Binding UseHealthProfileCommand}"/>
                                    <Button Content="Keep mine" Classes="btn outline small" Command="{Binding KeepMyProfileCommand}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding StepsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Border Height="1" Background="{DynamicResource Divider}"/>
                                <TextBlock Text="{Binding StepsText}" FontSize="14" Classes="light" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Use it" Classes="btn primary small" Command="{Binding UseStepsLevelCommand}"/>
                                    <Button Content="Not now" Classes="btn outline small" Command="{Binding NotNowStepsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding Note}" Classes="muted" FontSize="13" TextWrapping="Wrap"
                                       IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Appearance: the Theme setting, applied at once ===== -->
                    <Border Classes="card" IsVisible="{Binding ShowsAppearance}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Appearance" FontSize="20" FontWeight="Bold" Classes="cardTitle"/>
                            <Border Classes="track">
                                <v:SegmentedPill SelectedIndex="{Binding ThemeIndex}" PillInset="0">
                                    <Button Classes="seg" Classes.on="{Binding ThemeIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=0}"
                                            MinHeight="40" FontSize="14" Content="System" Command="{Binding SelectThemeCommand}" CommandParameter="0"/>
                                    <Button Classes="seg" Classes.on="{Binding ThemeIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=1}"
                                            MinHeight="40" FontSize="14" Content="Light" Command="{Binding SelectThemeCommand}" CommandParameter="1"/>
                                    <Button Classes="seg" Classes.on="{Binding ThemeIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=2}"
                                            MinHeight="40" FontSize="14" Content="Dark" Command="{Binding SelectThemeCommand}" CommandParameter="2"/>
                                </v:SegmentedPill>
                            </Border>
                            <TextBlock Classes="muted wideOnly" Text="System follows your Windows or macOS setting." FontSize="12"/>
                            <TextBlock Classes="muted phoneOnly" Text="System follows your phone's light or dark setting." FontSize="12"/>
                            <TextBlock Text="{Binding ThemeError}" Classes="error" FontSize="12"
                                       IsVisible="{Binding ThemeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Phones, Main (0.23.1): body data and vacation as rows that open their pages -->
            <Border Classes="card phoneOnly" Padding="0" ClipToBounds="True" IsVisible="{Binding IsMainPage}">
                <StackPanel>
                    <Button Classes="rowLink settingsRow" Padding="16,14" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static vm:ProfilePage.BodyData}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Body data" FontSize="12" Classes="muted"/>
                                <TextBlock Text="{Binding BodySummary}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding BodySummaryDetail}" FontSize="13" Classes="soft" TextWrapping="Wrap"/>
                            </StackPanel>
                            <v:Icon Grid.Column="1" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="rowDivider"/>
                    <Button Classes="rowLink settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static vm:ProfilePage.Vacation}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <v:Icon Data="{StaticResource IcPlane}" Stroke="{DynamicResource Soft}" StrokeThickness="2" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="rowLabel" Text="Vacation"/>
                            <TextBlock Grid.Column="2" Classes="rowValue" Text="{Binding Vacation.StateText}"/>
                            <v:Icon Grid.Column="3" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Phones, Settings (0.23.1): grouped rows showing their values, each opening its page. Feedback and log out
                 (the sidebar's on wider screens) close the list, account deletion last -->
            <StackPanel Classes="phoneOnly" Spacing="24" IsVisible="{Binding IsSettingsPage}">
                <TextBlock Classes="groupLabel" Text="ACCOUNT"/>
                <Border Classes="card" Padding="0" ClipToBounds="True">
                  <StackPanel>
                    <Button Classes="rowLink settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static vm:ProfilePage.Account}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <v:Icon Data="{StaticResource IcMail}" Stroke="{DynamicResource Soft}" StrokeThickness="2" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="rowLabel" Text="Email"/>
                            <TextBlock Grid.Column="2" Classes="rowValue" Text="{Binding EmailText}"/>
                            <v:Icon Grid.Column="3" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="rowDivider"/>
                    <Button Classes="rowLink settingsRow" Command="{Binding OpenPasswordCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <v:Icon Data="{StaticResource IcLock}" Stroke="{DynamicResource Soft}" StrokeThickness="2" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="rowLabel" Text="Password"/>
                            <v:Icon Grid.Column="3" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                  </StackPanel>
                </Border>
                <TextBlock Classes="groupLabel" Text="APP"/>
                <Border Classes="card" Padding="0" ClipToBounds="True">
                  <StackPanel>
                    <StackPanel IsVisible="{Binding HasNotifications}">
                    <Button Classes="rowLink settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static vm:ProfilePage.Notifications}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <v:Icon Data="{StaticResource IcBell}" Stroke="{DynamicResource Soft}" StrokeThickness="2" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="rowLabel" Text="Notifications"/>
                            <TextBlock Grid.Column="2" Classes="rowValue" Text="{Binding NotificationsSummary}"/>
                            <v:Icon Grid.Column="3" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="rowDivider"/>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding Health.IsSupported}">
                    <Button Classes="rowLink settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static vm:ProfilePage.Health}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <v:Icon Data="{StaticResource IcHeart}" Stroke="{DynamicResource Soft}" StrokeThickness="2" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="rowLabel" Text="{Binding Health.Texts.Title}"/>
                            <TextBlock Grid.Column="2" Classes="rowValue" Text="{Binding HealthSummary}" Classes.flame="{Binding HealthNeedsLook}"/>
                            <v:Icon Grid.Column="3" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="rowDivider"/>
                    </StackPanel>
                    <Button Classes="rowLink settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static vm:ProfilePage.HomeCity}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <v:Icon Data="{StaticResource IcPin}" Stroke="{DynamicResource Soft}" StrokeThickness="2" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="rowLabel" Text="Home city"/>
                            <TextBlock Grid.Column="2" Classes="rowValue" Text="{Binding HomeCitySummary}"/>
                            <v:Icon Grid.Column="3" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="rowDivider"/>
                    <Button Classes="rowLink settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static vm:ProfilePage.Appearance}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <v:Icon Data="{StaticResource IcMoon}" Stroke="{DynamicResource Soft}" StrokeThickness="2" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="rowLabel" Text="Appearance"/>
                            <TextBlock Grid.Column="2" Classes="rowValue" Text="{Binding ThemeSummary}"/>
                            <v:Icon Grid.Column="3" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                  </StackPanel>
                </Border>
                <Border Classes="card" Padding="0" ClipToBounds="True">
                  <StackPanel>
                    <Button Classes="rowLink settingsRow" Command="{Binding SendFeedbackCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <v:Icon Data="{StaticResource IcChat}" Stroke="{DynamicResource Soft}" StrokeThickness="2" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="rowLabel" Text="Send feedback"/>
                            <v:Icon Grid.Column="3" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="rowDivider"/>
                    <Button Classes="rowLink settingsRow" Command="{Binding LogOutCommand}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <v:Icon Data="{StaticResource IcLogout}" Stroke="{DynamicResource ErrorText}" StrokeThickness="2" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="rowLabel" Text="Log out" Foreground="{DynamicResource ErrorText}"/>
                        </Grid>
                    </Button>
                  </StackPanel>
                </Border>
                <Border Classes="card" Padding="0" ClipToBounds="True">
                    <Button Classes="rowLink settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static vm:ProfilePage.DeleteAccount}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <v:Icon Data="{StaticResource IcTrash}" Stroke="{DynamicResource ErrorText}" StrokeThickness="2" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="rowLabel" Text="Delete account" Foreground="{DynamicResource ErrorText}"/>
                        </Grid>
                    </Button>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding VersionText}" Classes="mono" FontSize="12" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"/>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
