<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GymApp.App.Views.MainView"
             x:DataType="vm:MainViewModel">
    <!-- The whole app below the window (or the phone's screen): banners, the current screen and the feedback popup.
         The desktop's MainWindow hosts it; the phones show it directly. Under 700 px wide it gets the "phone" class
         (MainView.axaml.cs): the screens hide their sidebar, the tab bar and the back bar show, popups become sheets.
         On phones the code behind also keeps it clear of the notch, the home indicator and the keyboard. -->

    <DockPanel>
        <!-- The global error handler's banner: never the exception text, the details are in errors.log -->
        <Border DockPanel.Dock="Top" Background="#20CD5C5C" BorderBrush="#80CD5C5C" BorderThickness="0,0,0,1"
                Padding="12,8" IsVisible="{Binding HasGlobalError}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding GlobalError}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissGlobalErrorCommand}"/>
            </Grid>
        </Border>
        <!-- The server no longer accepts this build (its own message, e.g. "This version of GainStreak is too old..."),
             or an update has downloaded and "Restart now" installs it -->
        <Border DockPanel.Dock="Top" Background="#20E0A030" BorderBrush="#80E0A030" BorderThickness="0,0,0,1"
                Padding="12,8" IsVisible="{Binding HasUpdateNotice}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding UpdateNotice}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Restart now" Command="{Binding RestartNowCommand}"
                        IsVisible="{Binding CanRestartForUpdate}"/>
                <Button Grid.Column="2" Content="Dismiss" Command="{Binding DismissUpdateNoticeCommand}"/>
            </Grid>
        </Border>
        <!-- Phones, on a screen opened from a tab: back and the screen's name -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PageBg}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="4,0,16,0" MinHeight="52" IsVisible="{Binding ShowsTopBar}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                <Button Width="48" Height="48" Padding="0" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding BackCommand}" AutomationProperties.Name="Back">
                    <v:Icon Data="{StaticResource IcChevronLeft}" Width="24" Height="24" StrokeThickness="2.4"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
        <!-- Phones: the tabs. Hidden while the keyboard is up -->
        <Panel x:Name="TabHost" DockPanel.Dock="Bottom">
            <v:TabBar x:Name="Tabs" IsVisible="{Binding ShowsTabBar}"/>
        </Panel>
        <Panel x:Name="Body">
            <ContentControl Content="{Binding Current}" />
            <!-- The feedback popup covers the screen below the banners -->
            <ContentControl Content="{Binding Feedback}" IsVisible="{Binding IsFeedbackOpen}"/>
        </Panel>
    </DockPanel>

</UserControl>
