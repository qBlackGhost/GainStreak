<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:GymApp.App.Views">
    <!-- Class-based styles shared by the screens, in both themes; each screen includes this file -->
    <!-- Text -->
        <Style Selector="TextBlock.display">
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.6"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
        </Style>
        <Style Selector="TextBlock.caps">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
        <Style Selector="TextBlock.soft"><Setter Property="Foreground" Value="{DynamicResource Soft}"/></Style>
        <Style Selector="TextBlock.light"><Setter Property="Foreground" Value="{DynamicResource Light}"/></Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
        </Style>

        <!-- Cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Buttons -->
        <Style Selector="Button.btn">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.small">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D8FF5E"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#AEDB1F"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.light">
            <Setter Property="Background" Value="{DynamicResource Inverse}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>
        <Style Selector="Button.light:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InverseHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>
        <Style Selector="Button.light:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InversePressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.outline.strong">
            <Setter Property="BorderBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        </Style>
        <!-- "Logged ✓": done, so not clickable, but it shouldn't look broken -->
        <Style Selector="Button.btn.logged:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <!-- Show password, beside a password box's label: Log in, Create account, Forgot password, Profile's account forms and the Change username sheet -->
        <Style Selector="Button.showPassword">
            <!-- Never takes focus: the field keeps it, so a tap doesn't close the keyboard -->
            <Setter Property="Focusable" Value="False"/>
            <!-- On press, not release: the keyboard's bar can change during the tap and move the page, which cancels a click
                 that waits for the release -->
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <!-- Keeps the 44 pt touch area without making the label's row taller than the others -->
            <Setter Property="Margin" Value="0,-14"/>
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInkHover}"/>
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Switches (0.23.1): a springy pill. The knob stretches while pressed, overshoots as it lands, and a check
             pops in when on. Every ToggleSwitch on a screen that includes these styles (Profile's settings pages, the
             Map's settings chips) -->
        <Style Selector="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Track" Width="44" Height="26" CornerRadius="13" Background="{DynamicResource Control}" ClipToBounds="True">
                        <Border.Transitions>
                            <Transitions><BrushTransition Property="Background" Duration="0:0:0.25"/></Transitions>
                        </Border.Transitions>
                        <Panel>
                        <!-- ToggleSwitch requires this part and moves it (and resets its transitions) for dragging; an
                             empty one, so a tap toggles and the knob below animates on its own -->
                        <Panel Name="PART_MovingKnobs" Width="0" Height="0"/>
                        <Border Name="Knob" Width="20" Height="20" CornerRadius="10" Margin="3,0,0,0" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Background="White" BoxShadow="0 1 3 0 #40000000" RenderTransform="translateX(0px)">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="BackEaseOut"/>
                                    <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Border.Transitions>
                            <Path Name="Check" Data="M5,12 L10,17 L20,7" Stroke="#4D7C0F" StrokeThickness="3" StrokeLineCap="Round"
                                  StrokeJoin="Round" Width="9" Height="9" Stretch="Uniform" Opacity="0" RenderTransform="scale(0.4)"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Delay="0:0:0.1"/>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Delay="0:0:0.1" Easing="BackEaseOut"/>
                                    </Transitions>
                                </Path.Transitions>
                            </Path>
                        </Border>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Border#Track"><Setter Property="Background" Value="{DynamicResource Accent}"/></Style>
        <!-- 44 x 26 with a 20 knob 3 in from each end: it travels 18. Pressed it stretches to 25, growing toward the middle.
             The overshoot (BackEaseOut, about a tenth) stays inside the track, which clips anyway -->
        <Style Selector="ToggleSwitch:checked /template/ Border#Knob"><Setter Property="RenderTransform" Value="translateX(18px)"/></Style>
        <Style Selector="ToggleSwitch:pressed /template/ Border#Knob"><Setter Property="Width" Value="25"/></Style>
        <Style Selector="ToggleSwitch:checked:pressed /template/ Border#Knob"><Setter Property="RenderTransform" Value="translateX(13px)"/></Style>
        <Style Selector="ToggleSwitch:checked /template/ Path#Check">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="ToggleSwitch:disabled"><Setter Property="Opacity" Value="0.4"/></Style>

        <!-- Phones (MainView sets "phone" under 700 px): "phoneOnly" shows only there, "wideOnly" everywhere else -->
        <Style Selector=":is(Control).phoneOnly">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=".phone :is(Control).phoneOnly">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector=".phone :is(Control).wideOnly">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- A text link next to text: the 44 pt touch minimum (PhoneTouch) mustn't push its words off the line -->
        <Style Selector=".phone Button.link">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- The phones' Leaderboard / Map switch at the top of the Friends tab -->
        <Style Selector="Border.friendsSwitch">
            <Setter Property="Margin" Value="16,14,16,0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
        </Style>

        <!-- Phones: the scroll indicator sits in the page's 16 px side margin, not over the cards' right edge -->
        <Style Selector=".phone ScrollBar:vertical">
            <Setter Property="RenderTransform" Value="translateX(12px)"/>
        </Style>
        <!-- Phones (0.27.1): pages scroll without a bar; only lists (ScrollViewer.showBar) keep theirs -->
        <Style Selector=".phone ScrollBar:vertical">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector=".phone ScrollViewer.showBar /template/ ScrollBar:vertical">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <!-- Phones: a touch has no hover, so a pressed button dims at once (and keeps the theme's slight shrink) -->
        <Style Selector=".phone Button">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.075"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector=".phone Button:pressed">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Phones: grids with other columns (PhoneGrid.cs) -->
        <Style Selector=".phone v|PhoneGrid">
            <Setter Property="IsPhone" Value="True"/>
        </Style>


        <!-- Phones: popups become sheets from the bottom (Sheet.cs) -->
        <Style Selector=".phone v|Sheet">
            <Setter Property="IsBottomSheet" Value="True"/>
        </Style>
        <!-- A small card that stays centred on phones too (the past-day popup, Phase 27d) -->
        <Style Selector=".phone v|Sheet.centred">
            <Setter Property="IsBottomSheet" Value="False"/>
        </Style>

        <!-- Sidebar -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.nav.current">
            <Setter Property="Background" Value="{DynamicResource Inverse}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.nav.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Inverse}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>

        <!-- Options inside a SegmentedPill (SegmentedPill.cs): transparent, the pill under them is the selection.
             The text fades between grey and black as the pill slides. -->
        <Style Selector="Button.seg">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.32"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.seg:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.seg.on">
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>
        <Style Selector="Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
        </Style>

        <!-- Page content next to the sidebar; Sidebar.axaml.cs marks its DockPanel narrow when the window is -->
        <!-- A pickable row in a popup (copy from a day, share, add a shared workout) -->
        <Style Selector="Button.source">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.source:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.source.on">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.source.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
        </Style>

        <Style Selector="StackPanel.page">
            <Setter Property="Margin" Value="40,32,40,48"/>
            <Setter Property="MaxWidth" Value="1200"/>
        </Style>
        <!-- A page's header: the title, and its buttons on the right; on phones the buttons go under the title, and the
             title is smaller (the canvas sets it at 28) -->
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="34"/>
        </Style>
        <Style Selector="Grid.pageHeader > :is(Control).headerActions">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector=".phone TextBlock.pageTitle">
            <Setter Property="FontSize" Value="28"/>
        </Style>
        <Style Selector=".phone Grid.pageHeader">
            <Setter Property="RowSpacing" Value="12"/>
        </Style>
        <Style Selector=".phone Grid.pageHeader > :is(Control).headerActions">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="DockPanel.narrow StackPanel.page">
            <Setter Property="Margin" Value="16,24,16,32"/>
        </Style>
        <!-- Phones (the GainStreak Mobile canvas): 16 px sides under the app bar, tighter cards -->
        <Style Selector=".phone StackPanel.page">
            <Setter Property="Margin" Value="16,14,16,32"/>
        </Style>
        <Style Selector=".phone TextBlock.h2">
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style Selector=".phone Border.card">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
</Styles>
