<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">
    <!-- Same card as Sign in (LoginView.axaml) -->
    <UserControl.Styles>
        <StyleInclude Source="/Views/AuthStyles.axaml"/>
    </UserControl.Styles>
    <Panel Background="{DynamicResource PageBg}">
    <!-- Phones: a soft lime glow behind the brand (the GainStreak Mobile canvas) -->
    <Ellipse Classes="authGlow phoneOnly"/>
    <ScrollViewer TextElement.Foreground="{DynamicResource Ink}">
        <StackPanel Classes="authColumn" Spacing="20">
            <!-- Phones: the brand large and centred, then Log in / Create account -->
            <StackPanel Classes="phoneOnly" Spacing="12" HorizontalAlignment="Center">
                <Image Source="{StaticResource GainStreakLogo}" Width="72" Height="72" HorizontalAlignment="Center"/>
                <TextBlock FontSize="26" FontWeight="ExtraBold" LetterSpacing="1" HorizontalAlignment="Center"><Run Text="GAIN"/><Run Text="STREAK" Foreground="{DynamicResource AccentInk}"/></TextBlock>
            </StackPanel>
            <Border Classes="authSwitch phoneOnly">
                <v:SegmentedPill SlideGroup="auth" SelectedIndex="1" PillInset="0">
                    <Button Classes="seg" MinHeight="40" FontSize="14" Content="Log in" Command="{Binding GoToLoginCommand}"/>
                    <Button Classes="seg on" MinHeight="40" FontSize="14" Content="Create account"/>
                </v:SegmentedPill>
            </Border>
            <!-- Brand -->
            <StackPanel Classes="wideOnly" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Image Source="{StaticResource GainStreakLogo}" Width="40" Height="40"/>
                <TextBlock FontSize="22" FontWeight="ExtraBold" LetterSpacing="0.4" VerticalAlignment="Center"><Run Text="GAIN"/><Run Text="STREAK" Foreground="{DynamicResource AccentInk}"/></TextBlock>
            </StackPanel>

            <Border Classes="card authCard">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Create your account" FontSize="30" FontWeight="ExtraBold"/>
                        <TextBlock Text="Pick a split, check in, and earn points from day one." FontSize="14" Classes="soft"/>
                    </StackPanel>

                    <Border Classes="formError" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <v:Icon Data="{StaticResource IcInfo}" Stroke="{DynamicResource ErrorText}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Error}" FontSize="13" Foreground="{DynamicResource ErrorText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Username" Classes="fieldLabel"/>
                        <Panel>
                            <TextBox TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" Classes="field" MaxLength="32" PlaceholderText="Letters, digits, _ . -" Text="{Binding Username}"
                                     AutomationProperties.Name="Username"/>
                            <v:Icon Classes="fieldIcon" Data="{StaticResource IcUser}"/>
                        </Panel>
                        <TextBlock Classes="fieldError" Text="{Binding UsernameError}"
                                   IsVisible="{Binding UsernameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Email" Classes="fieldLabel"/>
                        <Panel>
                            <TextBox TextInputOptions.ContentType="Email" Classes="field" MaxLength="254" PlaceholderText="you@example.com" Text="{Binding Email}"
                                     AutomationProperties.Name="Email"/>
                            <v:Icon Classes="fieldIcon" Data="{StaticResource IcMail}"/>
                        </Panel>
                        <TextBlock Classes="fieldError" Text="{Binding EmailError}"
                                   IsVisible="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Password" Classes="fieldLabel"/>
                        <Panel>
                            <TextBox TextInputOptions.ContentType="Password" Classes="field revealable" MaxLength="128" PasswordChar="●" PlaceholderText="8 to 128 characters"
                                     Text="{Binding Password}" AutomationProperties.Name="Password"/>
                            <v:Icon Classes="fieldIcon" Data="{StaticResource IcLock}"/>
                            <!-- Phones: show the password while typing it -->
                            <Button Classes="reveal phoneOnly" Click="OnReveal" AutomationProperties.Name="Show password">
                                <v:Icon Data="{StaticResource IcEye}"/>
                            </Button>
                        </Panel>
                        <TextBlock Classes="fieldError" Text="{Binding PasswordError}"
                                   IsVisible="{Binding PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Confirm password" Classes="fieldLabel"/>
                        <Panel>
                            <TextBox TextInputOptions.ContentType="Password" Classes="field revealable" MaxLength="128" PasswordChar="●" PlaceholderText="Type it again"
                                     Text="{Binding ConfirmPassword}" AutomationProperties.Name="Confirm password"/>
                            <v:Icon Classes="fieldIcon" Data="{StaticResource IcLock}"/>
                            <!-- Phones: show the password while typing it -->
                            <Button Classes="reveal phoneOnly" Click="OnReveal" AutomationProperties.Name="Show password">
                                <v:Icon Data="{StaticResource IcEye}"/>
                            </Button>
                        </Panel>
                        <TextBlock Classes="fieldError" Text="{Binding ConfirmPasswordError}"
                                   IsVisible="{Binding ConfirmPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <Button Classes="btn primary block" Content="Create account" Command="{Binding RegisterCommand}" IsDefault="True"
                            Margin="0,4,0,0"/>

                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="Already have an account?" FontSize="14" Classes="muted" VerticalAlignment="Center"/>
                            <Button Classes="link" Content="Sign in" FontSize="14" Command="{Binding GoToLoginCommand}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <v:Icon Data="{StaticResource IcLock}" Stroke="{DynamicResource Muted}" Width="13" Height="13" VerticalAlignment="Center"/>
                <TextBlock Classes="muted wideOnly" Text="Your workouts stay on this computer. Only your username, points and streak are shared with friends." FontSize="12" TextWrapping="Wrap" MaxWidth="380"/>
                <TextBlock Classes="muted phoneOnly" Text="Your workouts stay on this phone. Only your username, points and streak are shared with friends." FontSize="12" TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Panel>
</UserControl>
