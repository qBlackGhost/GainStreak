<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.MoreView"
             x:DataType="vm:MoreViewModel">
    <!-- The phones' More tab (16d): the profile card as in the sidebar, then the screens without a tab, Feedback and
         the version. Only phones show it; the sidebar lists the same screens. -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="Button.row">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.row.first">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
        </Style>
        <Style Selector="Button.row v|Icon.chevron">
            <Setter Property="Stroke" Value="{DynamicResource Muted}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
        <StackPanel Margin="16,24,16,32" Spacing="20">
            <TextBlock Text="More" FontSize="34" FontWeight="ExtraBold"/>

            <!-- Profile and log out, as in the sidebar -->
            <Border Classes="card" Padding="0" ClipToBounds="True">
                <Grid ColumnDefinitions="*,Auto">
                    <Button Classes="row first" Command="{Binding OpenProfileCommand}" MinHeight="72"
                            AutomationProperties.Name="Profile">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Inverse}">
                                <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource OnInverse}" FontWeight="Bold"
                                           FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Profile" FontSize="13" Classes="muted"/>
                            </StackPanel>
                            <v:Icon Grid.Column="2" Classes="chevron" Data="{StaticResource IcChevronRight}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Classes="btn outline" Width="44" Height="44" MinHeight="44" Padding="0" Margin="0,0,14,0"
                            Foreground="{DynamicResource Soft}" Command="{Binding LogOutCommand}"
                            AutomationProperties.Name="Log out">
                        <v:Icon Data="{StaticResource IcLogout}"/>
                    </Button>
                </Grid>
            </Border>

            <Border Classes="card" Padding="0" ClipToBounds="True">
                <StackPanel>
                    <Button Classes="row first" Command="{Binding OpenSplitsCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <v:Icon Data="{StaticResource IcCalendar}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Splits" VerticalAlignment="Center"/>
                            <v:Icon Grid.Column="2" Classes="chevron" Data="{StaticResource IcChevronRight}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="row" Command="{Binding OpenMapCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <v:Icon Data="{StaticResource IcMap}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Map" VerticalAlignment="Center"/>
                            <v:Icon Grid.Column="2" Classes="chevron" Data="{StaticResource IcChevronRight}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="row" Command="{Binding OpenInboxCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                            <v:Icon Data="{StaticResource IcInbox}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Inbox" VerticalAlignment="Center"/>
                            <!-- New in the inbox -->
                            <Border Grid.Column="2" Background="#FF6B5B" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0"
                                    VerticalAlignment="Center" IsVisible="{Binding HasUnread}">
                                <TextBlock Text="{Binding Unread}" Foreground="Black" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <v:Icon Grid.Column="3" Classes="chevron" Data="{StaticResource IcChevronRight}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="row" Command="{Binding OpenFeedbackCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <v:Icon Data="{StaticResource IcChat}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Feedback" VerticalAlignment="Center"/>
                            <v:Icon Grid.Column="2" Classes="chevron" Data="{StaticResource IcChevronRight}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding VersionText}" FontSize="13" Classes="muted" HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
