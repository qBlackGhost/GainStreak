<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.SplitsView"
             x:DataType="vm:SplitsViewModel">
    <!-- After the "Gym App" design canvas (Splits artboard). Choosing a split happens on its detail page, where the
         variant and start day are picked, so each card has Open (and Edit for custom splits); no separate "Set active". -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.splitCard">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style Selector="Border.splitCard.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="19"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="SplitCard" x:DataType="vm:SplitItemViewModel">
            <Border Classes="splitCard" Classes.active="{Binding IsSelected}">
                <DockPanel>
                    <!-- Buttons along the bottom, so cards in a row line up -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
                        <!-- Open: the detail page, where a split is chosen (variant and start day). Custom splits also Edit -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Classes="btn light" HorizontalAlignment="Stretch" Content="Open" Command="{Binding OpenCommand}"/>
                            <Button Grid.Column="1" Classes="btn outline" MinWidth="120" Content="Edit"
                                    Command="{Binding EditCommand}" IsVisible="{Binding IsCustom}"/>
                        </Grid>
                        <Button Classes="link" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left"
                                Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsCustom}"/>
                    </StackPanel>

                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Custom" FontSize="13" Classes="muted" IsVisible="{Binding IsCustom}"/>
                                <WrapPanel ItemSpacing="8" LineSpacing="6">
                                    <Border Classes="pill" BorderBrush="{DynamicResource ControlHover}" IsVisible="{Binding IsRecommended}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Data="{StaticResource IcStar}" Fill="{DynamicResource Ink}" Width="12" Height="12" Stretch="Uniform"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Recommended" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="pill" BorderThickness="0" Background="{DynamicResource Fill2}"
                                            IsVisible="{Binding RecommendedDaysTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <v:Icon Data="{StaticResource IcCalendar}" StrokeThickness="2.4" Width="12" Height="12"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding RecommendedDaysTag}" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="pill" BorderThickness="0" Background="{DynamicResource Accent}"
                                            IsVisible="{Binding IsSelected}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <v:Icon Data="{StaticResource IcCheck}" Stroke="Black" StrokeThickness="3" Width="12" Height="12"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="Active" FontSize="12" FontWeight="Bold" Foreground="Black"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding DaysText}" Classes="mono light" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding UsageText}" FontSize="12" Classes="muted" HorizontalAlignment="Right"
                                           IsVisible="{Binding UsageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Sequence}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{DynamicResource Fill}" CornerRadius="8" Padding="12,6">
                                        <TextBlock Text="{Binding}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Light}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding VariantsText}" FontSize="12" Classes="muted"
                                   IsVisible="{Binding VariantsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
    <DockPanel Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
        <v:Sidebar Current="Splits"/>

        <ScrollViewer>
        <StackPanel Classes="page" Spacing="32">
            <StackPanel Spacing="16">
                <!-- A tab on phones: nothing to go back to -->
                <Button Classes="btn outline wideOnly" MinHeight="40" Padding="10,0,14,0" FontSize="14" HorizontalAlignment="Left"
                        Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <v:Icon Data="{StaticResource IcBack}" StrokeThickness="2.2" Width="16" Height="16"/>
                        <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Grid Classes="pageHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="6" VerticalAlignment="Bottom">
                        <TextBlock Classes="pageTitle" Text="Workout splits" FontWeight="ExtraBold"/>
                        <TextBlock Text="Pick a preset or build your own weekly plan." FontSize="15" Classes="muted"/>
                    </StackPanel>
                    <Panel Classes="headerActions">
                    <WrapPanel Classes="wideOnly" ItemSpacing="10" LineSpacing="10" VerticalAlignment="Bottom">
                    <Border VerticalAlignment="Bottom" Padding="16,10" CornerRadius="12"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Surface}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="ACTIVE" FontSize="12" FontWeight="SemiBold" LetterSpacing="1.2" Classes="muted"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveName}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="btn primary" Padding="16,0" Command="{Binding OpenShareCommand}" ToolTip.Tip="Share a split with friends">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <v:Icon Data="{StaticResource IcShare}" Width="16" Height="16"/>
                            <TextBlock Text="Share" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    </WrapPanel>
                    </Panel>
                </Grid>
                <!-- Phones (the canvas): the active split in a lime banner, and Share beside it -->
                <Grid Classes="phoneOnly" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Padding="14,0" MinHeight="48" CornerRadius="14" BorderThickness="1"
                            BorderBrush="{DynamicResource LimeTintLine}" Background="{DynamicResource LimeTint}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE" FontSize="11" FontWeight="Bold" LetterSpacing="1.1" Foreground="{DynamicResource AccentInk}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveName}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Classes="btn outline" Padding="14,0" Command="{Binding OpenShareCommand}"
                            AutomationProperties.Name="Share a split with friends">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <v:Icon Data="{StaticResource IcShare}" Width="16" Height="16"/>
                            <TextBlock Text="Share" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

<TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold"
                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Spacing="16">
                <TextBlock Text="PRESETS" Classes="label"/>
                <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource SplitCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><v:ResponsiveGrid MinItemWidth="420" Spacing="16"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4" VerticalAlignment="Bottom">
                        <TextBlock Text="MY SPLITS" Classes="label"/>
                        <TextBlock FontSize="14" Classes="muted">
                            <Run Text="{Binding CustomCount}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Ink}"/><Run Text=" custom splits"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="btn primary" Command="{Binding NewCommand}" IsEnabled="{Binding CanAddCustom}"
                            VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <v:Icon Data="{StaticResource IcPlus}" StrokeThickness="2.6" Width="16" Height="16"/>
                            <TextBlock Text="New split" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl x:Name="CustomList" ItemsSource="{Binding Custom}" ItemTemplate="{StaticResource SplitCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><v:ResponsiveGrid MinItemWidth="420" Spacing="16"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- The empty slot: a dashed tile (Border can't dash, so a Rectangle draws the outline) -->
                <Panel IsVisible="{Binding CanAddCustom}" MinHeight="140" Cursor="Hand">
                    <Rectangle Stroke="{DynamicResource Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="16" RadiusY="16"/>
                    <Button Background="Transparent" BorderThickness="0" CornerRadius="16" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Foreground="{DynamicResource Muted}" Command="{Binding NewCommand}">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <v:Icon Data="{StaticResource IcPlus}" Width="28" Height="28" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SlotsLeftText}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Panel>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <!-- Share a split -->
    <v:ShareDialog DataContext="{Binding Share}"/>
    </Grid>
</UserControl>
