<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.WorkoutsView"
             x:DataType="vm:WorkoutsViewModel">
    <!-- After the "Gym App" design canvas (Workouts artboard): this week's plan, then a card per split day -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- "today is Push" in the accent; "today is a rest day" stays grey -->
        <Style Selector="Run.todayNote">
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Run.todayNote.rest">
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Week strip -->
        <Style Selector="Border.wkTile">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Border.wkTile.rest">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Faint}"/>
        </Style>
        <Style Selector="Border.wkTile.today">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#7D93A8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ColdText}"/>
        </Style>
        <Style Selector="Border.wkTile.todayRest">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Faint}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Light}"/>
        </Style>

        <Style Selector="ItemsControl#WeekTiles"><Setter Property="Margin" Value="-4"/></Style>
        <Style Selector="TextBlock.tileName"><Setter Property="FontSize" Value="13"/></Style>
        <!-- Phones (the canvas): seven narrow tiles, the words centred -->
        <Style Selector=".phone ItemsControl#WeekTiles"><Setter Property="Margin" Value="-2.5"/></Style>
        <Style Selector=".phone Border.wkTile">
            <Setter Property="Padding" Value="2,8"/>
            <Setter Property="Margin" Value="2.5"/>
        </Style>
        <Style Selector=".phone Border.wkTile TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
        <Style Selector=".phone TextBlock.tileName"><Setter Property="FontSize" Value="11"/></Style>

        <!-- Day cards -->
        <Style Selector="Border.dayCard">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style Selector="Border.dayCard.today">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="21"/>
        </Style>
        <!-- Phones: the cards' tighter padding -->
        <Style Selector=".phone Border.dayCard"><Setter Property="Padding" Value="16"/></Style>
        <Style Selector=".phone Border.dayCard.today"><Setter Property="Padding" Value="15"/></Style>
    </UserControl.Styles>
    <Grid>
    <DockPanel Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
        <v:Sidebar Current="Workouts"/>

        <ScrollViewer>
        <StackPanel Classes="page" Spacing="24">
            <!-- Header -->
            <Grid Classes="pageHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                <StackPanel Spacing="6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding DateText}" FontSize="14" FontWeight="Medium" Classes="muted"/>
                    <TextBlock Classes="pageTitle" Text="Workouts" FontWeight="ExtraBold"/>
                    <TextBlock FontSize="15" Classes="soft" IsVisible="{Binding HasSplit}">
                        <Run Text="{Binding SplitName}"/><Run Text=" · "/><Run Text="{Binding TodayNote}" Classes="todayNote"
                             Classes.rest="{Binding IsRestToday}"/>
                    </TextBlock>
                </StackPanel>
                <WrapPanel Classes="headerActions" ItemSpacing="10" LineSpacing="10" VerticalAlignment="Bottom" IsVisible="{Binding HasSplit}">
                    <Button Classes="btn primary" Padding="16,0" Command="{Binding OpenShareCommand}" ToolTip.Tip="Share a workout with friends">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <v:Icon Data="{StaticResource IcShare}" Width="16" Height="16"/>
                            <TextBlock Text="Share" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="btn outline" Padding="16,0" Command="{Binding ChooseSplitCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <v:Icon Data="{StaticResource IcCalendar}" Width="16" Height="16"/>
                            <TextBlock Text="Change split" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="btn outline" Padding="16,0" Command="{Binding CustomExercisesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <v:Icon Data="{StaticResource IcPlus}" StrokeThickness="2.4" Width="16" Height="16"/>
                            <TextBlock Text="Custom exercises" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

<TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold"
                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- This week's schedule -->
            <ItemsControl x:Name="WeekTiles" ItemsSource="{Binding Week}" IsVisible="{Binding HasSplit}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WeekdayTileViewModel">
                        <Border Classes="wkTile" Classes.rest="{Binding IsRest}" Classes.today="{Binding IsTodayTraining}"
                                Classes.todayRest="{Binding IsTodayRest}">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Day}" FontSize="11" FontWeight="SemiBold" Opacity="0.75"/>
                                <TextBlock Classes="tileName" Text="{Binding Name}" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Rest day -->
            <Border Padding="18,14" CornerRadius="14" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    IsVisible="{Binding IsRestToday}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <v:Icon Data="{StaticResource IcMoon}" Stroke="{DynamicResource Soft}" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" FontSize="14" Classes="light" VerticalAlignment="Center">
                        <Run Text="Today is a rest day."/><Run Text="{Binding NextName, Converter={x:Static v:WorkoutsView.NextUp}}"/><Run
                             Text="{Binding NextName}" Foreground="{DynamicResource Ink}" FontWeight="Bold"/><Run
                             Text="{Binding NextName, Converter={x:Static v:WorkoutsView.NextUpEnd}}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- A card per split day -->
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><v:ResponsiveGrid MinItemWidth="320" Spacing="18"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayCardViewModel">
                        <Border Classes="dayCard" Classes.today="{Binding IsToday}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,16,0,0">
                                    <Button Classes="btn" Classes.primary="{Binding IsAccentOpen}" Classes.light="{Binding !IsAccentOpen}"
                                            HorizontalAlignment="Stretch" Content="{Binding OpenLabel}" Command="{Binding OpenCommand}"/>
                                    <!-- Copying lives on the day page -->
                                    <Button Classes="btn outline" HorizontalAlignment="Stretch" Content="Copy from another day"
                                            Command="{Binding OpenCommand}" IsVisible="{Binding IsEmpty}"/>
                                </StackPanel>

                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="8">
                                            <WrapPanel ItemSpacing="10" LineSpacing="6">
                                                <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                                <Border Classes="pill" BorderThickness="0" Background="{DynamicResource Accent}"
                                                        IsVisible="{Binding IsToday}">
                                                    <TextBlock Text="Today" FontSize="12" FontWeight="Bold" Foreground="Black"/>
                                                </Border>
                                                <Border Classes="pill" BorderBrush="{DynamicResource ControlHover}" IsVisible="{Binding IsNext}">
                                                    <TextBlock Text="Next up" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                                                </Border>
                                            </WrapPanel>
                                            <ItemsControl ItemsSource="{Binding WeekdayChips}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Background="{DynamicResource Fill2}" CornerRadius="6" Padding="9,3">
                                                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="mono soft" FontSize="13" FontWeight="Bold"/>
                                    </Grid>

                                    <StackPanel IsVisible="{Binding HasExercises}">
                                        <ItemsControl ItemsSource="{Binding Exercises}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DayExerciseLine">
                                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" MinHeight="40">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Sets}" Classes="mono muted" FontSize="12"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding MoreText}" FontSize="13" Classes="muted" Margin="0,6,0,0"
                                                   IsVisible="{Binding MoreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>

                                    <Panel MinHeight="120" IsVisible="{Binding IsEmpty}">
                                        <Rectangle Stroke="{DynamicResource Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="12" RadiusY="12"/>
                                        <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                            <TextBlock Text="No exercises yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Add some, or copy them from another day." FontSize="12" Classes="muted"
                                                       TextAlignment="Center"/>
                                        </StackPanel>
                                    </Panel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- No split yet -->
            <Panel MinHeight="420" IsVisible="{Binding ShowEmpty}">
                <Rectangle Stroke="{DynamicResource Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="20" RadiusY="20"/>
                <StackPanel Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40" MaxWidth="440">
                    <v:Icon Data="{StaticResource IcDumbbell}" Stroke="{DynamicResource Faint}" StrokeThickness="1.6" Width="40" Height="40"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="No split selected" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Each day of your split gets its own exercise list here. Pick a split to get started."
                               FontSize="15" Classes="soft" TextAlignment="Center" LineHeight="22"/>
                    <Button Classes="btn primary" MinHeight="48" Padding="22,0" FontSize="15" HorizontalAlignment="Center"
                            Content="Choose a split" Command="{Binding ChooseSplitCommand}"/>
                </StackPanel>
            </Panel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <!-- Share a workout -->
    <v:ShareDialog DataContext="{Binding Share}"/>
    </Grid>
</UserControl>
