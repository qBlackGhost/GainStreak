<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.CaloriesView"
             x:DataType="vm:CaloriesViewModel">
    <!-- After the "Gym App" design canvas (Calories artboard): today and the last 7 days on the left, the calorie goal
         and maintenance estimate on the right. Below 880 px of content the right column goes under the left. -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Status pill -->
        <Style Selector="Border.status">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Soft}"/>
        </Style>
        <Style Selector="Border.status.off">
            <Setter Property="BorderBrush" Value="{DynamicResource OrangeTintLine}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource FlameText}"/>
        </Style>
        <Style Selector="Border.status.hit">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>

        <!-- Ring: white when under, orange over, lime on target -->
        <Style Selector="Arc.ring"><Setter Property="Stroke" Value="{DynamicResource Ink}"/></Style>
        <Style Selector="Arc.ring.over"><Setter Property="Stroke" Value="{DynamicResource Flame}"/></Style>
        <Style Selector="Arc.ring.hit"><Setter Property="Stroke" Value="{DynamicResource AccentInk}"/></Style>

        <!-- Chart bars -->
        <Style Selector="Border.bar">
            <Setter Property="MaxWidth" Value="44"/>
            <Setter Property="CornerRadius" Value="6,6,2,2"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Background" Value="{DynamicResource Faint}"/>
        </Style>
        <Style Selector="Border.bar.hit"><Setter Property="Background" Value="{DynamicResource Accent}"/></Style>
        <!-- The day shown in the food diary (phones) -->
        <Style Selector="Border.bar.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.bar.missing">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Two columns by default; CaloriesView.axaml.cs stacks them when narrow -->
        <Style Selector="StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#LeftColumn">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <!-- Sizes the phones change (the GainStreak Mobile canvas), here so the ".phone" styles can override them -->
        <Style Selector="Border.todayCard"><Setter Property="Padding" Value="28"/></Style>
        <Style Selector="Grid#Ring">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="200"/>
        </Style>
        <Style Selector="TextBlock.ringCenter"><Setter Property="FontSize" Value="32"/></Style>
        <Style Selector="Border.eatenTile"><Setter Property="Grid.Column" Value="1"/></Style>
        <Style Selector="TextBlock.tileLabel">
            <Setter Property="DockPanel.Dock" Value="Top"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.tileValue"><Setter Property="FontSize" Value="20"/></Style>
        <!-- Phones: a smaller ring, Goal and Eaten as rows with the number on the right -->
        <Style Selector=".phone Border.todayCard"><Setter Property="Padding" Value="16"/></Style>
        <Style Selector=".phone Border.todayCard Border.tile"><Setter Property="Padding" Value="12,10"/></Style>
        <Style Selector=".phone Grid#Ring">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="140"/>
        </Style>
        <Style Selector=".phone TextBlock.ringCenter"><Setter Property="FontSize" Value="24"/></Style>
        <Style Selector=".phone v|PhoneGrid.goalEaten"><Setter Property="RowSpacing" Value="8"/></Style>
        <Style Selector=".phone Border.eatenTile">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
        </Style>
        <Style Selector=".phone TextBlock.tileLabel">
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector=".phone TextBlock.tileValue">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- The phones' maintenance formula chips -->
        <Style Selector="Border.calcChip">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="TextElement.FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>
    <DockPanel Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
        <v:Sidebar Current="Calories"/>

        <ScrollViewer>
        <StackPanel Classes="page" Spacing="24">
            <!-- Header -->
            <Grid Classes="pageHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding DateText}" FontSize="14" FontWeight="Medium" Classes="muted"/>
                    <TextBlock Classes="pageTitle" Text="Calories" FontWeight="ExtraBold"/>
                    <TextBlock Classes="soft wideOnly" Text="Log what you ate once, at the end of the day." FontSize="15"/>
                </StackPanel>
                <!-- Stays beside the title on phones too (the canvas), unlike other screens' header buttons -->
                <Border Grid.Column="1" Classes="pill" Padding="12,6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding HeaderPill}" FontSize="13" FontWeight="SemiBold" Classes="light"/>
                </Border>
            </Grid>

            <TextBlock Text="{Binding Info}" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold"
                       IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Grid x:Name="Columns" ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="24">
                <StackPanel x:Name="LeftColumn" Spacing="24">

                    <!-- Today -->
                    <Border Classes="card todayCard">
                        <StackPanel Spacing="22">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Today" Classes="h2" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="status" Classes.off="{Binding IsOff}" Classes.hit="{Binding IsHit}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <v:PhoneGrid ColumnDefinitions="Auto,*" ColumnSpacing="32" PhoneColumns="Auto,*" PhoneColumnSpacing="16">
                                <Grid x:Name="Ring">
                                    <Ellipse Stroke="{DynamicResource Line}" StrokeThickness="16"/>
                                    <Arc Classes="ring" Classes.over="{Binding IsOver}" Classes.hit="{Binding IsHit}"
                                         StartAngle="-90" SweepAngle="{Binding RingSweep}" StrokeThickness="16"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock Classes="mono ringCenter" Text="{Binding RingCenter}" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RingCenterSub}" FontSize="13" Classes="soft" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                                    <v:PhoneGrid Classes="goalEaten" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12"
                                                 PhoneColumns="*">
                                        <Border Classes="tile">
                                            <DockPanel>
                                                <TextBlock Classes="muted tileLabel" Text="Goal" FontSize="12"/>
                                                <TextBlock Classes="mono tileValue" Text="{Binding GoalKcal}" FontWeight="Bold"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Classes="tile eatenTile">
                                            <DockPanel>
                                                <TextBlock Classes="muted tileLabel" Text="Eaten" FontSize="12"/>
                                                <TextBlock Classes="mono tileValue" Text="{Binding EatenKcal}" FontWeight="Bold"/>
                                            </DockPanel>
                                        </Border>
                                    </v:PhoneGrid>
                                    <TextBlock FontSize="13" Classes="soft" LineHeight="20" IsVisible="{Binding HasGoal}">
                                        <Run Text="On target between "/><Run Text="{Binding RangeText}" FontFamily="{StaticResource Mono}"
                                             Foreground="{DynamicResource Ink}"/><Run Text=" kcal. Hitting it gives "/><Run Text="+10 pts" FontWeight="Bold"
                                             Foreground="{DynamicResource Ink}"/><Run Text="."/>
                                    </TextBlock>
                                    <Panel IsVisible="{Binding !HasGoal}">
                                        <TextBlock Classes="soft wideOnly" Text="No calorie goal yet. Set one on the right." FontSize="13"/>
                                        <TextBlock Classes="soft phoneOnly" Text="No calorie goal yet. Set one below." FontSize="13"/>
                                    </Panel>
                                </StackPanel>
                            </v:PhoneGrid>

                            <StackPanel Spacing="6" IsVisible="{Binding ShowLegacyLogForm}">
                                <TextBlock Classes="muted wideOnly" Text="Eaten today (kcal)" FontSize="12"/>
                    <TextBlock Classes="muted phoneOnly" Text="Eaten today (kcal) · log once, at the end of the day" FontSize="12"/>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <TextBox TextInputOptions.ContentType="Digits" x:Name="TodayBox" Classes="field" MinHeight="48" FontSize="16" PlaceholderText="e.g. 1900"
                                             Text="{Binding TodayInput}"/>
                                    <Button Grid.Column="1" Classes="btn outline" MinHeight="48" Content="Cancel"
                                            Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}"/>
                                    <Button Grid.Column="2" Classes="btn primary" MinHeight="48" Padding="24,0" FontSize="15"
                                            Content="Log" Command="{Binding LogCommand}"/>
                                </Grid>
                                <TextBlock Classes="fieldError" Text="{Binding TodayError}"
                                           IsVisible="{Binding TodayError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <Border Padding="16,14" CornerRadius="12" Background="{DynamicResource Surface2}" IsVisible="{Binding ShowLegacyResult}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{Binding ResultText}" FontSize="14" Classes="light" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="btn outline small" Content="Edit" Command="{Binding EditCommand}"/>
                                </Grid>
                            </Border>
                            <!-- Phones (Phase 26): food is logged on the Add food sheet, not typed here -->
                            <Button Classes="btn primary" MinHeight="50" FontSize="15" Content="Add food" Command="{Binding AddFoodNowCommand}"
                                    IsVisible="{Binding HasFoodLog}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Food diary (Phase 26, phones): today by meal, or a past day read-only -->
                    <Border Classes="card" IsVisible="{Binding HasFoodLog}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{Binding DiaryTitle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="btn outline small" Content="Back to today" Command="{Binding BackToTodayCommand}"
                                        IsVisible="{Binding DiaryIsPast}"/>
                            </Grid>
                            <TextBlock Text="{Binding MacroText}" FontSize="13" Classes="soft" IsVisible="{Binding HasMacros}"/>
                            <Border Classes="tile" IsVisible="{Binding DiaryIsTotalOnly}">
                                <TextBlock Text="{Binding DiaryTotalText}" FontSize="14" Classes="light"/>
                            </Border>
                            <TextBlock Text="Nothing was logged this day." Classes="muted" FontSize="13" IsVisible="{Binding DiaryIsEmpty}"/>
                            <ItemsControl ItemsSource="{Binding Meals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MealGroupViewModel">
                                        <StackPanel Spacing="0" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,6,0,2">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding KcalText}" Classes="mono soft" FontSize="13" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Classes="link" Content="+ Add" Command="{Binding AddCommand}" IsVisible="{Binding CanAdd}"
                                                        Foreground="{DynamicResource AccentInk}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:FoodEntryRowViewModel">
                                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                                <Button Background="Transparent" BorderThickness="0" Padding="0,8" HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch" Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                        <StackPanel Spacing="1">
                                                                            <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                            <TextBlock Text="{Binding Detail}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1" Text="{Binding KcalText}" Classes="mono" FontSize="14" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Button>
                                                                <Button Grid.Column="1" Classes="icon" Command="{Binding DeleteCommand}" IsVisible="{Binding CanEdit}"
                                                                        AutomationProperties.Name="Delete">
                                                                    <v:Icon Data="{StaticResource IcX}" Width="14" Height="14" StrokeThickness="2.4" Stroke="{DynamicResource Muted}"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Last 7 days -->
                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Last 7 days" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding HitsText}" FontSize="13" Classes="soft" VerticalAlignment="Bottom"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Bars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalorieBarViewModel">
                                        <TextBlock Text="{Binding Label}" Classes="mono soft" FontSize="11" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- The target range as a band behind the bars -->
                            <Panel Height="160" ToolTip.Tip="Calories eaten each day against the target range">
                                <Border VerticalAlignment="Bottom" Height="{Binding BandHeight}" Margin="{Binding BandBottom,
                                        Converter={x:Static v:CaloriesView.BottomMargin}}" Background="#1FC6F432"
                                        BorderBrush="#80C6F432" BorderThickness="0,1"/>
                                <ItemsControl ItemsSource="{Binding Bars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CalorieBarViewModel">
                                            <!-- On the phones a bar opens that day's food diary -->
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Bottom"
                                                    Command="{Binding $parent[UserControl].((vm:CaloriesViewModel)DataContext).ShowDayCommand}"
                                                    CommandParameter="{Binding Date}"
                                                    IsHitTestVisible="{Binding $parent[UserControl].((vm:CaloriesViewModel)DataContext).HasFoodLog}">
                                                <Border Classes="bar" Classes.hit="{Binding IsHit}" Classes.missing="{Binding IsMissing}"
                                                        Classes.selected="{Binding IsSelected}" Height="{Binding BarHeight}" Margin="6,0"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Line}"/>
                            </Panel>
                            <ItemsControl ItemsSource="{Binding Bars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalorieBarViewModel">
                                        <TextBlock Text="{Binding Day}" FontSize="12" FontWeight="SemiBold" Classes="muted"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel ItemSpacing="16" LineSpacing="6">
                                <WrapPanel.Styles>
                                    <Style Selector="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
                                </WrapPanel.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Accent}"/>
                                    <TextBlock Text="On target"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Faint}"/>
                                    <TextBlock Text="Off target"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="3" BorderBrush="{DynamicResource Faint}" BorderThickness="1"/>
                                    <TextBlock Text="Not logged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="14" Height="10" Background="#1FC6F432"/>
                                    <TextBlock Text="Target range"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RightColumn" Spacing="24">

                    <!-- Calorie goal -->
                    <Border Classes="card">
                        <StackPanel Spacing="18">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock Text="Calorie goal" Classes="h2" VerticalAlignment="Center"/>
                                <!-- Phones (the canvas): the goal sits in the title row -->
                                <TextBlock Grid.Column="1" Classes="phoneOnly" VerticalAlignment="Center">
                                    <Run Text="{Binding GoalText}" FontSize="24" FontWeight="ExtraBold"/><Run Text=" kcal / day" FontSize="12"
                                         FontWeight="SemiBold" Foreground="{DynamicResource Soft}"/>
                                </TextBlock>
                            </Grid>
                            <Border Padding="4" CornerRadius="12" Background="{DynamicResource Fill}">
                                <ItemsControl ItemsSource="{Binding GoalTypes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <v:SegmentedPill SelectedIndex="{Binding SelectedGoalIndex}" PillInset="0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GoalTypeOptionViewModel">
                                            <Button Classes="seg" Classes.on="{Binding IsSelected}" MinHeight="40" FontSize="14"
                                                    Content="{Binding Name}" Command="{Binding PickCommand}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="wideOnly">
                                    <Run Text="{Binding GoalText}" FontSize="40" FontWeight="ExtraBold"/><Run Text=" kcal / day" FontSize="18"
                                         FontWeight="Bold" Foreground="{DynamicResource Soft}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding GoalRule}" FontSize="13" Classes="soft"/>
                            </StackPanel>

                            <Border Padding="16" CornerRadius="14" BorderBrush="{DynamicResource AccentInk}" BorderThickness="1"
                                    Background="{DynamicResource LimeTint}" IsVisible="{Binding ShowSuggestion}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding SuggestionTitle}" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SuggestionNote}" FontSize="12" Classes="soft"/>
                                        </StackPanel>
                                        <!-- Phones (the canvas): Use beside the suggestion -->
                                        <Button Grid.Column="1" Classes="btn primary small phoneOnly" MinHeight="40" Padding="14,0"
                                                Content="Use" Command="{Binding UseSuggestionCommand}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Classes="btn primary small wideOnly" MinHeight="40" Padding="16,0" Content="{Binding UseSuggestionLabel}"
                                                Command="{Binding UseSuggestionCommand}"/>
                                        <Button Classes="btn outline small" MinHeight="40" Content="{Binding KeepGoalLabel}"
                                                Command="{Binding KeepGoalCommand}" IsVisible="{Binding CanKeepGoal}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding SuggestionReason}" FontSize="12" Classes="muted"
                                       IsVisible="{Binding SuggestionReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted wideOnly" Text="Your own goal (kcal)" FontSize="12"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBox TextInputOptions.ContentType="Digits" x:Name="GoalBox" Classes="field" PlaceholderText="Your own goal, e.g. 2000" Text="{Binding CustomGoalInput}"/>
                                    <Button Grid.Column="1" Classes="btn outline strong wideOnly" Padding="16,0" Content="Set my own goal"
                                            Command="{Binding SetCustomGoalCommand}"/>
                                    <Button Grid.Column="1" Classes="btn light phoneOnly" Padding="18,0" Content="Set"
                                            Command="{Binding SetCustomGoalCommand}"/>
                                </Grid>
                                <TextBlock Classes="fieldError" Text="{Binding GoalError}"
                                           IsVisible="{Binding GoalError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <v:Icon Data="{StaticResource IcShield}" Stroke="{DynamicResource Muted}" Width="16" Height="16"
                                        VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <TextBlock Grid.Column="1" FontSize="12" Classes="muted" LineHeight="18"
                                           Text="Safe limits: at least 1,500 kcal for men and 1,200 kcal for women, and never more than 25% under your maintenance."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Maintenance calories -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <Grid Classes="wideOnly" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Maintenance calories" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Estimate" FontSize="12" Classes="muted" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Phones (the canvas): the estimate in the title row, the formula as one row of chips -->
                            <StackPanel Classes="phoneOnly" Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Maintenance" FontSize="18" FontWeight="Bold"/><Run Text=" estimate" FontSize="12"
                                             Foreground="{DynamicResource Muted}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding HasMaintenance}">
                                        <Run Text="{Binding MaintenanceKcal}" FontSize="24" FontWeight="ExtraBold"/><Run Text=" kcal" FontSize="12"
                                             FontWeight="SemiBold" Foreground="{DynamicResource Soft}"/>
                                    </TextBlock>
                                </Grid>
                                <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding HasMaintenance}">
                                    <Border Classes="calcChip"><TextBlock><Run Text="BMR " Foreground="{DynamicResource Muted}"/><Run Text="{Binding BmrText}" FontFamily="{StaticResource Mono}" FontWeight="Bold"/></TextBlock></Border>
                                    <TextBlock Text="×" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                                    <Border Classes="calcChip"><TextBlock><Run Text="Activity " Foreground="{DynamicResource Muted}"/><Run Text="{Binding ActivityFactorText}" FontFamily="{StaticResource Mono}" FontWeight="Bold"/></TextBlock></Border>
                                    <TextBlock Text="=" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                                    <Border Classes="calcChip" Background="Transparent" BorderBrush="{DynamicResource Control}" BorderThickness="1">
                                        <TextBlock Text="TDEE" Foreground="{DynamicResource Soft}"/>
                                    </Border>
                                </WrapPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{Binding MaintenanceNote}" FontSize="12" Classes="muted" LineHeight="17"/>
                                    <Button Grid.Column="1" Classes="link" FontSize="13" Content="Edit body data" Command="{Binding ShowProfileCommand}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <Panel Classes="wideOnly">
                            <StackPanel Spacing="14" IsVisible="{Binding HasMaintenance}">
                                <TextBlock>
                                    <Run Text="{Binding MaintenanceKcal}" FontSize="34" FontWeight="ExtraBold"/><Run Text=" kcal / day"
                                         FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Soft}"/>
                                </TextBlock>
                                <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="8">
                                    <Border Classes="tile" Padding="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="BMR" FontSize="11" Classes="muted"/>
                                            <TextBlock Text="{Binding BmrText}" Classes="mono" FontSize="16" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="×" FontWeight="Bold" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Classes="tile" Padding="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Activity" FontSize="11" Classes="muted"/>
                                            <TextBlock Text="{Binding ActivityFactorText}" Classes="mono" FontSize="16" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="=" FontWeight="Bold" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="4" Classes="tile" Padding="12" Background="Transparent" BorderBrush="{DynamicResource Control}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="TDEE" FontSize="11" Classes="muted"/>
                                            <TextBlock Text="{Binding TdeeText}" Classes="mono" FontSize="16" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                            </Panel>
                            <TextBlock Classes="muted wideOnly" Text="{Binding MaintenanceNote}" FontSize="12" LineHeight="18"/>
                            <Button Classes="link wideOnly" HorizontalAlignment="Left" Content="Edit body data in Profile"
                                    Command="{Binding ShowProfileCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
