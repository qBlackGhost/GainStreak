<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.ExerciseView"
             x:DataType="vm:ExerciseViewModel">
    <!-- After the "Gym App" design canvas (Exercise artboard): today's sets on the left, the PR, last time and the
         top set per session on the right. Below 880 px of content the right column goes under the left. -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/GainStreakStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.colHead">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="1.1"/>
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- A working set that sets a new PR -->
        <Style Selector="TextBox.field.pr">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
        </Style>
        <Style Selector="TextBlock.totalHint"><Setter Property="Margin" Value="242,0,0,0"/></Style>
        <Style Selector="TextBlock.exTitle"><Setter Property="FontSize" Value="40"/></Style>
        <Style Selector="Border#SetsCard"><Setter Property="Padding" Value="28"/></Style>
        <!-- Phones (the canvas): the rows' narrower columns (PhoneGrid) move this under the weight -->
        <Style Selector=".phone TextBlock.totalHint"><Setter Property="Margin" Value="146,0,0,0"/></Style>
        <Style Selector=".phone Border#SetsCard"><Setter Property="Padding" Value="16"/></Style>
        <Style Selector=".phone TextBlock.exTitle"><Setter Property="FontSize" Value="30"/></Style>
        <Style Selector="TextBlock.cardTitle"><Setter Property="FontSize" Value="20"/></Style>
        <Style Selector=".phone TextBlock.cardTitle"><Setter Property="FontSize" Value="18"/></Style>
        <!-- In the narrow set rows: no 64 px floor on the boxes, and the type switch's words fit -->
        <Style Selector=".phone v|PhoneGrid TextBox"><Setter Property="MinWidth" Value="0"/></Style>
        <Style Selector=".phone v|PhoneGrid Button.seg"><Setter Property="FontSize" Value="11"/></Style>
        <!-- A switch's words stay on one line ("Working" used to break in the phones' narrow rows) -->
        <Style Selector="Button.seg TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <!-- The phones' planned-set pills -->
        <Style Selector="Border.planPill">
            <Setter Property="Padding" Value="10,2,2,2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
        </Style>
        <Style Selector="Border.planPill TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <!-- − / + steppers -->
        <Style Selector="Button.step">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- In the phones' planned-set pills the steppers are a little narrower, so the label and count fit -->
        <Style Selector="Border.planPill Button.step"><Setter Property="Width" Value="32"/></Style>
        <Style Selector="Button.step:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <!-- The PR card glows right after a save sets a new PR -->
        <Style Selector="Border.prCard.fresh">
            <Setter Property="Background" Value="{DynamicResource LimeTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
            <Setter Property="BoxShadow" Value="0 0 24 0 #2EC6F432"/>
        </Style>
        <Style Selector="Border.prCard">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.6"/>
                    <BrushTransition Property="Background" Duration="0:0:0.6"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.topBar">
            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
            <Setter Property="CornerRadius" Value="6,6,2,2"/>
            <Setter Property="MaxWidth" Value="40"/>
        </Style>
        <Style Selector="Border.topBar.pr">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- Two columns by default; stacked when narrow -->
        <Style Selector="StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid.stack Border#SetsCard">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>

        <!-- Weekly stats: the week's best set; a PR week in lime, a week without sets just its date -->
        <Style Selector="Border.weekBar">
            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
            <Setter Property="CornerRadius" Value="6,6,2,2"/>
            <Setter Property="MaxWidth" Value="40"/>
        </Style>
        <Style Selector="Border.weekBar.pr">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Button.weekNav">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.weekNav:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- Hides a phoneOnly / wideOnly element with nothing to show. A style, not an IsVisible binding (which would
             beat those classes); last, so it wins over them -->
        <Style Selector=":is(Control).off">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <!-- Top set per session: in the right column, on phones at the top (the canvas) -->
        <DataTemplate x:Key="TopSetsCard" x:DataType="vm:ExerciseViewModel">
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Top set per session" Classes="cardTitle" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="kg" FontSize="12" Classes="muted" VerticalAlignment="Bottom"/>
                    </Grid>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <ItemsControl ItemsSource="{Binding TopSets}" Height="124">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TopSetBar">
                                    <StackPanel Spacing="4" VerticalAlignment="Bottom" Margin="5,0">
                                        <TextBlock Text="{Binding Weight}" Classes="mono soft" FontSize="11" HorizontalAlignment="Center"/>
                                        <Border Classes="topBar" Classes.pr="{Binding IsPr}" Height="{Binding Height}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ItemsControl ItemsSource="{Binding TopSets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TopSetBar">
                                <TextBlock Text="{Binding Date}" FontSize="11" Classes="muted" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="PR session" FontSize="12" Classes="muted"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
        <v:Sidebar Current="Workouts"/>

        <ScrollViewer>
        <StackPanel Classes="page" Spacing="24">
            <!-- Header -->
            <StackPanel Spacing="14">
                <Button Classes="btn outline" MinHeight="40" Padding="10,0,14,0" FontSize="14" HorizontalAlignment="Left"
                        Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <v:Icon Data="{StaticResource IcBack}" StrokeThickness="2.2" Width="16" Height="16"/>
                        <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="exTitle" Text="{Binding Title}" FontWeight="ExtraBold"/>
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Border Classes="pill" BorderThickness="0" Background="{DynamicResource Fill2}" Padding="11,4">
                                <TextBlock Text="{Binding MuscleText}" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                            </Border>
                            <Border Classes="pill" BorderThickness="0" Background="{DynamicResource Fill2}" Padding="11,4">
                                <TextBlock Text="{Binding DayText}" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                            </Border>
                            <Border Classes="pill" Padding="11,4"
                                    IsVisible="{Binding PositionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding PositionText}" FontSize="12" FontWeight="SemiBold" Classes="soft"/>
                            </Border>
                            <TextBlock Classes="muted phoneOnly" Text="{Binding DateText}" FontSize="13" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DateText}" FontSize="14" FontWeight="Medium" Classes="muted wideOnly"
                               VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>

            <!-- Saved -->
            <Border Padding="18,14" CornerRadius="14" BorderBrush="{DynamicResource LimeTintLine}" BorderThickness="1" Background="{DynamicResource LimeTint}"
                    Classes.pr="{Binding IsPrFresh}"
                    IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Border.Styles>
                    <Style Selector="Border.pr">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                        <Setter Property="Background" Value="{DynamicResource LimeTint}"/>
                    </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Info}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- ===== Weekly stats: the heaviest working set of each week, six weeks a page; swipe or ‹ › for others ===== -->
            <Border Classes="card" Classes.off="{Binding !HasWeeks}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Weekly stats" Classes="cardTitle" FontWeight="Bold"/>
                            <TextBlock FontSize="12" Classes="muted">
                                <Run Text="Best set per week · "/><Run Text="{Binding WeekRangeText}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="btn outline weekNav" Command="{Binding OlderWeeksCommand}"
                                AutomationProperties.Name="Earlier weeks" ToolTip.Tip="Earlier weeks">
                            <v:Icon Data="{StaticResource IcBack}" StrokeThickness="2.2" Width="14" Height="14"/>
                        </Button>
                        <Button Grid.Column="2" Classes="btn outline weekNav" Command="{Binding NewerWeeksCommand}"
                                AutomationProperties.Name="Later weeks" ToolTip.Tip="Later weeks">
                            <v:Icon Data="{StaticResource IcArrowRight}" StrokeThickness="2.2" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    <!-- The chart takes the swipes (SetupWeekSwipe in the code-behind) -->
                    <StackPanel x:Name="WeekChart" Spacing="8" Background="Transparent">
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                            <ItemsControl ItemsSource="{Binding WeekBars}" Height="124">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WeekBar">
                                        <StackPanel Spacing="4" VerticalAlignment="Bottom" Margin="5,0">
                                            <TextBlock Text="{Binding Weight}" Classes="mono soft" FontSize="11" HorizontalAlignment="Center"
                                                       IsVisible="{Binding HasSet}"/>
                                            <Border Classes="weekBar" Classes.pr="{Binding IsPr}" Height="{Binding Height}"
                                                    IsVisible="{Binding HasSet}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <ItemsControl ItemsSource="{Binding WeekBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WeekBar">
                                    <TextBlock Text="{Binding Label}" FontSize="11" Classes="muted" HorizontalAlignment="Center"
                                               TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="PR week" FontSize="12" Classes="muted"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Phones (the canvas): the top-set chart before today's sets -->
            <ContentControl Classes="phoneOnly" Classes.off="{Binding !HasTopSets}" Content="{Binding}"
                            ContentTemplate="{StaticResource TopSetsCard}"/>

            <Grid x:Name="Columns" ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="24">

                <!-- ===== Today's sets ===== -->
                <Border x:Name="SetsCard" Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Today's sets" Classes="h2"/>
                                <TextBlock Classes="muted wideOnly" Text="Weight in kg. Warm-up sets never count toward your PR." FontSize="13"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="btn outline small" MinHeight="40" VerticalAlignment="Top"
                                    Command="{Binding PrefillCommand}" IsVisible="{Binding HasLast}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <v:Icon Data="{StaticResource IcMadeUp}" StrokeThickness="2.2" Width="15" Height="15"/>
                                    <TextBlock Classes="wideOnly" Text="Fill from last time" VerticalAlignment="Center"/>
                                    <TextBlock Classes="phoneOnly" Text="Fill last" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Phones (the canvas): the planned sets as two pills side by side -->
                        <Grid Classes="phoneOnly" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Classes="planPill">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Text="Warm-up" FontSize="12" FontWeight="SemiBold" Classes="soft" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="step" Content="−" Command="{Binding FewerWarmupCommand}"
                                            AutomationProperties.Name="Fewer warm-up sets"/>
                                    <TextBlock Grid.Column="2" Text="{Binding WarmupSets}" Classes="mono" FontWeight="Bold" MinWidth="16"
                                               TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Classes="step" Content="+" Command="{Binding MoreWarmupCommand}"
                                            AutomationProperties.Name="More warm-up sets"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Classes="planPill">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Text="Working" FontSize="12" FontWeight="SemiBold" Classes="soft" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="step" Content="−" Command="{Binding FewerWorkingCommand}"
                                            AutomationProperties.Name="Fewer working sets"/>
                                    <TextBlock Grid.Column="2" Text="{Binding WorkingSets}" Classes="mono" FontWeight="Bold" MinWidth="16"
                                               TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Classes="step" Content="+" Command="{Binding MoreWorkingCommand}"
                                            AutomationProperties.Name="More working sets"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Planned sets -->
                        <Border Classes="wideOnly" Padding="16,12" CornerRadius="14" Background="{DynamicResource Surface2}">
                            <WrapPanel ItemSpacing="20" LineSpacing="10">
                                <TextBlock Text="PLANNED" FontSize="12" FontWeight="Bold" LetterSpacing="1.4" Classes="muted"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Warm-up" FontSize="14" Classes="light" VerticalAlignment="Center"/>
                                    <Border BorderBrush="{DynamicResource Control}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="step" Content="−" Command="{Binding FewerWarmupCommand}"
                                                    AutomationProperties.Name="Fewer warm-up sets"/>
                                            <TextBlock Text="{Binding WarmupSets}" Classes="mono" FontWeight="Bold" MinWidth="24"
                                                       TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Classes="step" Content="+" Command="{Binding MoreWarmupCommand}"
                                                    AutomationProperties.Name="More warm-up sets"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Working" FontSize="14" Classes="light" VerticalAlignment="Center"/>
                                    <Border BorderBrush="{DynamicResource Control}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="step" Content="−" Command="{Binding FewerWorkingCommand}"
                                                    AutomationProperties.Name="Fewer working sets"/>
                                            <TextBlock Text="{Binding WorkingSets}" Classes="mono" FontWeight="Bold" MinWidth="24"
                                                       TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Classes="step" Content="+" Command="{Binding MoreWorkingCommand}"
                                                    AutomationProperties.Name="More working sets"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Sets the rows you start with each time." FontSize="12" Foreground="{DynamicResource Faint}"
                                           VerticalAlignment="Center"/>
                            </WrapPanel>
                        </Border>

                        <!-- Bar exercises: type the total, or what goes on each side plus the bar -->
                        <!-- One compact row: the Total / Per side switch, and the bar's weight beside it in per side mode -->
                        <Border Padding="10,8" CornerRadius="12" Background="{DynamicResource Surface2}" IsVisible="{Binding UsesBar}">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Width="150" Padding="2" CornerRadius="9" Background="{DynamicResource Fill}" VerticalAlignment="Center">
                                        <v:SegmentedPill SelectedIndex="{Binding WeightModeIndex}" PillInset="0" PillCornerRadius="7">
                                            <Button Classes="seg" Classes.on="{Binding IsTotalMode}" MinHeight="30" Padding="0" FontSize="12"
                                                    CornerRadius="7" Content="Total" Command="{Binding SetTotalModeCommand}"/>
                                            <Button Classes="seg" Classes.on="{Binding IsPerSide}" MinHeight="30" Padding="0" FontSize="12"
                                                    CornerRadius="7" Content="Per side" Command="{Binding SetPerSideModeCommand}"/>
                                        </v:SegmentedPill>
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPerSide}">
                                        <TextBlock Text="Bar" FontSize="13" Classes="light" VerticalAlignment="Center"/>
                                        <TextBox TextInputOptions.ContentType="Number" Classes="field" Width="68" MinHeight="34" FontSize="14"
                                                 PlaceholderText="kg" Text="{Binding BarText}" AutomationProperties.Name="Bar weight in kg, optional"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding BarError}" Classes="error" FontSize="13"
                                           IsVisible="{Binding BarError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>

                        <!-- The sets -->
                        <StackPanel Spacing="4" Grid.IsSharedSizeScope="True">
                            <v:PhoneGrid ColumnDefinitions="32,190,*,*,40" ColumnSpacing="10" Margin="0,0,0,4" PhoneColumns="14,124,*,0.8*,44" PhoneColumnSpacing="8">
                                <TextBlock Text="SET" Classes="colHead wideOnly"/>
                                <TextBlock Text="#" Classes="colHead phoneOnly"/>
                                <TextBlock Grid.Column="1" Text="TYPE" Classes="colHead"/>
                                <TextBlock Grid.Column="2" Text="{Binding WeightHeader}" Classes="colHead"/>
                                <TextBlock Grid.Column="3" Text="REPS" Classes="colHead"/>
                            </v:PhoneGrid>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SetRowViewModel">
                                        <Border BorderBrush="{DynamicResource Fill}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <StackPanel Spacing="6">
                                                <v:PhoneGrid ColumnDefinitions="32,190,*,*,40" ColumnSpacing="10" PhoneColumns="14,124,*,0.8*,44" PhoneColumnSpacing="8">
                                                    <TextBlock Text="{Binding Number}" Classes="mono soft" FontSize="14" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Padding="3" CornerRadius="10" Background="{DynamicResource Fill}">
                                                        <v:SegmentedPill SelectedIndex="{Binding KindIndex}" PillInset="0" PillCornerRadius="8">
                                                            <Button Classes="seg" Classes.on="{Binding IsWarmup}" MinHeight="36" Padding="0"
                                                                    CornerRadius="8" Content="Warm-up" Command="{Binding SetWarmupCommand}"/>
                                                            <Button Classes="seg" Classes.on="{Binding IsWorking}" MinHeight="36" Padding="0"
                                                                    CornerRadius="8" Content="Working" Command="{Binding SetWorkingCommand}"/>
                                                        </v:SegmentedPill>
                                                    </Border>
                                                    <TextBox TextInputOptions.ContentType="Number" Grid.Column="2" Classes="field" Classes.pr="{Binding IsNewPr}"
                                                             PlaceholderText="{Binding WeightPlaceholder}" Text="{Binding WeightText}"
                                                             AutomationProperties.Name="{Binding Number, StringFormat='Set {0} weight in kg'}"/>
                                                    <TextBox TextInputOptions.ContentType="Digits" Grid.Column="3" Classes="field" Classes.pr="{Binding IsNewPr}"
                                                             PlaceholderText="{Binding RepsPlaceholder}" Text="{Binding RepsText}"
                                                             AutomationProperties.Name="{Binding Number, StringFormat='Set {0} reps'}"/>
                                                    <Button Grid.Column="4" Classes="btn outline" Width="40" Height="40" MinHeight="40" Padding="0"
                                                            BorderBrush="{DynamicResource Line2}" Foreground="{DynamicResource Muted}" Command="{Binding RemoveCommand}"
                                                            ToolTip.Tip="Remove set" VerticalAlignment="Center"
                                                            AutomationProperties.Name="{Binding Number, StringFormat='Remove set {0}'}">
                                                        <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.6" Width="14" Height="14"/>
                                                    </Button>
                                                </v:PhoneGrid>
                                                <!-- Per side: what the row adds up to, under the weight -->
                                                <TextBlock FontSize="12" Classes="muted totalHint" IsVisible="{Binding HasTotalHint}">
                                                    <Run Text="="/>
                                                    <Run Text="{Binding TotalHint}" FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                                         Foreground="{DynamicResource AccentInk}"/>
                                                    <Run Text="total"/>
                                                    <Run Text="{Binding TotalDetail}" Foreground="{DynamicResource Faint}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{Binding Error}" Classes="error" FontSize="13"
                                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- Phones (the canvas): Add set and Save sets side by side across the card -->
                        <Grid Classes="phoneOnly" ColumnDefinitions="*,1.3*" ColumnSpacing="8">
                            <Panel>
                                <Rectangle Stroke="{DynamicResource Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="12" RadiusY="12"/>
                                <Button Classes="btn" Background="Transparent" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"
                                        MinHeight="50" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding AddRowCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <v:Icon Data="{StaticResource IcPlus}" StrokeThickness="2.6" Width="15" Height="15"/>
                                        <TextBlock Text="Add set" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Panel>
                            <Button Grid.Column="1" Classes="btn primary" MinHeight="50" FontSize="15" CornerRadius="12"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="Save sets" Command="{Binding SaveCommand}"/>
                        </Grid>
                        <Grid Classes="wideOnly" ColumnDefinitions="Auto,*,Auto">
                            <Panel>
                                <Rectangle Stroke="{DynamicResource ControlHover}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="10" RadiusY="10"/>
                                <Button Classes="btn" Background="Transparent" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" Padding="16,0"
                                        Command="{Binding AddRowCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <v:Icon Data="{StaticResource IcPlus}" StrokeThickness="2.6" Width="15" Height="15"/>
                                        <TextBlock Text="Add set" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Panel>
                            <Button Grid.Column="2" Classes="btn primary" MinHeight="48" Padding="26,0" FontSize="15"
                                    Content="Save sets" Command="{Binding SaveCommand}"/>
                        </Grid>
                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <v:Icon Data="{StaticResource IcInfo}" Stroke="{DynamicResource Muted}" Width="16" Height="16"
                                        VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <TextBlock Grid.Column="1" FontSize="12" Classes="muted" LineHeight="18"
                                           Text="Saving sets does not count as going to the gym. Use “I went today” on the Dashboard for that."/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="RightColumn" Spacing="24">
                    <!-- ===== Personal record ===== -->
                    <Border Classes="card prCard" Classes.fresh="{Binding IsPrFresh}">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="PERSONAL RECORD" FontSize="12" FontWeight="Bold" LetterSpacing="1.4" Classes="muted"/>
                                <TextBlock Grid.Column="1" Text="{Binding PrDateText}" FontSize="12" Classes="muted" IsVisible="{Binding HasPr}"/>
                            </Grid>
                            <!-- Phones (the canvas): the weight big in lime, kg over × reps beside it, the 1RM in a chip -->
                            <Panel Classes="phoneOnly">
                            <StackPanel Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding HasPr}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PrWeight}" FontSize="76" FontWeight="Black" LetterSpacing="-3"
                                               Foreground="{DynamicResource AccentInk}" Margin="0,-10,0,-12" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="kg" FontSize="22" FontWeight="ExtraBold"/>
                                        <TextBlock><Run Text="× " FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource Faint}"/><Run
                                                   Text="{Binding PrReps}" FontSize="24" FontWeight="ExtraBold"/><Run Text=" reps" FontSize="13"
                                                   Foreground="{DynamicResource Muted}"/></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <Border HorizontalAlignment="Center" Padding="12,5" CornerRadius="999" Background="{DynamicResource Fill}">
                                    <TextBlock FontSize="13" Classes="soft">
                                        <Run Text="Estimated 1RM ≈ "/><Run Text="{Binding PrOneRm}" FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                             Foreground="{DynamicResource Ink}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            </Panel>
                            <Panel Classes="wideOnly">
                            <StackPanel Spacing="6" IsVisible="{Binding HasPr}">
                                <TextBlock>
                                    <Run Text="{Binding PrWeight}" FontSize="48" FontWeight="ExtraBold"/><Run Text=" kg" FontSize="20"
                                         FontWeight="ExtraBold" Foreground="{DynamicResource Soft}"/><Run Text=" × " FontSize="28"
                                         FontWeight="ExtraBold" Foreground="{DynamicResource Faint}"/><Run Text="{Binding PrReps}" FontSize="48" FontWeight="ExtraBold"/>
                                </TextBlock>
                                <TextBlock FontSize="13" Classes="muted">
                                    <Run Text="Estimated 1RM ≈ "/><Run Text="{Binding PrOneRm}" FontFamily="{StaticResource Mono}"
                                         Foreground="{DynamicResource Light}"/>
                                </TextBlock>
                            </StackPanel>
                            </Panel>
                            <StackPanel Spacing="6" IsVisible="{Binding !HasPr}">
                                <TextBlock Text="No PR yet" FontSize="40" FontWeight="ExtraBold"/>
                                <TextBlock Text="Your first working set sets it." FontSize="13" Classes="muted"/>
                            </StackPanel>

                            <!-- Edit the PR -->
                            <Border Padding="14" CornerRadius="12" Background="{DynamicResource Surface2}" IsVisible="{Binding IsEditingPr}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Weight (kg)" FontSize="12" Classes="muted"/>
                                            <TextBox TextInputOptions.ContentType="Number" Classes="field" Text="{Binding PrWeightText}"/>
                                            <TextBlock Classes="fieldError" Text="{Binding PrWeightError}"
                                                       IsVisible="{Binding PrWeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Reps" FontSize="12" Classes="muted"/>
                                            <TextBox TextInputOptions.ContentType="Digits" Classes="field" Text="{Binding PrRepsText}"/>
                                            <TextBlock Classes="fieldError" Text="{Binding PrRepsError}"
                                                       IsVisible="{Binding PrRepsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="1RM (optional)" FontSize="12" Classes="muted"/>
                                            <TextBox TextInputOptions.ContentType="Number" Classes="field" PlaceholderText="auto" Text="{Binding PrOneRmInput}"/>
                                            <TextBlock Classes="fieldError" Text="{Binding PrOneRmError}"
                                                       IsVisible="{Binding PrOneRmError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock FontSize="12" Classes="muted" LineHeight="18"
                                               Text="Use this if a PR was logged wrong or set before you used GainStreak. It applies from today. Leave the 1RM empty to estimate it."/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="btn light small" MinHeight="40" Content="Save PR" Command="{Binding SavePrCommand}"/>
                                        <Button Classes="btn outline small" MinHeight="40" Content="Cancel" Command="{Binding CancelEditPrCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditingPr}">
                                <Button Classes="btn outline small" MinHeight="40" Command="{Binding StartEditPrCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <v:Icon Data="{StaticResource IcPencil}" StrokeThickness="2.2" Width="14" Height="14"/>
                                        <TextBlock Text="Edit PR" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- An edited PR can be taken back, which brings back the one from your sets -->
                                <Button Classes="btn outline small" MinHeight="40" Command="{Binding UndoPrEditCommand}"
                                        IsVisible="{Binding CanUndoPrEdit}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <v:Icon Data="{StaticResource IcMadeUp}" StrokeThickness="2.2" Width="14" Height="14"/>
                                        <TextBlock Text="Undo edit" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== Last time ===== -->
                    <Border Classes="card" IsVisible="{Binding HasLast}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Last time" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding LastDateText}" FontSize="13" Classes="muted" VerticalAlignment="Bottom"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding LastSets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LastSetRow">
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" MinHeight="40">
                                            <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Number}" Classes="mono" FontSize="14" Foreground="{DynamicResource Faint}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="14" Foreground="{DynamicResource Ink}"
                                                           Classes.warm="{Binding IsWarmup}">
                                                    <TextBlock.Styles>
                                                        <Style Selector="TextBlock.warm"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
                                                    </TextBlock.Styles>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Set}" Classes="mono" FontSize="14" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== Top set per session (phones show it at the top) ===== -->
                    <ContentControl Classes="wideOnly" Classes.off="{Binding !HasTopSets}" Content="{Binding}"
                                    ContentTemplate="{StaticResource TopSetsCard}"/>

                    <!-- First time -->
                    <Panel IsVisible="{Binding !HasLast}">
                        <Rectangle Stroke="{DynamicResource Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="20" RadiusY="20"/>
                        <StackPanel Spacing="6" Margin="24">
                            <TextBlock Text="First time doing this one" FontSize="15" FontWeight="Bold"/>
                            <TextBlock FontSize="13" Classes="muted" LineHeight="20"
                                       Text="After you save today's sets, they show here next time as placeholders, and “Fill from last time” copies them."/>
                        </StackPanel>
                    </Panel>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
