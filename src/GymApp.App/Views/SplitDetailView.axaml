<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.SplitDetailView"
             x:DataType="vm:SplitDetailViewModel">
    <!-- After the "Gym App" design canvas (SplitDetail artboard): set up the split (days per week, first workout day)
         with a live preview of the week on the left, what the split is about on the right. Below 880 px the right
         column goes under the left (SplitDetailView.axaml.cs). -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.step">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="1.4"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>

        <!-- The use button fades from lime to grey when it becomes "In use"; right after a save the check pops in -->
        <Style Selector="Button.use /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.use.inUse:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
        </Style>
        <Style Selector="Button.use.inUse">
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <Style Selector="Button.use.justSaved v|Icon.useCheck">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Style.Animations>
                <Animation Duration="0:0:0.35" Easing="BackEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Days per week cards -->
        <Style Selector="Button.variant">
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.variant:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.variant.on">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.variant.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
        </Style>

        <!-- Week preview tiles -->
        <Style Selector="Panel.wk">
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style Selector="Border.wkTile">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="4,10"/>
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Border.wkTile.start">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.wkTile.rest">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Faint}"/>
        </Style>

        <!-- Two columns by default; stacked when narrow -->
        <Style Selector="StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#LeftColumn">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
    </UserControl.Styles>
    <DockPanel Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
        <v:Sidebar Current="Splits"/>

        <ScrollViewer>
        <StackPanel Classes="page" Spacing="24">
            <!-- Header -->
            <StackPanel Spacing="14">
                <Button Classes="btn outline" MinHeight="40" Padding="10,0,14,0" FontSize="14" HorizontalAlignment="Left"
                        Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <v:Icon Data="{StaticResource IcBack}" StrokeThickness="2.2" Width="16" Height="16"/>
                        <TextBlock Text="All splits" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding Name}" FontSize="40" FontWeight="ExtraBold"/>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <Border Classes="pill" BorderBrush="{DynamicResource ControlHover}" Padding="11,4" IsVisible="{Binding IsRecommended}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Path Data="{StaticResource IcStar}" Fill="{DynamicResource Ink}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Recommended" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="pill" BorderThickness="0" Background="{DynamicResource Accent}" Padding="11,4" IsVisible="{Binding IsActive}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <v:Icon Data="{StaticResource IcCheck}" Stroke="Black" StrokeThickness="3" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Your active split" FontSize="12" FontWeight="Bold" Foreground="Black"/>
                            </StackPanel>
                        </Border>
                        <!-- Presets: the days per week they're built for (the default variant); custom splits: their scheduled days -->
                        <Border Classes="pill" BorderThickness="0" Background="{DynamicResource Fill2}" Padding="11,4"
                                IsVisible="{Binding RecommendedDaysTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <v:Icon Data="{StaticResource IcCalendar}" StrokeThickness="2.4" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RecommendedDaysTag}" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="pill" BorderThickness="0" Background="{DynamicResource Fill2}" Padding="11,4" IsVisible="{Binding !IsPreset}">
                            <TextBlock Text="{Binding DaysTag}" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                        </Border>
                        <Border Classes="pill" BorderThickness="0" Background="{DynamicResource Fill2}" Padding="11,4" IsVisible="{Binding !IsPreset}">
                            <TextBlock Text="Custom" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>

            <!-- Saved -->
            <Border Padding="18,14" CornerRadius="14" BorderBrush="{DynamicResource LimeTintLine}" BorderThickness="1" Background="{DynamicResource LimeTint}"
                    IsVisible="{Binding Toast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.8" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Toast}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Grid x:Name="Columns" ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="24">

                <!-- ===== Set up this split ===== -->
                <StackPanel x:Name="LeftColumn" Spacing="24">
                <Border x:Name="SetupCard" Classes="card" Padding="28">
                    <StackPanel Spacing="26">
                        <!-- 1 · Days per week (presets with more than one layout) -->
                        <StackPanel Spacing="10" IsVisible="{Binding HasVariants}">
                            <TextBlock Text="1 · DAYS PER WEEK" Classes="step"/>
                            <ItemsControl ItemsSource="{Binding VariantOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VariantOptionViewModel">
                                        <Button Classes="variant" Classes.on="{Binding IsSelected}" Command="{Binding PickCommand}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Days}" FontSize="20" FontWeight="ExtraBold"/>
                                                <TextBlock Text="days / week" FontSize="12" Opacity="0.8"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Rotation -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding RotationStepLabel}" Classes="step"/>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <ItemsControl ItemsSource="{Binding RotationSteps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RotationStep">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="pill" Padding="14,8">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"/>
                                                </Border>
                                                <v:Icon Data="{StaticResource IcArrowRight}" Stroke="{DynamicResource Faint}" StrokeThickness="2.4"
                                                        Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding HasArrow}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <v:Icon Data="{StaticResource IcMadeUp}" Stroke="{DynamicResource Faint}" StrokeThickness="2.4" Width="16" Height="16"
                                        VerticalAlignment="Center" ToolTip.Tip="Repeats"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- First workout day (presets; custom splits fix their weekdays) -->
                        <StackPanel Spacing="10" IsVisible="{Binding IsPreset}">
                            <TextBlock Text="{Binding StartStepLabel}" Classes="step"/>
                            <Border Padding="4" CornerRadius="12" Background="{DynamicResource Fill}">
                                <ItemsControl ItemsSource="{Binding StartDayOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <v:SegmentedPill SelectedIndex="{Binding StartDayIndex}" PillInset="0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StartDayOptionViewModel">
                                            <Button Classes="seg" Classes.on="{Binding IsSelected}" MinHeight="40" Padding="0"
                                                    FontWeight="Bold" Content="{Binding Label}" Command="{Binding PickCommand}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- Your week -->
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="YOUR WEEK" Classes="step" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Column="1" FontSize="13" Classes="soft">
                                    <Run Text="{Binding TrainCount}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Ink}"/><Run
                                         Text=" training · "/><Run Text="{Binding RestCount}" FontFamily="{StaticResource Mono}"
                                         Foreground="{DynamicResource Ink}"/><Run Text=" rest"/>
                                </TextBlock>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Cells}" Margin="-4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScheduleCell">
                                        <Panel Classes="wk">
                                            <!-- Rest days: a dashed outline (Border can't dash) -->
                                            <Rectangle Stroke="{DynamicResource Line2}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="14" RadiusY="14"
                                                       IsVisible="{Binding !IsTraining}"/>
                                            <Border Classes="wkTile" Classes.rest="{Binding !IsTraining}"
                                                    Classes.start="{Binding IsTrainingStart}">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" Opacity="0.8"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="ExtraBold" TextAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                                                IsVisible="{Binding IsStart}">
                                                        <Path Data="{StaticResource IcPlay}" Fill="{DynamicResource AccentInk}" Width="9" Height="9"
                                                              Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Start" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentInk}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Rest days count toward your streak." FontSize="12" Classes="muted"/>
                        </StackPanel>

                        <!-- Use -->
                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <TextBlock Text="{Binding FootNote}" FontSize="13" Classes="muted" LineHeight="20" MaxWidth="380"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="btn outline" MinHeight="48" Content="Edit split"
                                        Command="{Binding EditCommand}" IsVisible="{Binding !IsPreset}"/>
                                <!-- "Use this split" / "Save" until saved, then a greyed "In use" with a check -->
                                <Button Grid.Column="2" Classes="btn primary use" Classes.inUse="{Binding IsInUse}"
                                        Classes.justSaved="{Binding JustSaved}" MinHeight="48" Padding="24,0" FontSize="15"
                                        Command="{Binding UseCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <v:Icon Classes="useCheck" Data="{StaticResource IcCheck}" StrokeThickness="2.6" Width="14" Height="14"
                                                Stroke="{DynamicResource AccentInk}" VerticalAlignment="Center" IsVisible="{Binding IsInUse}"/>
                                        <TextBlock Text="{Binding UseLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Who uses it: share of lifters per split (small ones grouped into Other) ===== -->
                <Border Classes="card" IsVisible="{Binding HasUsage}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Who uses it" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding UsageHeadline}" FontSize="14" Classes="light" LineHeight="22"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="40">
                            <Panel Width="232" Height="232" VerticalAlignment="Center">
                                <v:Donut Slices="{Binding UsageSlices}"/>
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MinePercent}" FontFamily="{StaticResource Mono}" FontSize="40" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="of lifters" FontSize="13" Classes="muted" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Panel>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding UsageSlices}" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SplitUsageSlice">
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" MinHeight="48" Padding="0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <v:DonutSwatch Tone="{Binding Tone}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Classes.soft="{Binding !IsThis}"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Classes="muted" IsVisible="{Binding HasDetail}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontFamily="{StaticResource Mono}" FontSize="15"
                                                           FontWeight="Bold" VerticalAlignment="Center" Classes.soft="{Binding !IsThis}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <TextBlock Text="{Binding UsageNote}" FontSize="12" Foreground="{DynamicResource Faint}"/>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- ===== About ===== -->
                <StackPanel x:Name="RightColumn" Spacing="24">
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="About this split" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding About}" FontSize="14" Classes="light" LineHeight="22"
                                       IsVisible="{Binding About, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <ItemsControl ItemsSource="{Binding DayInfo}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SplitDayInfo">
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" MinHeight="44" Padding="0,8">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Muscles}" FontSize="14" Classes="muted" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Muscles come from the exercises you've added to each day." FontSize="12" Foreground="{DynamicResource Faint}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" IsVisible="{Binding HasGoodFor}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Good for" FontSize="20" FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding GoodFor}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.6"
                                                    Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="14" Classes="light" LineHeight="20"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
