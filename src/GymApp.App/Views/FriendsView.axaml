<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">
    <!-- After the "Gym App" design canvas (Friends artboard): the leaderboard and your friends on the left, adding
         friends (with your sent requests) on the right (requests you get are in the inbox). Below 880 px of content the right column goes under the left. -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.avatar.you">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>
        <Style Selector="v|AvatarView.face">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="v|AvatarView.face.you">
            <Setter Property="Fallback" Value="{DynamicResource Accent}"/>
            <Setter Property="FallbackInk" Value="Black"/>
        </Style>
        <Style Selector="Border.boardRow">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.boardRow.you">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
        </Style>
        <Style Selector="TextBlock.rank"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
        <Style Selector="TextBlock.rank.first"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Style>
        <Style Selector="StackPanel.streak">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Faint}"/>
            <Setter Property="MinWidth" Value="52"/>
        </Style>
        <Style Selector="StackPanel.streak.lit"><Setter Property="TextElement.Foreground" Value="{DynamicResource Flame}"/></Style>
        <Style Selector="Border.listRow">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource RedTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RedTintLine}"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Two columns by default; FriendsView.axaml.cs stacks them when narrow -->
        <Style Selector="StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#LeftColumn">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <!-- Phones: the rows' narrower padding (PhoneGrid narrows their columns) -->
        <Style Selector=".phone Border.boardRow"><Setter Property="Padding" Value="10,0"/></Style>
        <!-- Phones (the canvas): the streak as a chip, a YOU tag, a search icon and a shorter hint in the search box -->
        <Style Selector=".phone Border.streakChip">
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector=".phone Border.streakChip StackPanel.streak"><Setter Property="MinWidth" Value="0"/></Style>
        <Style Selector="Border.youTag">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox#SearchBox"><Setter Property="PlaceholderText" Value="Username (at least 3 letters)"/></Style>
        <Style Selector=".phone TextBox#SearchBox"><Setter Property="PlaceholderText" Value="Add friend by username"/></Style>
    </UserControl.Styles>
    <DockPanel Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
        <v:Sidebar Current="Friends"/>
        <!-- Phones: the Friends tab holds the leaderboard and the map (the GainStreak Mobile canvas) -->
        <Border DockPanel.Dock="Top" Classes="friendsSwitch phoneOnly">
            <v:SegmentedPill SlideGroup="friendsTab" SelectedIndex="0" PillInset="0">
                <Button Classes="seg on" MinHeight="40" FontSize="14" ><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><v:Icon Data="{StaticResource IcTrophy}" Width="15" Height="15" VerticalAlignment="Center"/><TextBlock Text="Leaderboard" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Classes="seg" MinHeight="40" FontSize="14"  Command="{Binding OpenMapCommand}"><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><v:Icon Data="{StaticResource IcMap}" Width="15" Height="15" VerticalAlignment="Center"/><TextBlock Text="Map" VerticalAlignment="Center"/></StackPanel></Button>
            </v:SegmentedPill>
        </Border>

        <ScrollViewer>
        <StackPanel Classes="page" Spacing="24">
            <!-- Header -->
            <Grid Classes="pageHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                <TextBlock Classes="pageTitle" Text="Friends" FontWeight="ExtraBold"/>
                <!-- Beside the title on phones too (the canvas) -->
                <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding FriendCountText}" FontSize="13" VerticalAlignment="Top" Margin="0,12,0,0"/>
            </Grid>

            <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold"
                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding StaleNotice}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding StaleNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Grid x:Name="Columns" ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="24">
                <StackPanel x:Name="LeftColumn" Spacing="24">

                    <!-- Leaderboard -->
                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Leaderboard" Classes="h2"/>
                                    <TextBlock Text="{Binding PeriodText}" FontSize="13" Classes="muted"/>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="3" CornerRadius="10" Background="{DynamicResource Fill}" VerticalAlignment="Center">
                                    <v:SegmentedPill SelectedIndex="{Binding IsAllTime, Converter={x:Static v:SegmentedPill.BoolToIndex}}"
                                                     PillCornerRadius="8" PillInset="0">
                                        <Button Classes="seg" Classes.on="{Binding IsThisWeek}" CornerRadius="8" Content="This week"
                                                Command="{Binding ShowThisWeekCommand}"/>
                                        <Button Classes="seg" Classes.on="{Binding IsAllTime}" CornerRadius="8" Content="All time"
                                                Command="{Binding ShowAllTimeCommand}"/>
                                    </v:SegmentedPill>
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Board}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FriendsBoardRowViewModel">
                                        <Border Classes="boardRow" Classes.you="{Binding IsYou}">
                                            <v:PhoneGrid ColumnDefinitions="40,Auto,*,Auto,76" ColumnSpacing="14" VerticalAlignment="Center"
                                                         PhoneColumns="34,Auto,*,Auto,Auto" PhoneColumnSpacing="10">
                                                <Panel>
                                                    <TextBlock Text="{Binding RankText}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center"
                                                               Classes="rank wideOnly" Classes.first="{Binding IsFirst}" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding RankNumber}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" Classes="rank phoneOnly" Classes.first="{Binding IsFirst}" TextWrapping="NoWrap"/>
                                                </Panel>
                                                <v:AvatarView Grid.Column="1" Classes="face" Classes.you="{Binding IsYou}" Choice="{Binding Avatar}"
                                                              Initials="{Binding Initials}" Level="{Binding LevelNumber}"/>
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="Bold" Classes="wideOnly"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <Grid Classes="phoneOnly" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <Border Grid.Column="1" Classes="youTag" IsVisible="{Binding IsYou}">
                                                            <TextBlock Text="YOU" FontSize="10" FontWeight="ExtraBold" Foreground="Black"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding LevelText}" FontSize="12" Classes="muted"/>
                                                </StackPanel>
                                                <Border Grid.Column="3" Classes="streakChip" Classes.lit="{Binding HasStreak}" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                                ToolTip.Tip="Current streak"
                                                                Classes="streak" Classes.lit="{Binding HasStreak}">
                                                        <v:Icon Data="{StaticResource IcFlame}" StrokeThickness="2.2" Width="15" Height="15"/>
                                                        <TextBlock Text="{Binding StreakText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="{Binding PointsText}" Classes="mono wideOnly" FontSize="15" FontWeight="Bold"
                                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="4" Classes="phoneOnly" VerticalAlignment="Center" MinWidth="36">
                                                    <TextBlock Text="{Binding PointsNumber}" Classes="mono" FontSize="17" FontWeight="Bold"
                                                               HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="pts" FontSize="11" Classes="muted" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </v:PhoneGrid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Panel IsVisible="{Binding HasNoFriends}">
                                <Rectangle Stroke="{DynamicResource Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="14" RadiusY="14"/>
                                <StackPanel Spacing="6" Margin="22" HorizontalAlignment="Center">
                                    <TextBlock Text="Add friends to compete" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Search for a username to send a request." FontSize="13" Classes="muted" TextAlignment="Center"/>
                                </StackPanel>
                            </Panel>
                            <TextBlock Text="Ranked by points. Ties share a rank. The streak is shown, not used for ranking."
                                       FontSize="12" Foreground="{DynamicResource Faint}"/>
                        </StackPanel>
                    </Border>

                    <!-- Your friends (phones: moved under adding friends, FriendsView.axaml.cs) -->
                    <Border x:Name="YourFriends" Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Your friends" Classes="h2"/>
                            <TextBlock Text="No friends yet." FontSize="14" Classes="muted" IsVisible="{Binding HasNoFriends}"/>
                            <ItemsControl ItemsSource="{Binding Friends}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FriendRowViewModel">
                                        <Border Classes="listRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <v:AvatarView Classes="face" Choice="{Binding Avatar}" Initials="{Binding Initials}"
                                                              Level="{Binding LevelNumber}"/>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding SinceText}" FontSize="12" Classes="muted"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="link" FontSize="12" Foreground="{DynamicResource Muted}"
                                                        Content="Cancel" Command="{Binding CancelRemoveCommand}"
                                                        IsVisible="{Binding IsConfirmingRemove}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Classes="btn outline small" Foreground="{DynamicResource Soft}"
                                                        Classes.danger="{Binding IsConfirmingRemove}" Content="{Binding RemoveLabel}"
                                                        Command="{Binding RemoveCommand}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RightColumn" Spacing="24">

                    <!-- Add friend -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Add friend" Classes="h2 wideOnly"/>
                            <Grid Classes="phoneOnly" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Add friends" Classes="h2"/>
                                <TextBlock Grid.Column="1" Text="{Binding SentShortText}" Classes="mono muted" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBox x:Name="SearchBox" Classes="field" Text="{Binding Query}" AutomationProperties.Name="Username">
                                    <TextBox.InnerLeftContent>
                                        <v:Icon Classes="phoneOnly" Data="{StaticResource IcSearch}" Stroke="{DynamicResource Muted}"
                                                Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <Button Grid.Column="1" Classes="btn light" Content="Search" Command="{Binding SearchCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding SearchHint}" FontSize="12" Classes="error"
                                       IsVisible="{Binding SearchHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FoundUserViewModel">
                                        <Border Classes="listRow" MinHeight="52">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <Border Classes="avatar">
                                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Button Grid.Column="2" Classes="btn light small" Classes.primary="{Binding IsAccept}"
                                                        Content="{Binding ActionLabel}" Command="{Binding ActCommand}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Sent requests; the ones you get are in the inbox -->
                            <StackPanel Spacing="8" IsVisible="{Binding HasOutgoing}">
                                <TextBlock Text="SENT REQUESTS" Classes="mono muted" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <ItemsControl ItemsSource="{Binding Outgoing}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RequestRowViewModel">
                                            <Border Classes="listRow">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                    <Border Classes="avatar">
                                                        <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Classes="muted"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="btn outline small" Foreground="{DynamicResource Soft}"
                                                            Content="Cancel" Command="{Binding CancelCommand}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="{Binding SentCountText}" FontSize="12" Foreground="{DynamicResource Faint}" Classes="wideOnly"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
