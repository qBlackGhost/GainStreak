<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">
    <!-- After the "Gym App" design canvas (Friends artboard): the leaderboard and your friends on the left, adding
         friends (with your sent requests) on the right (requests you get are in the inbox). Below 880 px of content the right column goes under the left. -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.avatar.you">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>
        <!-- A whole row as a button (Phase 25e): no button look of its own, a light press -->
        <Style Selector="Button.rowTap">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.rowTap:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rowTap:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.rowTap:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.rowTap:pressed"><Setter Property="Opacity" Value="0.75"/></Style>
        <Style Selector="v|AvatarView.face">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="v|AvatarView.face.you">
            <Setter Property="Fallback" Value="{DynamicResource Accent}"/>
            <Setter Property="FallbackInk" Value="Black"/>
        </Style>
        <Style Selector="Border.boardRow">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.boardRow.you">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
        </Style>
        <Style Selector="TextBlock.rank"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
        <Style Selector="TextBlock.rank.first"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Style>
        <Style Selector="StackPanel.streak">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Faint}"/>
            <Setter Property="MinWidth" Value="52"/>
        </Style>
        <Style Selector="StackPanel.streak.lit"><Setter Property="TextElement.Foreground" Value="{DynamicResource Flame}"/></Style>
        <Style Selector="Border.listRow">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource RedTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RedTintLine}"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Two columns by default; FriendsView.axaml.cs stacks them when narrow -->
        <Style Selector="StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#LeftColumn">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid.stack StackPanel#RightColumn">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <!-- Phones: the rows' narrower padding (PhoneGrid narrows their columns) -->
        <Style Selector=".phone Border.boardRow"><Setter Property="Padding" Value="10,0"/></Style>
        <!-- Phones (the canvas): the streak as a chip, a YOU tag, a search icon and a shorter hint in the search box -->
        <Style Selector=".phone Border.streakChip">
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector=".phone Border.streakChip StackPanel.streak"><Setter Property="MinWidth" Value="0"/></Style>
        <Style Selector=".phone Border.streakChip.none"><Setter Property="IsVisible" Value="False"/></Style>
        <Style Selector="Border.youTag">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox#SearchBox"><Setter Property="PlaceholderText" Value="Username (at least 3 letters)"/></Style>
        <Style Selector=".phone TextBox#SearchBox"><Setter Property="PlaceholderText" Value="Add friend by username"/></Style>
        <!-- Phase 21: "Show my QR code" in Add friends, and the invite card's message icon -->
        <Style Selector="Button.qrRow">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource LimeTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LimeTintLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.qrRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LimeTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LimeTintLineStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Border.inviteIcon">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Soft}"/>
        </Style>
        <Style Selector="Border.inviteIcon.good">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>
    </UserControl.Styles>
    <Grid>
    <DockPanel Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
        <v:Sidebar Current="Friends"/>
        <!-- Phones: the Friends tab holds the leaderboard and the map (the GainStreak Mobile canvas) -->
        <Border DockPanel.Dock="Top" Classes="friendsSwitch phoneOnly">
            <v:SegmentedPill SlideGroup="friendsTab" SelectedIndex="0" PillInset="0">
                <Button Classes="seg on" MinHeight="40" FontSize="14" ><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><v:Icon Data="{StaticResource IcTrophy}" Width="15" Height="15" VerticalAlignment="Center"/><TextBlock Text="Leaderboard" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Classes="seg" MinHeight="40" FontSize="14"  Command="{Binding OpenMapCommand}"><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><v:Icon Data="{StaticResource IcMap}" Width="15" Height="15" VerticalAlignment="Center"/><TextBlock Text="Map" VerticalAlignment="Center"/></StackPanel></Button>
            </v:SegmentedPill>
        </Border>

        <ScrollViewer>
        <StackPanel Classes="page" Spacing="24">
            <!-- Header -->
            <Grid Classes="pageHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                <TextBlock Classes="pageTitle" Text="Friends" FontWeight="ExtraBold"/>
                <!-- Beside the title on phones too (the canvas) -->
                <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding FriendCountText}" FontSize="13" VerticalAlignment="Top" Margin="0,12,0,0"/>
            </Grid>

            <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold"
                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding StaleNotice}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding StaleNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- A friend invite from a scanned QR code or an opened link (Phase 21, the canvas's Friends · Invite from a QR code) -->
            <Border Padding="14" CornerRadius="18" Background="{DynamicResource LimeTint}" BorderBrush="{DynamicResource LimeTintLine}"
                    BorderThickness="1" IsVisible="{Binding HasInvite}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <v:Icon Data="{StaticResource IcQr}" Width="14" Height="14" StrokeThickness="2.2" Stroke="{DynamicResource AccentInk}" VerticalAlignment="Center"/>
                        <TextBlock Text="FRIEND INVITE" FontSize="11" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" MinHeight="44" IsVisible="{Binding IsInviteChecking}">
                        <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center"/>
                        <TextBlock Text="Checking the invite…" FontSize="14" Classes="soft" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsInviteAsk}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Classes="avatar" Width="48" Height="48" CornerRadius="24">
                                <TextBlock Text="{Binding InviterInitials}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock FontSize="16">
                                    <Run Text="{Binding InviterName}" FontWeight="Bold"/>
                                    <Run Text="wants to be your friend"/>
                                </TextBlock>
                                <TextBlock Text="Accept and you'll see each other on the leaderboard." FontSize="12" Classes="muted"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Classes="btn outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="46"
                                    Content="Not now" Command="{Binding DismissInviteCommand}"/>
                            <Button Grid.Column="1" Classes="btn primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="46"
                                    Content="Accept" Command="{Binding AcceptInviteCommand}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsInviteMessage}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Classes="avatar inviteIcon" Classes.good="{Binding IsInviteGood}">
                                <v:Icon Data="{Binding InviteIcon, Converter={x:Static v:FriendsView.IconFor}}" Width="20" Height="20" StrokeThickness="2.2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding InviteMessage}" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Classes="btn" Classes.light="{Binding !CanRetryInvite}" Classes.outline="{Binding CanRetryInvite}"
                                    Grid.ColumnSpan="{Binding CanRetryInvite, Converter={x:Static v:FriendQrSheet.SpanWhen}}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="46"
                                    Content="{Binding InviteOkLabel}" Command="{Binding DismissInviteCommand}"/>
                            <Button Grid.Column="1" Classes="btn light" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="46"
                                    Content="Try again" Command="{Binding RetryInviteCommand}" IsVisible="{Binding CanRetryInvite}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- "Know when friends add you" (Phase 22, the canvas's Friends · Turn on notifications) -->
            <Border Padding="14" CornerRadius="18" Background="{DynamicResource LimeTint}" BorderBrush="{DynamicResource LimeTintLine}"
                    BorderThickness="1" IsVisible="{Binding Push.IsVisible}">
                <StackPanel Spacing="12" DataContext="{Binding Push}" x:DataType="vm:FriendPushCardViewModel">
                    <StackPanel Spacing="12" IsVisible="{Binding IsAsk}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Classes="avatar inviteIcon good">
                                <v:Icon Data="{StaticResource IcBell}" Width="20" Height="20" StrokeThickness="2.2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Know when friends add you" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="Get a notification when someone sends you a request or accepts yours." FontSize="13"
                                           Classes="soft" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Classes="btn outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="46"
                                    Content="Not now" Command="{Binding NotNowCommand}"/>
                            <Button Grid.Column="1" Classes="btn primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="46"
                                    Content="Turn on" Command="{Binding TurnOnCommand}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="12" IsVisible="{Binding IsMessage}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Classes="avatar inviteIcon" Classes.good="{Binding IsGood}">
                                <v:Icon Data="{Binding Icon, Converter={x:Static v:FriendsView.IconFor}}" Width="20" Height="20" StrokeThickness="2.2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Classes="btn light" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="46"
                                Content="{Binding OkLabel}" Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid x:Name="Columns" ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="24">
                <StackPanel x:Name="LeftColumn" Spacing="24">

                    <!-- Leaderboard -->
                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Leaderboard" Classes="h2"/>
                                    <TextBlock Text="{Binding PeriodText}" FontSize="13" Classes="muted"/>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="3" CornerRadius="10" Background="{DynamicResource Fill}" VerticalAlignment="Center">
                                    <v:SegmentedPill SelectedIndex="{Binding IsAllTime, Converter={x:Static v:SegmentedPill.BoolToIndex}}"
                                                     PillCornerRadius="8" PillInset="0">
                                        <Button Classes="seg" Classes.on="{Binding IsThisWeek}" CornerRadius="8" Content="This week"
                                                Command="{Binding ShowThisWeekCommand}"/>
                                        <Button Classes="seg" Classes.on="{Binding IsAllTime}" CornerRadius="8" Content="All time"
                                                Command="{Binding ShowAllTimeCommand}"/>
                                    </v:SegmentedPill>
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Board}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FriendsBoardRowViewModel">
                                        <Button Classes="rowTap" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                                        <Border Classes="boardRow" Classes.you="{Binding IsYou}">
                                            <v:PhoneGrid ColumnDefinitions="40,Auto,*,Auto,76" ColumnSpacing="14" VerticalAlignment="Center"
                                                         PhoneColumns="24,Auto,*,Auto,Auto" PhoneColumnSpacing="10">
                                                <Panel>
                                                    <TextBlock Text="{Binding RankText}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center"
                                                               Classes="rank wideOnly" Classes.first="{Binding IsFirst}" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding RankNumber}" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" Classes="rank phoneOnly" Classes.first="{Binding IsFirst}" TextWrapping="NoWrap"/>
                                                </Panel>
                                                <v:AvatarView Grid.Column="1" Classes="face" Classes.you="{Binding IsYou}" Choice="{Binding Avatar}"
                                                              Initials="{Binding Initials}" Level="{Binding LevelNumber}"/>
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="Bold" Classes="wideOnly"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <!-- The badge follows a short name; a long one is cut with "…" -->
                                                    <v:NameBadgeRow Classes="phoneOnly" Spacing="6">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <!-- The featured badge after the name (Phase 25e) -->
                                                        <v:BadgeView Width="22" Height="22" VerticalAlignment="Center" IsVisible="{Binding HasFeatured}"
                                                                     Glyph="{Binding Featured.Glyph}" Text="{Binding Featured.Text}" Look="{Binding Featured.Look}"/>
                                                    </v:NameBadgeRow>
                                                    <TextBlock Text="{Binding LevelText}" FontSize="12" Classes="muted wideOnly"/>
                                                    <!-- Phones: the YOU tag on this line, so a long name can't push it into the streak -->
                                                    <Grid Classes="phoneOnly" ColumnDefinitions="Auto,*">
                                                        <Border Classes="youTag" Margin="0,0,6,0" IsVisible="{Binding IsYou}">
                                                            <TextBlock Text="YOU" FontSize="10" FontWeight="ExtraBold" Foreground="Black"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="12" Classes="muted"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="3" Classes="streakChip" Classes.lit="{Binding HasStreak}" Classes.none="{Binding !HasStreak}" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                                ToolTip.Tip="Current streak"
                                                                Classes="streak" Classes.lit="{Binding HasStreak}">
                                                        <v:Icon Data="{StaticResource IcFlame}" StrokeThickness="2.2" Width="15" Height="15"/>
                                                        <TextBlock Text="{Binding StreakText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="{Binding PointsText}" Classes="mono wideOnly" FontSize="15" FontWeight="Bold"
                                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="4" Classes="phoneOnly" VerticalAlignment="Center" MinWidth="36">
                                                    <TextBlock Text="{Binding PointsNumber}" Classes="mono" FontSize="17" FontWeight="Bold"
                                                               HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="pts" FontSize="11" Classes="muted" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </v:PhoneGrid>
                                        </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Panel IsVisible="{Binding HasNoFriends}">
                                <Rectangle Stroke="{DynamicResource Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="14" RadiusY="14"/>
                                <StackPanel Spacing="6" Margin="22" HorizontalAlignment="Center">
                                    <TextBlock Text="Add friends to compete" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Search for a username to send a request." FontSize="13" Classes="muted" TextAlignment="Center"/>
                                </StackPanel>
                            </Panel>
                            <TextBlock Text="Ranked by points. Ties share a rank. The streak is shown, not used for ranking."
                                       FontSize="12" Foreground="{DynamicResource Faint}"/>
                        </StackPanel>
                    </Border>

                    <!-- Your friends (phones: moved under adding friends, FriendsView.axaml.cs) -->
                    <Border x:Name="YourFriends" Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Your friends" Classes="h2"/>
                            <TextBlock Text="No friends yet." FontSize="14" Classes="muted" IsVisible="{Binding HasNoFriends}"/>
                            <ItemsControl ItemsSource="{Binding Friends}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FriendRowViewModel">
                                        <Border Classes="listRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <v:AvatarView Classes="face" Choice="{Binding Avatar}" Initials="{Binding Initials}"
                                                              Level="{Binding LevelNumber}"/>
                                                <!-- Phones: the name opens their badges (Phase 25e) -->
                                                <Button Grid.Column="1" Classes="rowTap" Command="{Binding OpenBadgesCommand}"
                                                        VerticalAlignment="Center" AutomationProperties.Name="{Binding Username}">
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <v:NameBadgeRow Spacing="6">
                                                        <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <v:BadgeView Width="20" Height="20" VerticalAlignment="Center" IsVisible="{Binding HasFeatured}"
                                                                     Glyph="{Binding Featured.Glyph}" Text="{Binding Featured.Text}" Look="{Binding Featured.Look}"/>
                                                    </v:NameBadgeRow>
                                                    <TextBlock Text="{Binding SinceText}" FontSize="12" Classes="muted"/>
                                                </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Classes="link" FontSize="12" Foreground="{DynamicResource Muted}"
                                                        Content="Cancel" Command="{Binding CancelRemoveCommand}"
                                                        IsVisible="{Binding IsConfirmingRemove}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Classes="btn outline small" Foreground="{DynamicResource Soft}"
                                                        Classes.danger="{Binding IsConfirmingRemove}" Content="{Binding RemoveLabel}"
                                                        Command="{Binding RemoveCommand}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="4" Classes="icon" Command="{Binding ReportCommand}" VerticalAlignment="Center"
                                                        ToolTip.Tip="Report or block" AutomationProperties.Name="Report or block">
                                                    <v:Icon Data="{StaticResource IcFlag}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RightColumn" Spacing="24">

                    <!-- Add friend -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Add friend" Classes="h2 wideOnly"/>
                            <Grid Classes="phoneOnly" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Add friends" Classes="h2"/>
                                <TextBlock Grid.Column="1" Text="{Binding SentShortText}" Classes="mono muted" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBox x:Name="SearchBox" Classes="field" Text="{Binding Query}" AutomationProperties.Name="Username">
                                    <TextBox.InnerLeftContent>
                                        <v:Icon Classes="phoneOnly" Data="{StaticResource IcSearch}" Stroke="{DynamicResource Muted}"
                                                Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <Button Grid.Column="1" Classes="btn light" Content="Search" Command="{Binding SearchCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding SearchHint}" FontSize="12" Classes="error"
                                       IsVisible="{Binding SearchHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <!-- Phase 21: your QR code and link -->
                            <Button Classes="qrRow" Command="{Binding ShowQrCommand}" AutomationProperties.Name="Show my QR code">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                                        <v:Icon Data="{StaticResource IcQr}" Width="20" Height="20" Stroke="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Show my QR code" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="Friends scan it to add you, or send them the link." FontSize="12" Classes="muted"/>
                                    </StackPanel>
                                    <v:Icon Grid.Column="2" Data="{StaticResource IcChevronRight}" Width="18" Height="18" StrokeThickness="2.2"
                                            Stroke="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FoundUserViewModel">
                                        <Border Classes="listRow" MinHeight="52">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <Border Classes="avatar">
                                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Button Grid.Column="3" Classes="icon" Command="{Binding ReportCommand}" VerticalAlignment="Center"
                                                        ToolTip.Tip="Report or block" AutomationProperties.Name="Report or block">
                                                    <v:Icon Data="{StaticResource IcFlag}"/>
                                                </Button>
                                                <Button Grid.Column="2" Classes="btn light small" Classes.primary="{Binding IsAccept}"
                                                        Content="{Binding ActionLabel}" Command="{Binding ActCommand}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Sent requests; the ones you get are in the inbox -->
                            <StackPanel Spacing="8" IsVisible="{Binding HasOutgoing}">
                                <TextBlock Text="SENT REQUESTS" Classes="mono muted" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <ItemsControl ItemsSource="{Binding Outgoing}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RequestRowViewModel">
                                            <Border Classes="listRow">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                    <Border Classes="avatar">
                                                        <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Classes="muted"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="btn outline small" Foreground="{DynamicResource Soft}"
                                                            Content="Cancel" Command="{Binding CancelCommand}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="{Binding SentCountText}" FontSize="12" Foreground="{DynamicResource Faint}" Classes="wideOnly"/>
                        </StackPanel>
                    </Border>

                    <!-- Blocked users: only here, since they don't show in search -->
                    <Border Classes="card" IsVisible="{Binding HasBlocked}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Blocked" Classes="h2"/>
                            <ItemsControl ItemsSource="{Binding Blocked}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BlockedRowViewModel">
                                        <Border Classes="listRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                <Border Classes="avatar">
                                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Button Grid.Column="2" Classes="btn outline small" Foreground="{DynamicResource Soft}"
                                                        Content="Unblock" Command="{Binding UnblockCommand}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <v:FriendQrSheet DataContext="{Binding Qr}"/>
    <v:ReportUserDialog DataContext="{Binding Report}"/>
    </Grid>
</UserControl>
