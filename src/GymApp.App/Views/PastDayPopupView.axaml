<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.PastDayPopupView"
             x:DataType="vm:PastDayPopupViewModel">
    <!-- A past day from the 7-day chart (Phase 27d): a centred card on the dimmed page with the day, its status, the macro ring
         and its legend, and "See what you ate". X, Escape or a tap on the dimmed page closes it. -->
    <UserControl.Styles>
        <StyleInclude Source="/Views/GainStreakStyles.axaml"/>
        <Style Selector="TextBlock.status"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
        <Style Selector="TextBlock.status.off"><Setter Property="Foreground" Value="{DynamicResource FlameText}"/></Style>
        <Style Selector="TextBlock.status.hit"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Ellipse.dot.protein"><Setter Property="Fill" Value="{DynamicResource MacroProtein}"/></Style>
        <Style Selector="Ellipse.dot.carbs"><Setter Property="Fill" Value="{DynamicResource MacroCarbs}"/></Style>
        <Style Selector="Ellipse.dot.fat"><Setter Property="Fill" Value="{DynamicResource MacroFat}"/></Style>
    </UserControl.Styles>
    <Border x:Name="Scrim" Classes="scrim" Background="{DynamicResource Scrim}" Padding="24">
        <v:Sheet Classes="centred" MaxWidth="360" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="20,16,20,20" CornerRadius="22"
                 Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <StackPanel Spacing="16" TextElement.Foreground="{DynamicResource Ink}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="ExtraBold"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Classes="status" Classes.off="{Binding IsOff}" Classes.hit="{Binding IsHit}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" AutomationProperties.Name="Close" VerticalAlignment="Top"
                            Command="{Binding CloseCommand}">
                        <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.4"/>
                    </Button>
                </Grid>

                <v:MacroRing Width="180" Height="180" HorizontalAlignment="Center" IsVisible="{Binding ShowRing}"
                             Split="{Binding Split}" EatenKcal="{Binding EatenKcal}" GoalKcal="{Binding GoalKcal}"/>

                <ItemsControl ItemsSource="{Binding Legend}" IsVisible="{Binding HasEntries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MacroLegendRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,52" ColumnSpacing="10">
                                <Ellipse Classes="dot" Classes.protein="{Binding IsProtein}" Classes.carbs="{Binding IsCarbs}"
                                         Classes.fat="{Binding IsFat}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding GramsText}" FontSize="15" FontFamily="{StaticResource Mono}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding PercentText}" FontSize="15" FontFamily="{StaticResource Mono}"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Logged as a total, without foods, so there is no macro split." FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource Soft}" HorizontalAlignment="Center" TextAlignment="Center"
                           IsVisible="{Binding IsTotalOnly}"/>
                <TextBlock Text="Nothing was logged this day." FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource Soft}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12" IsVisible="{Binding IsNotLogged}"/>

                <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinHeight="44"
                        Content="See what you ate" Command="{Binding SeeFoodCommand}" IsVisible="{Binding HasEntries}"/>
            </StackPanel>
        </v:Sheet>
    </Border>
</UserControl>
