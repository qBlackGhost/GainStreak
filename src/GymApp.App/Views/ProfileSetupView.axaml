<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.ProfileSetupView"
             x:DataType="vm:ProfileSetupViewModel">
    <!-- After the "Gym App" design canvas (Profile setup artboard): shown once, right after creating an account.
         One column of at most 640 px, so it reads the same on a phone; Skip and Save stay pinned at the bottom. -->
    <UserControl.Styles>
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.formLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="TextBlock.fieldError">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="{DynamicResource FlameText}"/>
        </Style>
        <Style Selector="TextBlock.caps">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="Border.track">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.field.bad">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorText}"/>
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        </Style>
        <Style Selector="ComboBox.field">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.field.bad">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorText}"/>
        </Style>
        <Style Selector="Border.unitTag">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.step">
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource Fill2}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.step.on">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border.estimate">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        </Style>
        <Style Selector="Border.estimate.ready">
            <Setter Property="Background" Value="{DynamicResource LimeTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LimeTintLine}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
        <!-- Brand and Skip -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="{StaticResource GainStreakLogo}" Width="32" Height="32"/>
                    <TextBlock FontSize="18" FontWeight="ExtraBold" LetterSpacing="0.4" VerticalAlignment="Center"><Run Text="GAIN"/><Run Text="STREAK" Foreground="{DynamicResource AccentInk}"/></TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Classes="link" MinHeight="44" Padding="14,0" FontSize="14" FontWeight="SemiBold"
                        Foreground="{DynamicResource Soft}" Content="Skip for now" Command="{Binding SkipCommand}"
                        IsVisible="{Binding IsEditing}"/>
            </Grid>
        </Border>

        <!-- Pinned actions -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,14,16,18"
                Background="{DynamicResource PageBg}" IsVisible="{Binding IsEditing}">
            <StackPanel MaxWidth="608" Spacing="8">
                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="10">
                    <Button Classes="btn outline" MinHeight="52" FontSize="15" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Content="Skip for now" Command="{Binding SkipCommand}"/>
                    <Button Grid.Column="1" Classes="btn primary" MinHeight="52" FontSize="15" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Content="Save and continue" Command="{Binding SaveCommand}"/>
                </Grid>
                <TextBlock Text="{Binding SaveHint}" FontSize="12" TextAlignment="Center" Classes="muted"
                           Classes.fieldError="{Binding SaveHintIsError}"
                           IsVisible="{Binding SaveHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding Error}" Classes="fieldError" TextAlignment="Center"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <ScrollViewer>
            <Panel MaxWidth="640" Margin="16,32,16,32">

                <!-- ===== The form ===== -->
                <StackPanel Spacing="20" IsVisible="{Binding IsEditing}">
                    <StackPanel Spacing="10" Margin="4,0">
                        <TextBlock Text="{Binding WelcomeText}" FontSize="12" FontWeight="Bold" LetterSpacing="1.4" Classes="muted"/>
                        <TextBlock Text="Set up your profile" FontSize="32" FontWeight="ExtraBold"/>
                        <TextBlock FontSize="15" LineHeight="22" Classes="soft"
                                   Text="Everything here is optional. It powers your daily calorie estimate and opens the gym map on your city. You can change it any time in Profile."/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <v:Icon Data="{StaticResource IcLock}" Stroke="{DynamicResource Muted}" Width="14" Height="14"/>
                            <TextBlock Text="Body data is stored only on this device." FontSize="12" Classes="muted"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- About you -->
                    <Border Classes="card" Padding="20,24">
                        <StackPanel Spacing="22">
                            <TextBlock Text="About you" Classes="h2" FontSize="20"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Units" Classes="formLabel"/>
                                <Border Classes="track">
                                    <v:SegmentedPill SelectedIndex="{Binding UnitsIndex}" PillInset="0">
                                        <Button Classes="seg" Classes.on="{Binding IsMetric}" Content="Metric · kg, cm"
                                                Command="{Binding SelectMetricCommand}"/>
                                        <Button Classes="seg" Classes.on="{Binding IsImperial}" Content="Imperial · lb, ft"
                                                Command="{Binding SelectImperialCommand}"/>
                                    </v:SegmentedPill>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Gender" Classes="formLabel"/>
                                <Border Classes="track">
                                    <v:SegmentedPill SelectedIndex="{Binding GenderIndex}" PillInset="0">
                                        <Button Classes="seg" Classes.on="{Binding GenderIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=0}"
                                                Content="Male" Command="{Binding SelectGenderCommand}" CommandParameter="0"/>
                                        <Button Classes="seg" Classes.on="{Binding GenderIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=1}"
                                                Content="Female" Command="{Binding SelectGenderCommand}" CommandParameter="1"/>
                                        <Button Classes="seg" Classes.on="{Binding GenderIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=2}"
                                                Command="{Binding SelectGenderCommand}" CommandParameter="2">
                                            <TextBlock Text="Prefer not to say" TextAlignment="Center"/>
                                        </Button>
                                    </v:SegmentedPill>
                                </Border>
                                <TextBlock Text="The calorie formula uses male or female. Prefer not to say skips the estimate." Classes="hint"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Birth date" Classes="formLabel"/>
                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" Classes.bad="{Binding BirthDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             Width="72" TextAlignment="Center" PlaceholderText="DD"
                                             Text="{Binding BirthDayText}" AutomationProperties.Name="Day"/>
                                    <ComboBox Classes="field" Classes.bad="{Binding BirthDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                              MinWidth="140" ItemsSource="{Binding Months}"
                                              SelectedItem="{Binding BirthMonth}" PlaceholderText="Month" AutomationProperties.Name="Month">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MonthOption">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" Classes.bad="{Binding BirthDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             Width="96" TextAlignment="Center" PlaceholderText="YYYY"
                                             Text="{Binding BirthYearText}" AutomationProperties.Name="Year"/>
                                    <Border Background="{DynamicResource Fill2}" CornerRadius="999" Padding="11,5" VerticalAlignment="Center"
                                            IsVisible="{Binding AgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding AgeText}" FontSize="13" FontWeight="SemiBold" Classes="light"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Classes="fieldError" Text="{Binding BirthDateError}"
                                           IsVisible="{Binding BirthDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Body -->
                    <Border Classes="card" Padding="20,24">
                        <StackPanel Spacing="22">
                            <TextBlock Text="Body" Classes="h2" FontSize="20"/>

                            <WrapPanel x:Name="BodyRow" ItemSpacing="16" LineSpacing="16">
                                <StackPanel x:Name="HeightField" Spacing="8">
                                    <TextBlock Text="Height" Classes="formLabel"/>
                                    <Panel IsVisible="{Binding IsMetric}">
                                        <TextBox TextInputOptions.ContentType="Number" Classes="field mono" Classes.bad="{Binding HeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 Padding="14,0,48,0" PlaceholderText="e.g. 178" Text="{Binding HeightCmText}"
                                                 AutomationProperties.Name="Height in centimetres"/>
                                        <Border Classes="unitTag"><TextBlock Text="cm" FontSize="13" Classes="muted"/></Border>
                                    </Panel>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsImperial}">
                                        <Panel>
                                            <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" Classes.bad="{Binding HeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                     Padding="14,0,36,0" PlaceholderText="5" Text="{Binding HeightFtText}"
                                                     AutomationProperties.Name="Height, feet"/>
                                            <Border Classes="unitTag"><TextBlock Text="ft" FontSize="13" Classes="muted"/></Border>
                                        </Panel>
                                        <Panel Grid.Column="1">
                                            <TextBox TextInputOptions.ContentType="Digits" Classes="field mono" Classes.bad="{Binding HeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                     Padding="14,0,36,0" PlaceholderText="10" Text="{Binding HeightInText}"
                                                     AutomationProperties.Name="Height, inches"/>
                                            <Border Classes="unitTag"><TextBlock Text="in" FontSize="13" Classes="muted"/></Border>
                                        </Panel>
                                    </Grid>
                                    <TextBlock Classes="fieldError" Text="{Binding HeightError}"
                                               IsVisible="{Binding HeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <StackPanel x:Name="WeightField" Spacing="8">
                                    <TextBlock Text="Current weight" Classes="formLabel"/>
                                    <Panel>
                                        <TextBox TextInputOptions.ContentType="Number" Classes="field mono" Classes.bad="{Binding WeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 Padding="14,0,48,0" PlaceholderText="{Binding WeightWatermark}" Text="{Binding WeightText}"
                                                 AutomationProperties.Name="Current weight"/>
                                        <Border Classes="unitTag"><TextBlock Text="{Binding WeightUnit}" FontSize="13" Classes="muted"/></Border>
                                    </Panel>
                                    <TextBlock Classes="fieldError" Text="{Binding WeightError}"
                                               IsVisible="{Binding WeightError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="Saved as today's weigh-in." Classes="hint"/>
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Activity outside the gym" Classes="formLabel"/>
                                <Border Classes="track">
                                    <ItemsControl ItemsSource="{Binding ActivityOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <v:SegmentedPill SelectedIndex="{Binding ActivityIndex}" PillInset="0"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ActivityOption">
                                                <Button Classes="seg" Classes.on="{Binding IsSelected}" MinHeight="62" Command="{Binding PickCommand}">
                                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
                                                        <TextBlock Text="{Binding Steps}" FontSize="12" Opacity="0.8" TextAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Text="Pick the one that matches your usual daily steps." Classes="hint"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Live estimate -->
                    <Border Classes="estimate" Classes.ready="{Binding HasEstimate}" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="YOUR DAILY CALORIES" Classes="caps"/>
                                <TextBlock Grid.Column="1" Text="{Binding FilledText}" FontSize="12" FontFamily="{StaticResource Mono}" Classes="muted"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Progress}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="5" ColumnSpacing="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:Boolean">
                                        <Border Classes="step" Classes.on="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Spacing="2" IsVisible="{Binding HasEstimate}">
                                <TextBlock>
                                    <Run Text="{Binding EstimateText}" FontFamily="{StaticResource Mono}" FontSize="28" FontWeight="Bold"/><Run
                                         Text=" kcal / day to maintain" FontSize="15" Foreground="{DynamicResource Soft}"/>
                                </TextBlock>
                                <TextBlock Text="You can set it as your calorie goal on the next step." Classes="hint"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EstimateMessage}" FontSize="14" LineHeight="21" Classes="soft"
                                       Classes.warn="{Binding EstimateIsWarning}" IsVisible="{Binding !HasEstimate}"/>
                        </StackPanel>
                    </Border>

                    <!-- Home city -->
                    <Border Classes="card" Padding="20,24">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Home city" Classes="h2" FontSize="20"/>
                                <TextBlock Text="The gym map opens on this city. You can still pick gyms anywhere." FontSize="13" Classes="soft"/>
                            </StackPanel>
                            <Border Padding="14,12" CornerRadius="14" BorderBrush="{DynamicResource Control}" BorderThickness="1"
                                    IsVisible="{Binding HasCity}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Accent}">
                                        <v:Icon Data="{StaticResource IcPin}" Stroke="Black" StrokeThickness="2.2" Width="20" Height="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CityName}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding CityRegion}" FontSize="13" Classes="muted"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="btn outline small" MinHeight="44" Content="Change"
                                            Command="{Binding ChangeCityCommand}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Spacing="14" IsVisible="{Binding !HasCity}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Panel>
                                        <TextBox x:Name="CityBox" Classes="field" Padding="42,0,14,0" PlaceholderText="e.g. Cluj-Napoca"
                                                 Text="{Binding CitySearchText}" AutomationProperties.Name="Search for a city"/>
                                        <v:Icon Data="{StaticResource IcSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="2.2"
                                                HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                                    </Panel>
                                    <Button Grid.Column="1" Classes="btn light" MinHeight="48" Padding="18,0" Content="Search"
                                            Command="{Binding SearchCityCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding CitySearchMessage}" FontSize="13" Classes="soft"
                                           IsVisible="{Binding CitySearchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <Button Classes="btn outline small" Content="Retry" HorizontalAlignment="Left"
                                        Command="{Binding SearchCityCommand}" IsVisible="{Binding CanRetryCitySearch}"/>
                                <Border CornerRadius="14" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True"
                                        IsVisible="{Binding HasCityCandidates}">
                                    <ItemsControl ItemsSource="{Binding CityCandidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CityCandidateViewModel">
                                                <Button Classes="btn" MinHeight="52" Padding="16,8" CornerRadius="0" Background="{DynamicResource Surface2}"
                                                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" FontWeight="Normal"
                                                        Foreground="{DynamicResource Ink}" Command="{Binding ChooseCommand}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Classes="muted"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="Set as home" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Text="City search uses OpenStreetMap (Nominatim)." Classes="hint"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Saved ===== -->
                <StackPanel Spacing="20" IsVisible="{Binding IsDone}">
                    <StackPanel Spacing="10" Margin="4,0">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Accent}" HorizontalAlignment="Left">
                            <v:Icon Data="{StaticResource IcCheck}" Stroke="Black" StrokeThickness="2.8" Width="24" Height="24"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="You're all set" FontSize="32" FontWeight="ExtraBold"/>
                        <TextBlock Text="Here's what we saved. Anything left empty can be added later in Profile." FontSize="15" Classes="soft"/>
                    </StackPanel>

                    <Border Classes="card" Padding="20,8">
                        <ItemsControl ItemsSource="{Binding Summary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SetupSummaryRow">
                                    <Border MinHeight="52" BorderBrush="{DynamicResource Divider}"
                                            BorderThickness="{Binding IsFirst, Converter={x:Static v:ProfileSetupView.TopLine}}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="14" Classes="soft" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" TextAlignment="Right"
                                                       VerticalAlignment="Center" IsVisible="{Binding IsSet}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14" Classes="muted" TextAlignment="Right"
                                                       VerticalAlignment="Center" IsVisible="{Binding !IsSet}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Classes="card" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="DAILY CALORIE GOAL" Classes="caps"/>
                            <StackPanel Spacing="14" IsVisible="{Binding HasSavedEstimate}">
                                <TextBlock>
                                    <Run Text="{Binding SavedEstimateText}" FontFamily="{StaticResource Mono}" FontSize="28" FontWeight="Bold"/><Run
                                         Text=" kcal / day to maintain" FontSize="15" Foreground="{DynamicResource Soft}"/>
                                </TextBlock>
                                <Button Classes="btn light" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="Use as my daily goal" Command="{Binding UseAsGoalCommand}" IsVisible="{Binding !IsGoalSet}"/>
                                <Border Padding="14,12" CornerRadius="12" BorderBrush="{DynamicResource LimeTintLine}" BorderThickness="1"
                                        Background="{DynamicResource LimeTint}" IsVisible="{Binding IsGoalSet}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.8" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="14" VerticalAlignment="Center">
                                            <Run Text="Goal set to "/><Run Text="{Binding SavedEstimateText}"/><Run Text=" kcal. Change it any time in Calories."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SavedEstimateMessage}" FontSize="14" Classes="soft" IsVisible="{Binding !HasSavedEstimate}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Error}" Classes="fieldError"
                               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <StackPanel Spacing="10">
                        <Button Classes="btn primary" MinHeight="52" FontSize="15" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding FinishCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Go to your dashboard" VerticalAlignment="Center"/>
                                <v:Icon Data="{StaticResource IcArrowRight}" StrokeThickness="2.4" Width="16" Height="16"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="link" MinHeight="48" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                Foreground="{DynamicResource Soft}" Content="Edit answers" Command="{Binding EditAnswersCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
