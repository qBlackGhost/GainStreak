        <StreamGeometry x:Key="IcMoon">M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z</StreamGeometry>
        <StreamGeometry x:Key="IcPlane">M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z</StreamGeometry>
        <!-- Filled, for a Path rather than an Icon -->
        <StreamGeometry x:Key="IcStar">M12 2l3 7 7 0.6-5.3 4.7L18.3 22 12 18l-6.3 4 1.6-7.7L2 9.6 9 9z</StreamGeometry>
        <StreamGeometry x:Key="IcBolt">M13 3L5 14h6l-1 7 8-11h-6z</StreamGeometry>
        <StreamGeometry x:Key="IcHeart">M12 20s-8-5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 9c0 6-8 11-8 11z</StreamGeometry>
        <StreamGeometry x:Key="IcMountain">M3 20l6-11 4 7 3-4 5 8z</StreamGeometry>
        <StreamGeometry x:Key="IcTarget">M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0</StreamGeometry>
        <StreamGeometry x:Key="IcArc">M 40 240 A 200 200 0 0 1 440 240</StreamGeometry>
</ResourceDictionary>
