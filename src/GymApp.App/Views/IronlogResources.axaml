        <StreamGeometry x:Key="IcShield">M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z</StreamGeometry>
        <StreamGeometry x:Key="IcCopy">M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zM16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2</StreamGeometry>
        <StreamGeometry x:Key="IcSearch">M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0M20 20l-3.5-3.5</StreamGeometry>
        <!-- Filled six dots, for a Path: the drag handle -->
        <StreamGeometry x:Key="IcGrip">M3.4 4a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0M9.4 4a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0M3.4 10a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0M9.4 10a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0M3.4 16a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0M9.4 16a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0</StreamGeometry>
        <StreamGeometry x:Key="IcArrowRight">M5 12h14M13 6l6 6-6 6</StreamGeometry>
        <!-- Filled, for a Path: the "Start" marker -->
        <StreamGeometry x:Key="IcPlay">M7 4l13 8-13 8z</StreamGeometry>
        <StreamGeometry x:Key="IcTrash">M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3</StreamGeometry>
        <StreamGeometry x:Key="IcInfo">M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M12 8v5M12 16h0.01</StreamGeometry>
        <StreamGeometry x:Key="IcInfoCircle">M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M12 11v5M12 8h0.01</StreamGeometry>
        <StreamGeometry x:Key="IcPencil">M4 20h4L19 9l-4-4L4 16z</StreamGeometry>
        <StreamGeometry x:Key="IcRefresh">M20 12a8 8 0 1 1-2.3-5.6M20 4v4h-4</StreamGeometry>
        <StreamGeometry x:Key="IcChat">M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM8 9h8M8 12.5h5</StreamGeometry>
        <StreamGeometry x:Key="IcSend">M21 3L10 14M21 3l-6.5 18-4.5-7-7-4.5z</StreamGeometry>
