        <StreamGeometry x:Key="IcWifiOff">M2 2l20 20M8.5 16.4a5 5 0 0 1 7 0M5 12.9a10 10 0 0 1 5.2-2.8M19 12.9a10 10 0 0 0-2.3-1.6M12 20h.01</StreamGeometry>
        <StreamGeometry x:Key="IcLinkOff">M9 15l6-6M10 6.5l1.2-1.2a4.2 4.2 0 0 1 6 6L16 12.5M14 17.5l-1.2 1.2a4.2 4.2 0 0 1-6-6L8 11.5M3 3l18 18</StreamGeometry>
        <StreamGeometry x:Key="IcBlock">M5.6 5.6l12.8 12.8M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z</StreamGeometry>
