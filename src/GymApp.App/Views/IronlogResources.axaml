<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The GainStreak look from the Gym App design canvas, dark and light: colors, fonts and icons shared by its screens -->
        <!-- Colors per theme (12e). Views use them with DynamicResource so a theme change applies at once -->
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Dark">
                <!-- Lime fill: buttons, bars, badges (black text on it in both themes) -->
                <SolidColorBrush x:Key="Accent" Color="#C6F432"/>
                <!-- Lime as text, icon or outline -->
                <SolidColorBrush x:Key="AccentInk" Color="#C6F432"/>
                <SolidColorBrush x:Key="AccentInkHover" Color="#E2FF8A"/>
                <!-- The window behind everything -->
                <SolidColorBrush x:Key="PageBg" Color="#000000"/>
                <!-- Cards -->
                <SolidColorBrush x:Key="Surface" Color="#0B0B0B"/>
                <!-- Popup footers -->
                <SolidColorBrush x:Key="SurfaceSunken" Color="#080808"/>
                <!-- Rows and panels inside a card -->
                <SolidColorBrush x:Key="Surface2" Color="#111111"/>
                <SolidColorBrush x:Key="Surface3" Color="#121212"/>
                <SolidColorBrush x:Key="HoverBg" Color="#141414"/>
                <!-- Chips, segmented tracks, inputs -->
                <SolidColorBrush x:Key="Fill" Color="#161616"/>
                <SolidColorBrush x:Key="Fill2" Color="#1A1A1A"/>
                <SolidColorBrush x:Key="Fill3" Color="#1E1E1E"/>
                <!-- Empty part of a bar -->
                <SolidColorBrush x:Key="Track" Color="#222222"/>
                <SolidColorBrush x:Key="TrackStrong" Color="#2E2E2E"/>
                <!-- Split usage donut: the other splits' slices, biggest share first -->
                <SolidColorBrush x:Key="Tone1" Color="#9A9A9A"/>
                <SolidColorBrush x:Key="Tone2" Color="#7A7A7A"/>
                <SolidColorBrush x:Key="Tone3" Color="#5E5E5E"/>
                <SolidColorBrush x:Key="Tone4" Color="#474747"/>
                <SolidColorBrush x:Key="Tone5" Color="#343434"/>
                <!-- The selected surface: current nav item, the sliding pill, avatars -->
                <SolidColorBrush x:Key="Inverse" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="InverseHover" Color="#E6E6E6"/>
                <SolidColorBrush x:Key="InversePressed" Color="#CCCCCC"/>
                <!-- Text on Inverse -->
                <SolidColorBrush x:Key="OnInverse" Color="#000000"/>
                <!-- Main text -->
                <SolidColorBrush x:Key="Ink" Color="#FFFFFF"/>
                <!-- Text just under Ink -->
                <SolidColorBrush x:Key="Light" Color="#D6D6D6"/>
                <!-- Secondary text -->
                <SolidColorBrush x:Key="Soft" Color="#B5B5B5"/>
                <!-- Labels, captions -->
                <SolidColorBrush x:Key="Muted" Color="#9A9A9A"/>
                <!-- Placeholders, disabled text -->
                <SolidColorBrush x:Key="Faint" Color="#6E6E6E"/>
                <!-- Zeros and empty marks -->
                <SolidColorBrush x:Key="Ghost" Color="#3A3A3A"/>
                <SolidColorBrush x:Key="Divider" Color="#1C1C1C"/>
                <!-- Card borders -->
                <SolidColorBrush x:Key="Line" Color="#222222"/>
                <SolidColorBrush x:Key="Line2" Color="#2A2A2A"/>
                <!-- Control borders -->
                <SolidColorBrush x:Key="Control" Color="#333333"/>
                <SolidColorBrush x:Key="ControlHover" Color="#444444"/>
                <SolidColorBrush x:Key="ControlStrong" Color="#555555"/>
                <!-- Missed days, the requests badge -->
                <SolidColorBrush x:Key="MissRed" Color="#FF6B5B"/>
                <SolidColorBrush x:Key="ErrorText" Color="#FF8A7A"/>
                <!-- Orange as text or line -->
                <SolidColorBrush x:Key="Flame" Color="#FF8A2A"/>
                <SolidColorBrush x:Key="FlameText" Color="#FFB066"/>
                <SolidColorBrush x:Key="FlameHot" Color="#FF7A00"/>
                <SolidColorBrush x:Key="Warn" Color="#E8C15A"/>
                <SolidColorBrush x:Key="ColdText" Color="#B9C8D6"/>
                <!-- A streak on ice: a rest day that didn't add to it (0.18.1) -->
                <SolidColorBrush x:Key="Ice" Color="#5CB8FF"/>
                <SolidColorBrush x:Key="IceText" Color="#8FD0FF"/>
                <SolidColorBrush x:Key="IceTintLine" Color="#1E3F5C"/>
                <SolidColorBrush x:Key="IceTint" Color="#0A1520"/>
                <!-- Lime-tinted backgrounds -->
                <SolidColorBrush x:Key="LimeTint" Color="#10140A"/>
                <SolidColorBrush x:Key="LimeTintLine" Color="#2E3A12"/>
                <SolidColorBrush x:Key="LimeTintLineStrong" Color="#3E4E14"/>
                <SolidColorBrush x:Key="RedTint" Color="#1A0F0D"/>
                <SolidColorBrush x:Key="OrangeTint" Color="#1E1408"/>
                <SolidColorBrush x:Key="RedTintLine" Color="#5A2A24"/>
                <SolidColorBrush x:Key="OrangeTintLine" Color="#5A3A1A"/>
                <SolidColorBrush x:Key="ColdTint" Color="#0E1113"/>
                <!-- Behind popups -->
                <SolidColorBrush x:Key="Scrim" Color="#B8000000"/>
                <!-- Panels floating over the map -->
                <SolidColorBrush x:Key="Glass" Color="#C7000000"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="Accent" Color="#C6F432"/>
                <SolidColorBrush x:Key="AccentInk" Color="#4D7C0F"/>
                <SolidColorBrush x:Key="AccentInkHover" Color="#365A08"/>
                <SolidColorBrush x:Key="PageBg" Color="#F4F4F1"/>
                <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="SurfaceSunken" Color="#F7F7F4"/>
                <SolidColorBrush x:Key="Surface2" Color="#F7F7F4"/>
                <SolidColorBrush x:Key="Surface3" Color="#F2F2EE"/>
                <SolidColorBrush x:Key="HoverBg" Color="#EBEBE7"/>
                <SolidColorBrush x:Key="Fill" Color="#ECECE8"/>
                <SolidColorBrush x:Key="Fill2" Color="#EDEDE9"/>
                <SolidColorBrush x:Key="Fill3" Color="#E8E8E4"/>
                <SolidColorBrush x:Key="Track" Color="#E2E2DD"/>
                <SolidColorBrush x:Key="TrackStrong" Color="#D6D6D1"/>
                <SolidColorBrush x:Key="Tone1" Color="#5E5E5A"/>
                <SolidColorBrush x:Key="Tone2" Color="#7E7E79"/>
                <SolidColorBrush x:Key="Tone3" Color="#9E9E99"/>
                <SolidColorBrush x:Key="Tone4" Color="#BDBDB8"/>
                <SolidColorBrush x:Key="Tone5" Color="#D6D6D1"/>
                <SolidColorBrush x:Key="Inverse" Color="#0B0B0B"/>
                <SolidColorBrush x:Key="InverseHover" Color="#2A2A2A"/>
                <SolidColorBrush x:Key="InversePressed" Color="#3A3A3A"/>
                <SolidColorBrush x:Key="OnInverse" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="Ink" Color="#0B0B0B"/>
                <SolidColorBrush x:Key="Light" Color="#2E2E2E"/>
                <SolidColorBrush x:Key="Soft" Color="#4A4A47"/>
                <SolidColorBrush x:Key="Muted" Color="#62625E"/>
                <SolidColorBrush x:Key="Faint" Color="#8A8A86"/>
                <SolidColorBrush x:Key="Ghost" Color="#C2C2BD"/>
                <SolidColorBrush x:Key="Divider" Color="#EAEAE6"/>
                <SolidColorBrush x:Key="Line" Color="#E2E2DD"/>
                <SolidColorBrush x:Key="Line2" Color="#DADAD5"/>
                <SolidColorBrush x:Key="Control" Color="#D0D0CB"/>
                <SolidColorBrush x:Key="ControlHover" Color="#B5B5B0"/>
                <SolidColorBrush x:Key="ControlStrong" Color="#9A9A96"/>
                <SolidColorBrush x:Key="MissRed" Color="#D9473A"/>
                <SolidColorBrush x:Key="ErrorText" Color="#C4362A"/>
                <SolidColorBrush x:Key="Flame" Color="#C25100"/>
                <SolidColorBrush x:Key="FlameText" Color="#B35300"/>
                <SolidColorBrush x:Key="FlameHot" Color="#C25100"/>
                <SolidColorBrush x:Key="Warn" Color="#8A6400"/>
                <SolidColorBrush x:Key="ColdText" Color="#3E5568"/>
                <SolidColorBrush x:Key="Ice" Color="#1C7ED6"/>
                <SolidColorBrush x:Key="IceText" Color="#1668B3"/>
                <SolidColorBrush x:Key="IceTintLine" Color="#A9D2F5"/>
                <SolidColorBrush x:Key="IceTint" Color="#EAF4FD"/>
                <SolidColorBrush x:Key="LimeTint" Color="#EFF7D6"/>
                <SolidColorBrush x:Key="LimeTintLine" Color="#C9DD8E"/>
                <SolidColorBrush x:Key="LimeTintLineStrong" Color="#B9D27A"/>
                <SolidColorBrush x:Key="RedTint" Color="#FDECEA"/>
                <SolidColorBrush x:Key="OrangeTint" Color="#FFF0E0"/>
                <SolidColorBrush x:Key="RedTintLine" Color="#F2B8B0"/>
                <SolidColorBrush x:Key="OrangeTintLine" Color="#F3C9A0"/>
                <SolidColorBrush x:Key="ColdTint" Color="#E9EEF2"/>
                <SolidColorBrush x:Key="Scrim" Color="#66141412"/>
                <SolidColorBrush x:Key="Glass" Color="#EBFFFFFF"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <FontFamily x:Key="Mono">Cascadia Mono, Menlo, Consolas, DejaVu Sans Mono, monospace</FontFamily>

        <LinearGradientBrush x:Key="ColdBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#3E4C59"/>
            <GradientStop Offset="0.5" Color="#7D93A8"/>
            <GradientStop Offset="1" Color="#B9C8D6"/>
        </LinearGradientBrush>
        <!-- The streak flame on ice: deep blue at the base to frost at the tip -->
        <LinearGradientBrush x:Key="IceFlameBrush" StartPoint="0%,100%" EndPoint="0%,0%">
            <GradientStop Offset="0" Color="#1F6FD1"/>
            <GradientStop Offset="0.6" Color="#5CB8FF"/>
            <GradientStop Offset="1" Color="#D4F0FF"/>
        </LinearGradientBrush>
        <!-- The icy flame (option E): the flame filled with ice and a white glint. An Image scales it as one piece -->
        <DrawingImage x:Key="IcyFlame">
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource IceFlameBrush}"
                                 Geometry="M12 22c4 0 7-3 7-7 0-5-4-7-5-12-2 3-3 5-3 7-1-1-2-2-2-4-2 2-4 5-4 9 0 4 3 7 7 7z"/>
                <GeometryDrawing Geometry="M9 15.5l1.6-2.2">
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="1.8" LineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage>
        <LinearGradientBrush x:Key="IceBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#1F6FD1"/>
            <GradientStop Offset="0.45" Color="#3FA2F2"/>
            <GradientStop Offset="0.8" Color="#8ED3FF"/>
            <GradientStop Offset="1" Color="#D4F0FF"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FireBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#C81D00"/>
            <GradientStop Offset="0.35" Color="#FF4A00"/>
            <GradientStop Offset="0.7" Color="#FF9A00"/>
            <GradientStop Offset="1" Color="#FFD400"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TodayDoneBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#FF4A00"/>
            <GradientStop Offset="1" Color="#FFB000"/>
        </LinearGradientBrush>

        <!-- The GainStreak logo (the app icon, Assets/gainstreak-icon.svg), on a 100×100 grid -->
        <DrawingImage x:Key="GainStreakLogo">
            <DrawingGroup>
                <GeometryDrawing Brush="#0B0B0B" Geometry="M22.5 0.5H77.5A22 22 0 0 1 99.5 22.5V77.5A22 22 0 0 1 77.5 99.5H22.5A22 22 0 0 1 0.5 77.5V22.5A22 22 0 0 1 22.5 0.5Z">
                    <GeometryDrawing.Pen><Pen Brush="#222222" Thickness="1"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M50 15 L65 33 H57 C66 42 71 50 71 61 A21 21 0 0 1 29 61 C29 50 34 42 43 33 H35 Z">
                    <GeometryDrawing.Pen><Pen Brush="#C6F432" Thickness="7" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF4A00" Geometry="M50 15 L65 33 H57 C66 42 71 50 71 61 A21 21 0 0 1 29 61 C29 50 34 42 43 33 H35 Z"/>
                <GeometryDrawing Brush="#FF9A00" Geometry="M50 45 C57 52 60 57 60 63 A10 10 0 0 1 40 63 C40 57 43 52 50 45 Z"/>
                <GeometryDrawing Brush="#FFD400" Geometry="M50 55 C53 58 54.5 60.5 54.5 63.5 A4.5 4.5 0 0 1 45.5 63.5 C45.5 60.5 47 58 50 55 Z"/>
            </DrawingGroup>
        </DrawingImage>

        <!-- Icons, on a 24×24 grid (see Icon.cs) -->
        <StreamGeometry x:Key="IcDumbbell">M6 7v10M18 7v10M3 10v4M21 10v4M6 12h12</StreamGeometry>
        <StreamGeometry x:Key="IcGrid">M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z</StreamGeometry>
        <StreamGeometry x:Key="IcCalendar">M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM3 9h18M8 2v4M16 2v4</StreamGeometry>
        <StreamGeometry x:Key="IcCalendarCheck">M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM3 9h18M9 15l2 2 4-4</StreamGeometry>
        <StreamGeometry x:Key="IcFlame">M12 22c4 0 7-3 7-7 0-5-4-7-5-12-2 3-3 5-3 7-1-1-2-2-2-4-2 2-4 5-4 9 0 4 3 7 7 7z</StreamGeometry>
