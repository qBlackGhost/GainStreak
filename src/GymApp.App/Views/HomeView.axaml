<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             xmlns:services="using:GymApp.Services"
             x:Class="GymApp.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <!-- The dashboard, after the "Gym App" design canvas (Dashboard artboard): black, one lime accent, the streak
         gauge turns from cold to fire once today is checked in. Light or dark, from the Theme setting. -->

    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <!-- Text -->
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Wide by default; the narrow and compact styles below override these -->
        <!-- The streak note at the bottom of the streak card: a divider, or a lime strip when something is owed today -->
        <Style Selector="Border.streakNote">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Padding" Value="0,12,0,0"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        </Style>
        <Style Selector="Border.streakNote.urgent">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource AccentTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintLine}"/>
        </Style>
        <Style Selector="Border.streakNote TextBlock"><Setter Property="Foreground" Value="{DynamicResource Soft}"/></Style>
        <Style Selector="Border.streakNote.urgent TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style Selector="Border.streakNote.ice TextBlock"><Setter Property="Foreground" Value="{DynamicResource IceText}"/></Style>
        <!-- The streak card: wide values here, the phones' smaller ones below -->
        <Style Selector="Grid#Hero"><Setter Property="RowSpacing" Value="24"/></Style>
        <Style Selector="Viewbox#GaugeBox"><Setter Property="MaxWidth" Value="360"/></Style>
        <Style Selector="TextBlock#GaugeKicker"><Setter Property="FontSize" Value="15"/></Style>
        <Style Selector="TextBlock#GaugeSub"><Setter Property="FontSize" Value="17"/></Style>
        <Style Selector="Panel#HeroRight">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>

        <!-- Compact content: header and streak hero stack -->
        <Style Selector="StackPanel.compact Panel#HeroLeft">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="StackPanel.compact Panel#HeroRight">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>

        <!-- Level bar -->
        <Style Selector="ProgressBar.lvl">
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource Track}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- Get set up: step cards -->
        <Style Selector="Border.setupStep">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
        </Style>
        <Style Selector="Border.setupStep.done">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        </Style>
        <Style Selector="Border.setupStep.next">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
        </Style>
        <!-- Phones: the steps as one checklist; a later step is a whole-row button -->
        <Style Selector="Button.setupRow">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.setupRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.setupRow:disabled">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="Button.setupRow:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Border.setupBadge">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlHover}"/>
        </Style>
        <Style Selector="Border.setupBadge.done">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>
        <Style Selector="ProgressBar.setup">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource Track}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- Gauge: once checked in, the fire arc fills and the cold dashes fade out -->
        <Style Selector="Path.fire">
            <Style.Animations>
                <Animation Duration="0:0:1.4" FillMode="Both" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="23"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Path.coldFade">
            <Style.Animations>
                <Animation Duration="0:0:1.4" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="40%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.gaugeTitle">
            <Setter Property="Foreground" Value="{DynamicResource ColdText}"/>
            <Setter Property="FontSize" Value="76"/>
            <Setter Property="LineHeight" Value="76"/>
        </Style>
        <Style Selector="TextBlock.gaugeTitle.rest">
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        </Style>
        <Style Selector="TextBlock.gaugeTitle.ice">
            <Setter Property="Foreground" Value="{DynamicResource IceText}"/>
        </Style>
        <!-- A streak on ice (a rest day that didn't add to it): the hero's flame and number go cold blue.
             Their colours are set here, not on the elements, so the ice class can win over them. -->
        <Style Selector="v|Icon.streakFlame">
            <Setter Property="Stroke" Value="{DynamicResource AccentInk}"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>
        <Style Selector="v|Icon.streakFlame.ice">
            <Setter Property="Stroke" Value="{StaticResource IceFlameBrush}"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="TextBlock.gaugeTitle.hot">
            <Setter Property="Foreground" Value="{DynamicResource FlameHot}"/>
            <Setter Property="Effect">
                <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="24" Color="#80FF5000"/>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:1.4" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                    <KeyFrame Cue="55%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Week tiles -->
        <Style Selector="Border.tile">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Border.tile.rest">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="Border.tile.missed">
            <Setter Property="Background" Value="{DynamicResource RedTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RedTintLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.tile.upcoming">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="Border.tile.todayOpen">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#7D93A8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ColdText}"/>
        </Style>
        <Style Selector="Border.tile.vacation">
            <Setter Property="Background" Value="{DynamicResource IceTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IceTintLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource IceText}"/>
        </Style>
        <Style Selector="Border.tile.vacation.today">
            <Setter Property="BorderBrush" Value="{DynamicResource IceText}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.tile.todayDone">
            <Setter Property="Background" Value="{StaticResource TodayDoneBrush}"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>

        <!-- Sizes the phones change (the GainStreak Mobile canvas's Home): here rather than on the elements, so the
             ".phone" styles below can override them -->
        <Style Selector="StackPanel#Main"><Setter Property="Spacing" Value="24"/></Style>
        <Style Selector="WrapPanel#Cards">
            <Setter Property="ItemSpacing" Value="24"/>
            <Setter Property="LineSpacing" Value="24"/>
        </Style>
        <Style Selector="Border.setupCard"><Setter Property="Padding" Value="28,26"/></Style>
        <Style Selector="TextBlock#StreakNumber">
            <Setter Property="FontSize" Value="100"/>
            <Setter Property="LetterSpacing" Value="-4"/>
            <Setter Property="Margin" Value="0,-11,0,-14"/>
        </Style>
        <Style Selector="Border.weekCard"><Setter Property="Padding" Value="24,22"/></Style>
        <Style Selector="TextBlock.weekTitle"><Setter Property="FontSize" Value="20"/></Style>
        <Style Selector="WrapPanel#WeekLegend"><Setter Property="Grid.Column" Value="1"/></Style>
        <Style Selector="ItemsControl#WeekTiles"><Setter Property="Margin" Value="-4"/></Style>
        <Style Selector="TextBlock.tileName"><Setter Property="FontSize" Value="13"/></Style>

        <Style Selector=".phone StackPanel#Main"><Setter Property="Spacing" Value="14"/></Style>
        <!-- The calories card's status pill on the phones (Phase 27), as on the Calories screen -->
        <Style Selector="Border.status">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Soft}"/>
        </Style>
        <Style Selector="Border.status.off">
            <Setter Property="BorderBrush" Value="{DynamicResource OrangeTintLine}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource FlameText}"/>
        </Style>
        <Style Selector="Border.status.over">
            <Setter Property="BorderBrush" Value="{DynamicResource RedTintLine}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MissRed}"/>
        </Style>
        <Style Selector="Border.status.hit">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.goalChip">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector=".phone WrapPanel#Cards">
            <Setter Property="ItemSpacing" Value="14"/>
            <Setter Property="LineSpacing" Value="14"/>
        </Style>
        <Style Selector=".phone Border.setupCard"><Setter Property="Padding" Value="16"/></Style>
        <!-- Phones: level card plus the whole streak card in about 500 pt, so a small phone needs no scrolling.
             The gauge is a Viewbox, so its words scale down with it: they get bigger in its own coordinates -->
        <Style Selector=".phone Border.heroCard"><Setter Property="Padding" Value="14,12"/></Style>
        <Style Selector=".phone Grid#Hero"><Setter Property="RowSpacing" Value="8"/></Style>
        <Style Selector=".phone StackPanel#HeroLeftStack"><Setter Property="Spacing" Value="8"/></Style>
        <Style Selector=".phone StackPanel#GaugeStack"><Setter Property="Spacing" Value="6"/></Style>
        <Style Selector=".phone Viewbox#GaugeBox"><Setter Property="MaxWidth" Value="330"/></Style>
        <Style Selector=".phone TextBlock#GaugeKicker"><Setter Property="FontSize" Value="19"/></Style>
        <Style Selector=".phone TextBlock#GaugeSub"><Setter Property="FontSize" Value="20"/></Style>
        <Style Selector=".phone TextBlock.gaugeTitle">
            <Setter Property="FontSize" Value="78"/>
            <Setter Property="LineHeight" Value="78"/>
        </Style>
        <Style Selector=".phone TextBlock#StreakNumberPhone">
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="LetterSpacing" Value="-2.5"/>
            <Setter Property="Margin" Value="0,-8,0,-10"/>
        </Style>
        <Style Selector=".phone Border.streakNote"><Setter Property="Padding" Value="0,8,0,0"/></Style>
        <Style Selector=".phone Border.streakNote.urgent"><Setter Property="Padding" Value="12,8"/></Style>
        <Style Selector=".phone TextBlock#StreakNumber">
            <Setter Property="FontSize" Value="88"/>
            <Setter Property="LetterSpacing" Value="-3.5"/>
            <Setter Property="Margin" Value="0,-10,0,-12"/>
        </Style>
        <!-- This week: no card, seven narrow tiles, the legend under them -->
        <Style Selector=".phone Border.weekCard">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector=".phone TextBlock.weekTitle"><Setter Property="FontSize" Value="18"/></Style>
        <Style Selector=".phone WrapPanel#WeekLegend">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="2"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,-4,0,0"/>
        </Style>
        <Style Selector=".phone ItemsControl#WeekTiles"><Setter Property="Margin" Value="-2.5"/></Style>
        <Style Selector=".phone ItemsControl#WeekTiles Border.tile">
            <Setter Property="Padding" Value="2,8"/>
            <Setter Property="Margin" Value="2.5"/>
            <Setter Property="MinHeight" Value="66"/>
        </Style>
        <Style Selector=".phone ItemsControl#WeekTiles Border.tile TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector=".phone TextBlock.tileName"><Setter Property="FontSize" Value="11"/></Style>

        <!-- Missed-day options -->
        <Style Selector="Button.option">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.option.selected">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.option.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Light}"/>
        </Style>
        <Style Selector="Border.tag.skip">
            <Setter Property="BorderBrush" Value="{DynamicResource RedTintLine}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ErrorText}"/>
        </Style>

        <Style Selector="Border.boardRow.you">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
        </Style>

        <!-- Inputs -->
        <Style Selector="TextBox.kcal">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Gym toast slides in -->
        <Style Selector="Border.toast.show">
            <Style.Animations>
                <Animation Duration="0:0:0.45" FillMode="Both" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Grid x:Name="Root" Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
    <DockPanel IsEnabled="{Binding !IsCheckingIn}">

        <v:Sidebar Current="Dashboard" ScrollTopRequested="OnScrollTop"/>

        <!-- ===== Main ===== -->
        <ScrollViewer x:Name="MainScroll">
        <StackPanel x:Name="Main" Classes="page">

            <!-- Header: the level card, with the offline and streak-ended notices above it. No date or greeting (0.26.1):
                 the streak note lives in the streak card below. -->
            <!-- Hidden during a live workout (focus mode): the level card's points would show it already counts -->
            <StackPanel Spacing="12" IsVisible="{Binding ShowDashboard}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding StreakEndedNotice}" FontSize="13" Classes="muted"
                               IsVisible="{Binding StreakEndedNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding OfflineNotice}" FontSize="13" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding OfflineNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <Border x:Name="LevelPill" HorizontalAlignment="Stretch"
                        Padding="10,8,14,8" CornerRadius="16" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Accent}" VerticalAlignment="Top">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="LVL" Foreground="Black" FontSize="9" FontWeight="Bold" LetterSpacing="0.8"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LevelNumber}" Foreground="Black" FontSize="19" FontWeight="Black"
                                           HorizontalAlignment="Center" Margin="0,-3,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock FontSize="14" FontWeight="Bold">
                                    <Run Text="{Binding LevelTitle}"/><Run Text=" · "/><Run Text="{Binding PointsText}"/>
                                </TextBlock>
                                <!-- The 44 pt touch minimum would make this row tall: negative margins keep the row as high as the text, the touch area stays -->
                                <Button Grid.Column="1" Classes="link" FontSize="12" Content="History" VerticalAlignment="Center"
                                        Margin="0,-14" Command="{Binding ShowPointsHistoryCommand}"/>
                            </Grid>
                            <ProgressBar Classes="lvl" Minimum="0" Maximum="1" Value="{Binding LevelProgress}"/>
                            <TextBlock Text="{Binding LevelHint}" FontSize="12" Classes="muted"/>
                            <TextBlock Text="{Binding PointsNotice}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentInk}"
                                       IsVisible="{Binding PointsNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding PointsLostNotice}" FontSize="12" FontWeight="SemiBold" Classes="error"
                                       IsVisible="{Binding PointsLostNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Vacation (19c): away from the home city, on a phone. "Yes" opens the return-date sheet -->
            <Border Padding="16" CornerRadius="18" BorderThickness="1" Background="{DynamicResource IceTint}"
                    BorderBrush="{DynamicResource IceTintLine}" IsVisible="{Binding ShowAwayPrompt}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource IceText}" VerticalAlignment="Top">
                            <v:Icon Data="{StaticResource IcPlane}" Stroke="{DynamicResource OnInverse}" StrokeThickness="2.2"
                                    Width="20" Height="20"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding AwayTitle}" FontSize="18" FontWeight="ExtraBold"/>
                            <TextBlock Text="Looks like you're travelling. Put your streak on vacation and it stays frozen until you're back, for up to 7 days."
                                       FontSize="14" Classes="soft" TextWrapping="Wrap" IsVisible="{Binding !IsAwayBlocked}"/>
                            <TextBlock Text="{Binding Vacation.RefusalText}" FontSize="14" Classes="soft" TextWrapping="Wrap"
                                       IsVisible="{Binding IsAwayBlocked}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,1.3*" ColumnSpacing="10" IsVisible="{Binding !IsAwayBlocked}">
                        <Button Classes="btn outline" HorizontalAlignment="Stretch" MinHeight="48" FontSize="14"
                                Content="Not on vacation" Command="{Binding AwayNoCommand}"/>
                        <Button Grid.Column="1" Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="48" FontSize="14"
                                Content="Yes, freeze my streak" Command="{Binding AwayYesCommand}"/>
                    </Grid>
                    <Button Classes="btn outline small" MinHeight="40" HorizontalAlignment="Left" Content="Not now"
                            Command="{Binding AwayNotNowCommand}" IsVisible="{Binding IsAwayBlocked}"/>
                </StackPanel>
            </Border>

            <!-- Vacation (0.19.0): "Welcome back!" on the first normal day, or what I'm back just did -->
            <Border Padding="14,10,8,10" CornerRadius="14" BorderThickness="1" Background="{DynamicResource LimeTint}"
                    BorderBrush="{DynamicResource LimeTintLineStrong}"
                    IsVisible="{Binding VacationNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.6"
                            Width="18" Height="18" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding VacationNote}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="bare" Width="36" Height="36" Command="{Binding DismissVacationNoteCommand}"
                            AutomationProperties.Name="Dismiss">
                        <v:Icon Data="{StaticResource IcX}" Stroke="{DynamicResource Soft}" StrokeThickness="2.6" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Phones: once, after a workout stopped by itself at 4 hours or midnight (18b) -->
            <Border Padding="14" CornerRadius="14" BorderThickness="1" Background="{DynamicResource Surface2}"
                    BorderBrush="{DynamicResource Control}" Classes.bad="{Binding IsStopNoteBad}"
                    IsVisible="{Binding StopNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Border.Styles>
                    <Style Selector="Border.bad">
                        <Setter Property="Background" Value="{DynamicResource RedTint}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource RedTintLine}"/>
                    </Style>
                </Border.Styles>
                <TextBlock Text="{Binding StopNoteText}" FontSize="14" FontWeight="SemiBold"/>
            </Border>

            <!-- Phones: after End workout below half -->
            <Border Padding="14" CornerRadius="14" BorderBrush="{DynamicResource RedTintLine}" BorderThickness="1"
                    Background="{DynamicResource RedTint}" IsVisible="{Binding ShowEndedNote}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Workout ended without logging" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="Your sets are kept. Finish a workout today or tomorrow to keep your streak." FontSize="13" Classes="soft"/>
                </StackPanel>
            </Border>

            <!-- Sets logged, no check-in yet -->
            <Border Padding="18,14" CornerRadius="14" BorderBrush="{DynamicResource Control}" BorderThickness="1" Background="{DynamicResource Surface2}"
                    IsVisible="{Binding ShowSetsHint}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <v:Icon Data="{StaticResource IcClock}" Stroke="{DynamicResource Ink}" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="You logged sets today but haven't checked in yet." FontSize="14"
                               Classes="light" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="btn outline strong small" Content="Check in now"
                            Command="{Binding LogTodayCommand}" IsEnabled="{Binding CanLog}"/>
                </Grid>
            </Border>

            <!-- ===== Get set up: until the four first-time steps are done (a split and exercises for today unlock check-in) ===== -->
            <Border Classes="card setupCard">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="ShowSetup"/>
                        <Binding Path="ShowDashboard"/>
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Get set up" Classes="h2"/>
                            <TextBlock Classes="muted wideOnly" Text="A split and exercises for today's workout unlock your first check-in." FontSize="13"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SetupDoneText}" Classes="mono soft" FontSize="14"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar Classes="setup" Minimum="0" Maximum="1" Value="{Binding SetupProgress}"/>
                    <!-- Phones: one checklist with the next step open, instead of four cards two screens tall -->
                    <ItemsControl Classes="phoneOnly" ItemsSource="{Binding SetupSteps}" Margin="0,-8,0,-8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupStepViewModel">
                                <StackPanel>
                                    <Border Height="1" Background="{DynamicResource Divider}" IsVisible="{Binding HasDivider}"/>
                                    <Panel>
                                        <!-- The next step: its text and button -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,14" IsVisible="{Binding IsNext}">
                                            <Border Classes="setupBadge" BorderBrush="{DynamicResource AccentInk}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Number}" FontSize="13" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Text}" FontSize="13" Classes="soft" LineHeight="19" TextWrapping="Wrap"/>
                                                <Button Classes="btn primary" Content="{Binding Cta}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                        Command="{Binding OpenCommand}" IsEnabled="{Binding !IsLocked}"/>
                                            </StackPanel>
                                        </Grid>
                                        <!-- A later step: the row opens it, or shows a lock until the step before is done -->
                                        <Button Classes="setupRow" Command="{Binding OpenCommand}" IsEnabled="{Binding !IsLocked}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <Button.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="IsTodo"/>
                                                    <Binding Path="IsOther"/>
                                                </MultiBinding>
                                            </Button.IsVisible>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Classes="setupBadge" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Number}" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <v:Icon Grid.Column="2" Data="{StaticResource IcChevronRight}" Stroke="{DynamicResource Muted}" StrokeThickness="2.2"
                                                        Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding !IsLocked}"/>
                                                <v:Icon Grid.Column="2" Data="{StaticResource IcLock}" Stroke="{DynamicResource Muted}" StrokeThickness="2"
                                                        Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding IsLocked}"/>
                                            </Grid>
                                        </Button>
                                        <!-- Done: a check and what was set up -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" MinHeight="52" IsVisible="{Binding IsDone}">
                                            <Border Classes="setupBadge" BorderBrush="{DynamicResource AccentInk}" VerticalAlignment="Center">
                                                <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.8"
                                                        Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8">
                                                <TextBlock Text="{Binding Title}" FontSize="13" Classes="muted" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Result}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Panel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Classes="wideOnly" ItemsSource="{Binding SetupSteps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><v:ResponsiveGrid MinItemWidth="220" Spacing="14" Balanced="True"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupStepViewModel">
                                <Border Classes="setupStep" Classes.done="{Binding IsDone}" Classes.next="{Binding IsNext}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,10">
                                            <Border Classes="setupBadge" Classes.done="{Binding IsDone}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Number}" FontSize="13" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>

                                        <!-- Bottom: the button while to do, the result once done -->
                                        <Panel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                            <Button Classes="btn primary" Content="{Binding Cta}" HorizontalAlignment="Left"
                                                    Command="{Binding OpenCommand}" IsEnabled="{Binding !IsLocked}">
                                                <Button.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="IsTodo"/>
                                                        <Binding Path="IsNext"/>
                                                    </MultiBinding>
                                                </Button.IsVisible>
                                            </Button>
                                            <Button Classes="btn outline strong" Content="{Binding Cta}" HorizontalAlignment="Left"
                                                    Command="{Binding OpenCommand}" IsEnabled="{Binding !IsLocked}">
                                                <Button.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="IsTodo"/>
                                                        <Binding Path="IsOther"/>
                                                    </MultiBinding>
                                                </Button.IsVisible>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="44" IsVisible="{Binding IsDone}">
                                                <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.8"
                                                        Width="18" Height="18" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Result}" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Panel>

                                        <TextBlock Text="{Binding Text}" FontSize="13" Classes="soft" LineHeight="19" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Streak hero ===== -->
            <Border Classes="card heroCard">
                <Grid x:Name="Hero" ColumnDefinitions="*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                    <Panel x:Name="HeroLeft" VerticalAlignment="Center">
                        <StackPanel x:Name="HeroLeftStack" Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <v:Icon Data="{StaticResource IcFlame}" StrokeThickness="2.2"
                                        Classes="streakFlame" Classes.ice="{Binding IsStreakStale}"/>
                                <TextBlock Text="GYM STREAK" Classes="label" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Phones: the number, its caption and the two stats share one row, so the whole card
                                 (and the level card above it) fits on a small screen without scrolling -->
                            <Grid Classes="phoneOnly" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <TextBlock x:Name="StreakNumberPhone" Text="{Binding StreakCurrent}" FontWeight="Black"
                                           TextWrapping="NoWrap" VerticalAlignment="Center"
                                           Classes.ice="{Binding IsStreakStale}" Classes.zero="{Binding !StreakCurrent}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Style>
                                        <Style Selector="TextBlock.ice"><Setter Property="Foreground" Value="{DynamicResource IceText}"/></Style>
                                        <Style Selector="TextBlock.zero"><Setter Property="Foreground" Value="{DynamicResource Ghost}"/></Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="days" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="in a row" FontSize="14" FontWeight="Medium" Classes="muted"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="BEST STREAK" Classes="caps" FontSize="10"/>
                                        <TextBlock Text="{Binding BestStreakText}" Classes="mono" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="GYMS THIS MONTH" Classes="caps" FontSize="10"/>
                                        <TextBlock Text="{Binding GymsThisMonth}" Classes="mono" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Classes="wideOnly" Orientation="Horizontal" Spacing="14">
                                <TextBlock x:Name="StreakNumber" Text="{Binding StreakCurrent}" FontWeight="Black"
                                           TextWrapping="NoWrap" Classes.ice="{Binding IsStreakStale}"
                                           Classes.zero="{Binding !StreakCurrent}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Style>
                                        <Style Selector="TextBlock.ice"><Setter Property="Foreground" Value="{DynamicResource IceText}"/></Style>
                                        <Style Selector="TextBlock.zero"><Setter Property="Foreground" Value="{DynamicResource Ghost}"/></Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,10">
                                    <TextBlock Text="days" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="in a row" FontSize="16" FontWeight="Medium" Classes="muted"/>
                                </StackPanel>
                            </StackPanel>
                            <WrapPanel Classes="wideOnly" ItemSpacing="32" LineSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="BEST STREAK" Classes="caps"/>
                                    <TextBlock Text="{Binding BestStreakText}" Classes="mono" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="GYMS THIS MONTH" Classes="caps"/>
                                    <TextBlock Text="{Binding GymsThisMonth}" Classes="mono" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </WrapPanel>
                            <Border Classes="streakNote" Classes.urgent="{Binding StreakNoteIsUrgent}" Classes.ice="{Binding IsStreakStale}"
                                    IsVisible="{Binding StreakNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding StreakNote}" FontSize="14"/>
                            </Border>
                        </StackPanel>
                    </Panel>

                    <Panel x:Name="HeroRight">
                        <!-- Missed-day choice: the day after a missed training day, while a streak is at stake. Check-in waits for it. -->
                        <Panel IsVisible="{Binding HasMissedDay}">
                        <Panel DataContext="{Binding MissedDay}">
                            <StackPanel Spacing="16" x:DataType="vm:MissedDayViewModel">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="ExtraBold"/>
                                    <TextBlock Text="{Binding Subheading}" FontSize="14" Classes="soft"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MissedDayOptionViewModel">
                                            <Button Classes="option" Classes.selected="{Binding IsSelected}"
                                                    Command="{Binding ChooseCommand}">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Classes="pill tag" Classes.skip="{Binding IsSkip}">
                                                            <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="Bold"
                                                                       TextWrapping="NoWrap"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Preview}" FontSize="13" Classes="soft"/>
                                                    <ItemsControl ItemsSource="{Binding NewWeek}" IsVisible="{Binding HasNewWeek}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Background="{DynamicResource Fill3}" CornerRadius="6" Margin="2" Padding="2,4">
                                                                    <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold"
                                                                               TextAlignment="Center"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Notes}" IsVisible="{Binding HasNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" FontSize="12" Classes="muted"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="10" IsVisible="{Binding IsConfirming}">
                                    <TextBlock Text="{Binding ConfirmText}" FontSize="14" Classes="light"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                        <Button Classes="btn outline" Content="Cancel" Command="{Binding CancelCommand}"/>
                                        <Button Classes="btn primary" Content="Confirm choice" Command="{Binding ConfirmCommand}"
                                                IsEnabled="{Binding !IsBusy}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding Error}" Classes="error"
                                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Panel>
                        </Panel>

                        <!-- Today's gauge and check-in -->
                        <StackPanel x:Name="GaugeStack" Spacing="14" IsVisible="{Binding !HasMissedDay}" HorizontalAlignment="Center"
                                    MaxWidth="400">
                            <Viewbox x:Name="GaugeBox" Stretch="Uniform" HorizontalAlignment="Center">
                                <Grid Width="480" Height="260">
                                    <Canvas Width="480" Height="260">
                                        <Path Data="{StaticResource IcArc}" Stroke="{DynamicResource Fill2}" StrokeThickness="28" StrokeLineCap="Round"/>
                                        <!-- Rest day: a plain grey arc -->
                                        <Path Data="{StaticResource IcArc}" Stroke="{DynamicResource TrackStrong}" StrokeThickness="28" StrokeLineCap="Round"
                                              IsVisible="{Binding ShowRestArc}"/>
                                        <!-- Streak on ice (0.18.1): a rest day that didn't add to it, logged or not -->
                                        <Path Data="{StaticResource IcArc}" Stroke="{StaticResource IceBrush}" StrokeThickness="28"
                                              StrokeLineCap="Round" IsVisible="{Binding IsStreakStale}">
                                            <Path.Effect>
                                                <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="18" Color="#7040A8F5"/>
                                            </Path.Effect>
                                        </Path>
                                        <!-- Training day, not done: a cold arc (it fades out under the fire) -->
                                        <Path Data="{StaticResource IcArc}" Stroke="{StaticResource ColdBrush}" StrokeThickness="28"
                                              StrokeLineCap="Round" Opacity="0.85"
                                              IsVisible="{Binding ShowColdArc}" Classes.coldFade="{Binding IsDone}"/>
                                        <!-- Done: on fire -->
                                        <Path Data="{StaticResource IcArc}" Stroke="{StaticResource FireBrush}" StrokeThickness="28"
                                              StrokeLineCap="Round" StrokeDashArray="23,30"
                                              IsVisible="{Binding ShowFireArc}" Classes.fire="{Binding ShowFireArc}">
                                            <Path.Effect>
                                                <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="18" Color="#8CFF5A00"/>
                                            </Path.Effect>
                                        </Path>
                                        <!-- Phones (Phase 18): the fire fills with the share of exercises done. The same circle
                                             as IcArc (radius 200 around 240,240); Arc insets its box by half the stroke -->
                                        <Arc Canvas.Left="26" Canvas.Top="26" Width="428" Height="428" StartAngle="180"
                                             SweepAngle="{Binding ProgressSweep}" Stroke="{StaticResource FireBrush}"
                                             StrokeThickness="28" StrokeLineCap="Round" IsVisible="{Binding IsArcHot}">
                                            <Arc.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="SweepAngle" Duration="0:0:0.7" Easing="CubicEaseInOut"/>
                                                </Transitions>
                                            </Arc.Transitions>
                                            <Arc.Effect>
                                                <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="18" Color="#8CFF5A00"/>
                                            </Arc.Effect>
                                        </Arc>
                                    </Canvas>
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4" Margin="0,0,0,6">
                                        <TextBlock x:Name="GaugeKicker" Text="{Binding GaugeKicker}" FontWeight="SemiBold" LetterSpacing="2.4"
                                                   HorizontalAlignment="Center" Classes="muted" Classes.makeUp="{Binding IsMakeUpDay}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.makeUp"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
                                            </TextBlock.Styles>
                                        </TextBlock>
                                        <Viewbox StretchDirection="DownOnly" MaxWidth="330" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding GaugeTitle}" Classes="gaugeTitle" FontWeight="Black"
                                                       LetterSpacing="1.5" TextWrapping="NoWrap"
                                                       Classes.rest="{Binding IsRestOpen}" Classes.hot="{Binding IsTitleHot}"
                                                       Classes.ice="{Binding IsStreakStale}"/>
                                        </Viewbox>
                                        <TextBlock x:Name="GaugeSub" Text="{Binding GaugeSub}" Classes="soft" HorizontalAlignment="Center"
                                                   TextAlignment="Center" MaxWidth="420"/>
                                    </StackPanel>
                                </Grid>
                            </Viewbox>

                            <Border Padding="18,14" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    IsVisible="{Binding HasCheckIn}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="14" Classes="light"/>
                                        <!-- Today's log only: works until midnight, then the log is read-only -->
                                        <StackPanel Orientation="Horizontal" Spacing="0"
                                                    IsVisible="{Binding TodayGymName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock FontSize="12" Classes="muted" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="220">
                                                <Run Text="at "/><Run Text="{Binding TodayGymName}"/><Run Text=" · "/>
                                            </TextBlock>
                                            <Button Classes="link" FontSize="12" Content="Change gym" Command="{Binding ChooseGymCommand}"/>
                                        </StackPanel>
                                        <Button Classes="link" FontSize="12" Content="Add gym" Command="{Binding ChooseGymCommand}"
                                                IsVisible="{Binding ShowAddGym}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="btn" Classes.primary="{Binding IsTrainingOpen}"
                                                Classes.outline="{Binding !IsTrainingOpen}" Classes.strong="{Binding IsRestOpen}"
                                                Classes.logged="{Binding IsDone}"
                                                Content="{Binding LogLabel}" Command="{Binding LogTodayCommand}"
                                                IsEnabled="{Binding CanLog}"/>
                                        <!-- Today only: undo the check-in (the sets stay) -->
                                        <Button Classes="btn outline" Padding="14,0" FontSize="13" Foreground="{DynamicResource Soft}"
                                                Content="Undo" Command="{Binding StartUndoCommand}" IsVisible="{Binding CanUndo}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Live workout (18c): verified at a gym, or why not -->
                            <Panel IsVisible="{Binding IsLive}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center" DataContext="{Binding Live}"
                                            x:DataType="vm:LiveWorkoutCardViewModel">
                                    <Border Classes="pill" HorizontalAlignment="Center" Padding="12,6" Background="{DynamicResource LimeTint}"
                                            BorderBrush="{DynamicResource LimeTintLineStrong}"
                                            IsVisible="{Binding VerifiedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <v:Icon Data="{StaticResource IcPin}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.4"
                                                    Width="15" Height="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding VerifiedText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="2" IsVisible="{Binding IsNotAtGym}">
                                        <TextBlock Text="You're not at one of your gyms. This workout won't be verified." FontSize="13"
                                                   Classes="soft" TextAlignment="Center" HorizontalAlignment="Center"/>
                                        <Button Classes="link" FontSize="13" MinHeight="32" HorizontalAlignment="Center" Content="Add this gym"
                                                Command="{Binding AddThisGymCommand}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2" IsVisible="{Binding IsLocationOff}">
                                        <TextBlock Text="Location is off, so this workout can't be verified." FontSize="13"
                                                   Classes="soft" TextAlignment="Center" HorizontalAlignment="Center"/>
                                        <Button Classes="link" FontSize="13" MinHeight="32" HorizontalAlignment="Center" Content="Open Settings"
                                                Command="{Binding OpenLocationSettingsCommand}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2" IsVisible="{Binding IsPreciseOff}">
                                        <TextBlock Text="Turn on precise location to verify your workouts. Your location stays on your phone."
                                                   FontSize="13" Classes="soft" TextAlignment="Center" HorizontalAlignment="Center"/>
                                        <Button Classes="link" FontSize="13" MinHeight="32" HorizontalAlignment="Center" Content="Open Settings"
                                                Command="{Binding OpenLocationSettingsCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="Couldn't find your location yet. It's checked again with each set." FontSize="12"
                                               Classes="muted" TextAlignment="Center" HorizontalAlignment="Center"
                                               IsVisible="{Binding IsLocationPending}"/>
                                </StackPanel>
                            </Panel>

                            <!-- Phones (Phase 18): Start workout before, the result and Undo after -->
                            <StackPanel Spacing="12" IsVisible="{Binding ShowStartRow}">
                                <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <!-- On vacation (19d): the gyms here lead, Start workout follows -->
                                <Button Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="52" FontSize="16"
                                        Command="{Binding ShowGymsNearMeCommand}" IsVisible="{Binding ShowNearbyGyms}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <v:Icon Data="{StaticResource IcPin}" Stroke="Black" StrokeThickness="2.4"
                                                Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="Show me gyms near me" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="btn" Classes.primary="{Binding !ShowNearbyGyms}" Classes.outline="{Binding ShowNearbyGyms}"
                                        Classes.strong="{Binding ShowNearbyGyms}" HorizontalAlignment="Stretch" MinHeight="52" FontSize="16"
                                        Content="{Binding StartLabel}" Command="{Binding StartWorkoutCommand}" IsVisible="{Binding CanStart}"/>
                                <!-- No "Pick a split" here: with no split the Get set up card above is showing, and its first step is that button -->
                                <Button Classes="btn outline strong" HorizontalAlignment="Stretch" MinHeight="52" FontSize="16"
                                        Content="Build a workout" Command="{Binding ShowWorkoutsCommand}" IsVisible="{Binding ShowBuildWorkout}"/>
                            </StackPanel>
                            <StackPanel Spacing="12" IsVisible="{Binding ShowDoneRow}">
                                <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <Border Classes="pill" HorizontalAlignment="Center" Background="{DynamicResource Fill}" BorderThickness="0"
                                        Padding="12,4" IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding ResultText}" Classes="mono" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentInk}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            IsVisible="{Binding TodayGymName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock FontSize="12" Classes="muted" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="220">
                                        <Run Text="at "/><Run Text="{Binding TodayGymName}"/><Run Text=" · "/>
                                    </TextBlock>
                                    <Button Classes="link" FontSize="12" Content="Change gym" Command="{Binding ChooseGymCommand}"/>
                                </StackPanel>
                                <Button Classes="link" FontSize="12" Content="Add gym" Command="{Binding ChooseGymCommand}"
                                        HorizontalAlignment="Center" IsVisible="{Binding ShowAddGym}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Button Classes="btn outline logged" HorizontalAlignment="Stretch" MinHeight="52" FontSize="16"
                                            Content="Logged ✓" IsEnabled="False"/>
                                    <Button Grid.Column="1" Classes="btn outline" MinHeight="52" Padding="18,0" FontSize="15"
                                            Foreground="{DynamicResource Soft}" Content="Undo" Command="{Binding StartUndoCommand}"
                                            IsVisible="{Binding CanUndo}"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="{Binding GymNotice}" FontSize="12" Classes="muted"
                                       IsVisible="{Binding GymNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- Vacation (0.19.0): end it early, or cancel one that starts tomorrow -->
                            <Button Classes="link" FontSize="13" MinHeight="40" HorizontalAlignment="Center"
                                    Content="{Binding Vacation.EndLabel}" Command="{Binding Vacation.AskEndCommand}"
                                    IsVisible="{Binding ShowImBack}"/>
                        </StackPanel>
                    </Panel>
                </Grid>
            </Border>

            <!-- ===== The live workout (Phase 18, phones): right under the streak card, the rest of Home hidden ===== -->
            <Border Classes="card" Padding="16" IsVisible="{Binding IsLive}">
                <ContentControl Content="{Binding Live}"/>
            </Border>
            <TextBlock Text="Calories, PRs and friends come back when the workout ends." FontSize="12" Classes="faint"
                       Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" TextAlignment="Center"
                       IsVisible="{Binding IsLive}"/>

            <!-- ===== The cardio timer after a workout (0.18.2, phones): under the streak card ===== -->
            <Border Classes="card" Padding="16" BorderBrush="{DynamicResource LimeTintLineStrong}" IsVisible="{Binding IsCardio}">
                <ContentControl Content="{Binding Cardio}"/>
            </Border>

            <!-- ===== This week ===== -->
            <Border Classes="card weekCard" DataContext="{Binding Week}" IsVisible="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ShowDashboard}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="14"
                      x:DataType="vm:WeekCardViewModel">
                        <TextBlock Classes="weekTitle" Text="This week" FontWeight="Bold" VerticalAlignment="Center"/>
                        <WrapPanel x:Name="WeekLegend" ItemSpacing="14" LineSpacing="4" VerticalAlignment="Center">
                            <WrapPanel.Styles>
                                <Style Selector="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
                            </WrapPanel.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="3" Width="13" Height="13"/>
                                <TextBlock Text="Done"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <v:Icon Data="{StaticResource IcMadeUp}" Stroke="{DynamicResource Ink}" StrokeThickness="2.6" Width="13" Height="13"/>
                                <TextBlock Text="Made up"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <v:Icon Data="{StaticResource IcX}" Stroke="{DynamicResource MissRed}" StrokeThickness="3" Width="13" Height="13"/>
                                <TextBlock Text="Missed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="2" Background="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Text="Rest"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="3" BorderBrush="{DynamicResource Faint}" BorderThickness="1" VerticalAlignment="Center"/>
                                <TextBlock Text="Upcoming"/>
                            </StackPanel>
                            <!-- Only in a week with vacation days (0.19.0) -->
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasVacation}">
                                <v:Icon Data="{StaticResource IcMoon}" Stroke="{DynamicResource IceText}" StrokeThickness="2.4"
                                        Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Vacation"/>
                            </StackPanel>
                        </WrapPanel>
                    <ItemsControl x:Name="WeekTiles" Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeekChipViewModel">
                                <Border Classes="tile" Classes.rest="{Binding IsRest}" Classes.missed="{Binding IsMissed}"
                                        Classes.upcoming="{Binding IsUpcoming}" Classes.todayOpen="{Binding IsTodayOpen}"
                                        Classes.todayDone="{Binding IsTodayDone}" Classes.vacation="{Binding IsVacation}"
                                        Classes.today="{Binding IsToday}" ToolTip.Tip="{Binding Tip}">
                                    <StackPanel Spacing="6" VerticalAlignment="Center">
                                        <!-- Phones: the day over its mark, so a 360 px row of seven fits -->
                                        <v:PhoneGrid ColumnDefinitions="*,Auto" MinHeight="16" PhoneStack="True" PhoneStackSpacing="2">
                                            <TextBlock Text="{Binding Day}" FontSize="11" FontWeight="SemiBold" Opacity="0.75"
                                                       VerticalAlignment="Center"/>
                                            <Panel Grid.Column="1">
                                                <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="3"
                                                        Width="14" Height="14" IsVisible="{Binding IsDone}"/>
                                                <v:Icon Data="{StaticResource IcMadeUp}" Stroke="{DynamicResource Ink}" StrokeThickness="2.6"
                                                        Width="14" Height="14" IsVisible="{Binding IsMadeUp}"/>
                                                <v:Icon Data="{StaticResource IcX}" Stroke="{DynamicResource MissRed}" StrokeThickness="3"
                                                        Width="14" Height="14" IsVisible="{Binding IsMissed}"/>
                                                <v:Icon Data="{StaticResource IcMoon}" Stroke="{DynamicResource IceText}" StrokeThickness="2.4"
                                                        Width="13" Height="13" IsVisible="{Binding IsVacation}"/>
                                            </Panel>
                                        </v:PhoneGrid>
                                        <TextBlock Classes="tileName" Text="{Binding Name}" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ===== Cards: two columns, one when narrow (HomeView.axaml.cs sets ItemWidth) ===== -->
            <WrapPanel x:Name="Cards" IsVisible="{Binding ShowDashboard}">

                <!-- Today's workout: the same plan as the check-in -->
                <Border Classes="card" DataContext="{Binding TodayWorkout}">
                    <StackPanel Spacing="16" x:DataType="vm:TodayWorkoutCardViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Today's workout" Classes="h2"/>
                                <TextBlock Text="{Binding Title}" FontSize="13" Classes="muted"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="link" FontSize="14" Content="Open workouts" VerticalAlignment="Center"
                                    Command="{Binding BuildWorkoutCommand}" IsVisible="{Binding HasExercises}"/>
                        </Grid>
                        <Panel Classes="wideOnly">
                        <StackPanel IsVisible="{Binding HasExercises}" Grid.IsSharedSizeScope="True">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Sets"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Last"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Exercise" FontSize="12" Classes="muted"/>
                                <TextBlock Grid.Column="1" Text="Sets" FontSize="12" Classes="muted" Margin="20,0"/>
                                <TextBlock Grid.Column="2" Text="Last top set" FontSize="12" Classes="muted" TextAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Exercises}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TodayExerciseViewModel">
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Sets"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Last"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Sets}" FontSize="14" Classes="mono soft"
                                                           Margin="20,0" ToolTip.Tip="Warm-up + working sets"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LastTime}" FontSize="14" Classes="mono soft"
                                                           TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Panel>
                        <!-- Phones (the canvas): a row each, the plan under the name, the last top set on the right -->
                        <Panel Classes="phoneOnly">
                        <ItemsControl ItemsSource="{Binding Exercises}" IsVisible="{Binding HasExercises}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TodayExerciseViewModel">
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" MinHeight="56">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Plan}" FontSize="12" Classes="muted"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding LastTime}" FontSize="13" FontWeight="Bold" Classes="mono soft"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Panel>
                        <Border MinHeight="140" CornerRadius="14" BorderBrush="{DynamicResource Control}" BorderThickness="1" Padding="20"
                                IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EmptyText}" FontSize="14" Classes="soft" TextAlignment="Center"/>
                                <Button Classes="btn outline small" Content="Build a workout" HorizontalAlignment="Center"
                                        Command="{Binding BuildWorkoutCommand}" IsVisible="{Binding ShowBuildLink}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Calories today -->
                <Border x:Name="CaloriesCard" Classes="card" IsVisible="{Binding !HasFoodLog}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Calories today" Classes="h2" VerticalAlignment="Center"/>
                                <Panel Classes="wideOnly">
                                    <Border Classes="pill" IsVisible="{Binding CalorieGoalType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding CalorieGoalType}" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                                    </Border>
                                </Panel>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="link wideOnly" FontSize="14" Content="Goal &amp; history" VerticalAlignment="Center"
                                    Command="{Binding ShowCaloriesCommand}"/>
                            <!-- Phones (the canvas): the goal chip on the right opens Calories -->
                            <Button Grid.Column="1" Classes="goalChip phoneOnly" Command="{Binding ShowCaloriesCommand}"
                                    Content="{Binding CalorieGoalType, TargetNullValue='Set a goal'}"
                                    AutomationProperties.Name="Calorie goal and history"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="22">
                            <Grid Width="126" Height="126" ToolTip.Tip="{Binding CaloriesTitle}">
                                <Ellipse Stroke="{DynamicResource Line}" StrokeThickness="12"/>
                                <Arc StartAngle="-90" SweepAngle="{Binding CaloriesSweep}" Stroke="{DynamicResource Ink}" StrokeThickness="12"
                                     Classes.hit="{Binding CaloriesHit}">
                                    <Arc.Styles>
                                        <Style Selector="Arc.hit"><Setter Property="Stroke" Value="{DynamicResource AccentInk}"/></Style>
                                    </Arc.Styles>
                                </Arc>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding CaloriesCenter}" Classes="mono" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CaloriesCenterSub}" FontSize="11" Classes="soft" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CaloriesTitle}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CaloriesHint}" FontSize="13" Classes="soft" LineHeight="19"/>
                                <TextBlock Text="{Binding GoalReviewHint}" FontSize="12" Foreground="{DynamicResource Warn}"
                                           IsVisible="{Binding GoalReviewHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8" IsVisible="{Binding ShowCaloriesForm}">
                            <TextBlock Text="Eaten today (kcal)" FontSize="12" Classes="muted"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBox TextInputOptions.ContentType="Digits" Classes="kcal" PlaceholderText="e.g. 1900" Text="{Binding CaloriesInput}"/>
                                <Button Grid.Column="1" Classes="btn outline" Content="Cancel" Command="{Binding CancelEditCaloriesCommand}"
                                        IsVisible="{Binding IsEditingCalories}"/>
                                <Button Grid.Column="2" Classes="btn light" Content="{Binding LogCaloriesLabel}"
                                        Command="{Binding LogCaloriesCommand}" IsDefault="False"/>
                            </Grid>
                            <TextBlock Classes="fieldError" Text="{Binding CaloriesError}"
                                       IsVisible="{Binding CaloriesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding CaloriesTip}" FontSize="12" Classes="muted"
                                       IsVisible="{Binding CaloriesTip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <Border Padding="14,12" CornerRadius="12" Background="{DynamicResource Surface2}" IsVisible="{Binding ShowCaloriesResult}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{Binding CaloriesResult}" FontSize="14" Classes="light" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="btn outline small" Content="Edit" Command="{Binding EditCaloriesCommand}"
                                        IsVisible="{Binding !HasFoodLog}"/>
                            </Grid>
                        </Border>
                        <!-- Phones (Phase 26): the button is Add food; the typed number is Quick add on its sheet -->
                        <Button Classes="btn light" MinHeight="50" Content="Add food" Command="{Binding AddFoodCommand}"
                                IsVisible="{Binding HasFoodLog}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Phones (Phase 27): the Calories screen's card, with Manage food; the goal chip opens Calories -->
                <Border Classes="card" IsVisible="{Binding HasFoodLog}">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="Calories" FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Classes="status" Classes.off="{Binding TodayCard.IsUnder}" Classes.over="{Binding TodayCard.IsOver}" Classes.hit="{Binding TodayCard.IsHit}"
                                    Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TodayCard.StatusText}" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <Button Grid.Column="2" Classes="goalChip" Command="{Binding ShowCaloriesCommand}"
                                    Content="{Binding CalorieGoalType, TargetNullValue='Set a goal'}"
                                    AutomationProperties.Name="Calorie goal and history"/>
                        </Grid>
                        <v:TodayCaloriesCard DataContext="{Binding TodayCard}"/>
                        <Button Classes="btn light" MinHeight="50" Content="Manage food" Command="{Binding AddFoodCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Recent PRs (hidden when there are none) -->
                <Border Classes="card" IsVisible="{Binding RecentPrs.HasAny}">
                    <Panel DataContext="{Binding RecentPrs}">
                    <StackPanel Spacing="12" x:DataType="vm:RecentPrsCardViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Recent PRs" Classes="h2"/>
                            <v:Icon Grid.Column="1" Data="{StaticResource IcTrophy}" Stroke="{DynamicResource AccentInk}" Width="22" Height="22"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentPrViewModel">
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" MinHeight="48">
                                        <Panel VerticalAlignment="Center">
                                        <Grid Classes="wideOnly" ColumnDefinitions="*,Auto,52" ColumnSpacing="16">
                                            <TextBlock Text="{Binding Exercise}" FontWeight="SemiBold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="14"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Date}" Classes="muted" FontSize="14"
                                                       TextAlignment="Right" TextWrapping="NoWrap"/>
                                        </Grid>
                                        <!-- Phones (the canvas): the set in lime over its date, on the right -->
                                        <Grid Classes="phoneOnly" ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="52">
                                            <TextBlock Text="{Binding Exercise}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Value}" Classes="mono" FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Date}" Classes="muted" FontSize="11" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                        </Panel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </Panel>
                </Border>

                <!-- Friends: this week's (or all-time) board -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Friends" Classes="h2" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Padding="3" CornerRadius="10" Background="{DynamicResource Fill}" IsVisible="{Binding HasFriends}">
                                <v:SegmentedPill SelectedIndex="{Binding IsAllTime, Converter={x:Static v:SegmentedPill.BoolToIndex}}"
                                                 PillCornerRadius="8" PillInset="0">
                                    <Button Classes="seg" Classes.on="{Binding IsThisWeek}" MinHeight="32" Padding="12,0" FontSize="12"
                                            CornerRadius="8" Content="This week" Command="{Binding ShowBoardWeekCommand}"/>
                                    <Button Classes="seg" Classes.on="{Binding IsAllTime}" MinHeight="32" Padding="12,0" FontSize="12"
                                            CornerRadius="8" Content="All time" Command="{Binding ShowBoardAllTimeCommand}"/>
                                </v:SegmentedPill>
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Board}" IsVisible="{Binding HasFriends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BoardRowViewModel">
                                    <Border Classes="boardRow" Classes.you="{Binding IsYou}" MinHeight="52" Padding="10,0" CornerRadius="10">
                                        <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Rank}" Classes="mono muted" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                                                ToolTip.Tip="Current streak">
                                                        <v:Icon Data="{StaticResource IcFlame}" Stroke="{DynamicResource Flame}"
                                                                StrokeThickness="2.4" Width="12" Height="12"/>
                                                        <TextBlock Text="{Binding Streak}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Flame}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Level}" FontSize="12" Classes="muted"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Points}" Classes="mono" FontWeight="Bold" FontSize="14"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding FriendsTitle}" FontSize="13" Classes="muted"/>
                        <TextBlock Text="{Binding FriendsStale}" FontSize="12" Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding FriendsStale, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.ColumnSpan="2" Classes="btn outline small" HorizontalAlignment="Stretch"
                                    Command="{Binding ShowFriendsCommand}" IsVisible="{Binding !HasFriends}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <v:Icon Data="{StaticResource IcPlus}" StrokeThickness="2.4" Width="14" Height="14"/>
                                    <TextBlock Text="Add friends" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="btn outline small" HorizontalAlignment="Stretch"
                                    Command="{Binding ShowFriendsCommand}" IsVisible="{Binding HasFriends}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <v:Icon Data="{StaticResource IcPlus}" StrokeThickness="2.4" Width="14" Height="14"/>
                                    <TextBlock Text="Add friends" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="btn outline small" HorizontalAlignment="Stretch" Content="Full leaderboard"
                                    Command="{Binding ShowLeaderboardCommand}" IsVisible="{Binding HasFriends}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <!-- Check-in popup over Home -->
    <Border Classes="scrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsCheckingIn}" Padding="16">
        <ContentControl Content="{Binding CheckIn}"/>
    </Border>

    <!-- Live workout (Phase 18): Finish, pushing for the whole workout. Cardio is timed after it (0.18.2) -->
    <Border Classes="scrim" Background="{DynamicResource Scrim}" Padding="24"
            IsVisible="{Binding Live.IsFinishOpen, FallbackValue=False}">
        <v:Sheet Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Live}"
                 Padding="20,20,20,28" CornerRadius="18" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <StackPanel Spacing="12" x:DataType="vm:LiveWorkoutCardViewModel">
                <TextBlock Text="{Binding FinishTitle}" FontSize="22" FontWeight="ExtraBold"/>
                <TextBlock Text="{Binding FinishText}" FontSize="14" Classes="soft"/>
                <TextBlock Classes="error" Text="{Binding SheetError}"
                           IsVisible="{Binding SheetError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="10" Margin="0,4,0,0" IsVisible="{Binding FinishPartial}">
                    <Button Classes="btn outline" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15" Content="Finish anyway"
                            Command="{Binding FinishCommand}" IsEnabled="{Binding !IsSaving}"/>
                    <Button Grid.Column="1" Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15"
                            Content="Keep going" Command="{Binding CloseSheetCommand}"/>
                </Grid>
                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="10" Margin="0,4,0,0" IsVisible="{Binding !FinishPartial}">
                    <Button Classes="btn outline" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15" Content="Back"
                            Command="{Binding CloseSheetCommand}"/>
                    <Button Grid.Column="1" Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15"
                            Content="Finish workout" Command="{Binding FinishCommand}" IsEnabled="{Binding !IsSaving}"/>
                </Grid>
            </StackPanel>
        </v:Sheet>
    </Border>

    <!-- Cardio after a workout (0.18.2): right after Finish, over the whole page -->
    <Border Background="{DynamicResource PageBg}" Padding="24" IsVisible="{Binding IsCardioPromptOpen}">
        <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
            <Border Width="76" Height="76" CornerRadius="38" HorizontalAlignment="Center"
                    Background="{DynamicResource LimeTint}" BorderBrush="{DynamicResource LimeTintLineStrong}" BorderThickness="1">
                <v:Icon Data="{StaticResource IcHeart}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.2" Width="34" Height="34"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Nice work" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,18,0,6"/>
            <TextBlock Text="Continue with a cardio session?" FontSize="15" Classes="soft" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,18,0,8">
                <StackPanel.Styles>
                    <Style Selector="Border.pts">
                        <Setter Property="CornerRadius" Value="99"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource LimeTintLine}"/>
                    </Style>
                    <Style Selector="Border.pts > TextBlock">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
                    </Style>
                </StackPanel.Styles>
                <Border Classes="pts"><TextBlock Classes="mono" Text="10 min +1"/></Border>
                <Border Classes="pts"><TextBlock Classes="mono" Text="20 +2"/></Border>
                <Border Classes="pts"><TextBlock Classes="mono" Text="30 +3"/></Border>
            </StackPanel>
            <TextBlock Text="A timer runs on Home. At your gym, it pauses if you leave." FontSize="12" Classes="muted"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,22"/>
            <TextBlock Classes="error" Text="{Binding CardioPromptError}" Margin="0,0,0,10"
                       IsVisible="{Binding CardioPromptError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Button Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="54" FontSize="16"
                    Content="Continue with cardio" Command="{Binding StartCardioCommand}"/>
            <Button Classes="btn link" HorizontalAlignment="Center" Margin="0,14,0,0" Content="Skip"
                    Command="{Binding SkipCardioCommand}"/>
        </StackPanel>
    </Border>

    <!-- Live workout: End without logging, below half -->
    <Border Classes="scrim" Background="{DynamicResource Scrim}" Padding="24"
            IsVisible="{Binding Live.IsEndOpen, FallbackValue=False}">
        <v:Sheet Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Live}"
                 Padding="20,20,20,28" CornerRadius="18" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <StackPanel Spacing="10" x:DataType="vm:LiveWorkoutCardViewModel">
                <TextBlock Text="End without logging?" FontSize="22" FontWeight="ExtraBold"/>
                <TextBlock Text="Your sets are kept, but this workout won't count and earns no points." FontSize="14" Classes="soft"/>
                <TextBlock Text="Your streak is at risk unless you finish a workout today or tomorrow." FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ErrorText}"/>
                <TextBlock Classes="error" Text="{Binding SheetError}"
                           IsVisible="{Binding SheetError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="10" Margin="0,6,0,0">
                    <Button Classes="btn outline" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15" Content="End workout"
                            BorderBrush="{DynamicResource ErrorText}" Foreground="{DynamicResource ErrorText}"
                            Command="{Binding EndCommand}" IsEnabled="{Binding !IsSaving}"/>
                    <Button Grid.Column="1" Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15"
                            Content="Keep going" Command="{Binding CloseSheetCommand}"/>
                </Grid>
            </StackPanel>
        </v:Sheet>
    </Border>

    <!-- Vacation (19c): "Going away?", the return date, from the away prompt -->
    <Border Classes="scrim" Background="{DynamicResource Scrim}" Padding="24" IsVisible="{Binding Vacation.IsSheetOpen}">
        <v:Sheet Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Padding="20,20,20,28" CornerRadius="18" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <ContentControl Content="{Binding Vacation.Sheet}"/>
        </v:Sheet>
    </Border>

    <!-- Vacation (0.19.0): I'm back asks first -->
    <Border Classes="scrim" Background="{DynamicResource Scrim}" Padding="24" IsVisible="{Binding Vacation.IsConfirmingEnd}">
        <v:Sheet Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Vacation}"
                 x:DataType="vm:VacationCardViewModel"
                 Padding="20,20,20,28" CornerRadius="18" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding EndTitle}" FontSize="22" FontWeight="ExtraBold"/>
                <TextBlock Text="{Binding EndText}" FontSize="14" Classes="soft" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Error}" FontSize="13" Classes="error" TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="10" Margin="0,6,0,0">
                    <Button Classes="btn outline" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15" Content="Keep it"
                            Command="{Binding KeepVacationCommand}"/>
                    <Button Grid.Column="1" Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15"
                            Content="{Binding EndButton}" Command="{Binding EndCommand}"/>
                </Grid>
            </StackPanel>
        </v:Sheet>
    </Border>

    <!-- Live workout: back after 12 minutes or more away (18b) -->
    <Border Classes="scrim" Background="{DynamicResource Scrim}" Padding="24" IsVisible="{Binding IsReturnOpen}">
        <v:Sheet Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Padding="20,20,20,28" CornerRadius="18" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Continue your workout?" FontSize="22" FontWeight="ExtraBold"/>
                <TextBlock Text="{Binding ReturnText}" FontSize="14" Classes="soft"/>
                <TextBlock Text="{Binding ReturnWarning}" FontSize="14" Classes="soft" Classes.bad="{Binding IsReturnWarningBad}"
                           IsVisible="{Binding ReturnWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock.bad"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></Style>
                    </TextBlock.Styles>
                </TextBlock>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                    <Button Classes="btn outline" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15" Content="Finish workout early"
                            Command="{Binding FinishEarlyCommand}"/>
                    <Button Grid.Column="1" Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15"
                            Content="Continue" Command="{Binding ContinueWorkoutCommand}"/>
                </Grid>
            </StackPanel>
        </v:Sheet>
    </Border>

    <!-- Android, before its location prompt (which shows no word from the app): why GainStreak asks (18c) -->
    <Border Classes="scrim" Background="{DynamicResource Scrim}" Padding="24" IsVisible="{Binding IsLocationNoteOpen}">
        <v:Sheet Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Padding="20,20,20,28" CornerRadius="18" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <StackPanel Spacing="10">
                <v:Icon Data="{StaticResource IcPin}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.2" Width="28" Height="28"
                        HorizontalAlignment="Left"/>
                <TextBlock Text="Verify your workouts" FontSize="22" FontWeight="ExtraBold"/>
                <TextBlock Text="GainStreak checks that you're at one of your gyms during a workout and notices when you're travelling. Your location stays on your phone unless you ask for gyms near you."
                           FontSize="14" Classes="soft"/>
                <TextBlock Text="Pick Precise when your phone asks: approximate location can't tell which gym you're at."
                           FontSize="13" Classes="muted"/>
                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="10" Margin="0,6,0,0">
                    <Button Classes="btn outline" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15" Content="Not now"
                            Command="{Binding LocationNoteNotNowCommand}"/>
                    <Button Grid.Column="1" Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15"
                            Content="Continue" Command="{Binding LocationNoteContinueCommand}"/>
                </Grid>
            </StackPanel>
        </v:Sheet>
    </Border>

    <!-- Start workout anyway, on a rest day (0.18.1, option B of the GainStreak Mobile canvas): pick any exercises.
         A sheet over most of the screen on phones; search, Recent and muscle group chips, the picks in a tray -->
    <Border Classes="scrim" Background="{DynamicResource Scrim}" Padding="24" IsVisible="{Binding IsPicking}">
        <Border.Styles>
            <Style Selector="Button.pchip">
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="CornerRadius" Value="999"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Light}"/>
            </Style>
            <Style Selector="Button.pchip.on">
                <Setter Property="Background" Value="{DynamicResource Inverse}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
            </Style>
            <Style Selector="Button.pchip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Inverse}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnInverse}"/>
            </Style>
            <Style Selector="Button.pickRow">
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource PageBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            </Style>
            <Style Selector="Button.pickRow.on">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
            </Style>
            <Style Selector="Border.pickBox">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrong}"/>
            </Style>
            <Style Selector="Border.pickBox.on">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Style>
            <Style Selector="TextBox.pfield">
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="{DynamicResource PageBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="40,0,14,0"/>
            </Style>
        </Border.Styles>
        <v:Sheet Width="480" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Padding="20,18,20,24" CornerRadius="18" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <Panel DataContext="{Binding Picker}">
            <DockPanel x:DataType="vm:RestDayPickerViewModel">
                <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Pick exercises" FontSize="22" FontWeight="ExtraBold"/>
                            <TextBlock Text="It's a rest day, so train whatever you like." FontSize="13" Classes="soft"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="btn outline" Padding="0" Width="44" MinHeight="44" VerticalAlignment="Top"
                                Command="{Binding CancelCommand}" AutomationProperties.Name="Close">
                            <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.4" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                    <Panel>
                        <TextBox Classes="pfield" PlaceholderText="Search exercises" Text="{Binding Search}"
                                 AutomationProperties.Name="Search exercises"/>
                        <v:Icon Data="{StaticResource IcSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="2.2"
                                Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    </Panel>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Filters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RestDayPickFilter">
                                    <Button Classes="pchip" Classes.on="{Binding IsSelected}" Content="{Binding Label}"
                                            Command="{Binding $parent[ItemsControl].((vm:RestDayPickerViewModel)DataContext).SelectFilterCommand}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
                    <!-- The picks, in the order picked -->
                    <Border CornerRadius="12" Background="{DynamicResource Fill}" Padding="12,10" IsVisible="{Binding HasPicks}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{Binding PickedCount}" Classes="mono" FontWeight="Bold" FontSize="15"
                                       Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding PickedText}" FontSize="13" Classes="soft"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <v:Icon Data="{StaticResource IcFlame}" Stroke="{DynamicResource Ice}" StrokeThickness="2.2" Width="14" Height="14"/>
                        <TextBlock Text="At your gym, this adds a day to your streak" FontSize="12" Foreground="{DynamicResource IceText}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap"
                               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Button Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="50" Content="{Binding StartLabel}"
                            Command="{Binding StartCommand}" IsEnabled="{Binding !IsBusy}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Room on the right for the scroll bar, so it never covers the last sets -->
                    <StackPanel Spacing="16" Margin="0,0,12,0">
                        <TextBlock Text="No exercises match." FontSize="14" Classes="muted" IsVisible="{Binding NoResults}"/>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="16"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RestDayPickGroup">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" LetterSpacing="1.2" Classes="muted"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RestDayPickItem">
                                                    <Button Classes="pickRow" Classes.on="{Binding IsSelected}" Command="{Binding ToggleCommand}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                            <Border Classes="pickBox" Classes.on="{Binding IsSelected}" VerticalAlignment="Center">
                                                                <v:Icon Data="{StaticResource IcCheck}" Stroke="Black" StrokeThickness="2.8"
                                                                        Width="14" Height="14" IsVisible="{Binding IsSelected}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding LastText}" Classes="mono muted" FontSize="12"
                                                                       VerticalAlignment="Center" IsVisible="{Binding HasLast}"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            </Panel>
        </v:Sheet>
    </Border>

    <!-- Undo today's check-in -->
    <Border Classes="scrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsConfirmingUndo}" Padding="24">
        <v:Sheet Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="24" CornerRadius="18" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <StackPanel Spacing="14">
                <TextBlock Text="Undo today's check-in?" FontSize="22" FontWeight="ExtraBold"/>
                <TextBlock Text="{Binding UndoConfirmText}" FontSize="14" Classes="soft"/>
                <TextBlock Text="{Binding UndoLossText}" Classes="mono" FontSize="14" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="btn outline" Content="Keep it" Command="{Binding CancelUndoCommand}"/>
                    <Button Classes="btn light" Content="Undo check-in" Command="{Binding ConfirmUndoCommand}"/>
                </StackPanel>
            </StackPanel>
        </v:Sheet>
    </Border>

    <!-- Optional gym prompt, right after check-in. The workout is already saved. -->
    <Border Classes="toast" Classes.show="{Binding ShowGymPrompt}" IsVisible="{Binding ShowGymPrompt}"
            VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="16,24,16,0" MaxWidth="420"
            CornerRadius="16" Background="{DynamicResource Fill}" BorderBrush="{DynamicResource Control}" BorderThickness="1" ClipToBounds="True"
            BoxShadow="0 18 50 0 #B3000000">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource Accent}"/>
            <StackPanel Spacing="12" Margin="18,15,18,18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <v:Icon Data="{StaticResource IcPin}" Stroke="{DynamicResource Ink}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Want to log your gym?" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="icon" Width="32" Height="32" Command="{Binding SkipGymPromptCommand}"
                            ToolTip.Tip="Close" AutomationProperties.Name="Close">
                        <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.4" Width="16" Height="16"/>
                    </Button>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding LastGymLabel}" FontSize="14" Classes="light" IsVisible="{Binding HasLastGym}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    <TextBlock Text="Pick where you trained today." FontSize="14" Classes="light" IsVisible="{Binding !HasLastGym}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="link" Content="Change" Command="{Binding ChooseGymCommand}"
                            IsVisible="{Binding HasLastGym}"/>
                </Grid>
                <CheckBox IsChecked="{Binding MakeMyGym}" FontSize="13" Foreground="{DynamicResource Muted}"
                          IsVisible="{Binding ShowMakeMyGym}">Make this my gym</CheckBox>
                <CheckBox IsChecked="{Binding DontAskForGym}" FontSize="13" Foreground="{DynamicResource Muted}">Don't ask me again</CheckBox>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="btn outline small" HorizontalAlignment="Stretch" MinHeight="42" Content="Not now"
                            Command="{Binding SkipGymPromptCommand}"/>
                    <Button Grid.Column="1" Classes="btn light small" HorizontalAlignment="Stretch" MinHeight="42"
                            Content="Log gym"
                            Command="{Binding LogGymCommand}"/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
    <!-- Asked once, after the first check-in with a gym (FRIENDS_GYM_MAP.md 4f) -->
    <Border Classes="toast" Classes.show="{Binding ShowShareQuestion}" IsVisible="{Binding ShowShareQuestion}"
            VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="16,24,16,0" MaxWidth="420"
            CornerRadius="16" Background="{DynamicResource Fill}" BorderBrush="{DynamicResource Control}" BorderThickness="1" ClipToBounds="True"
            BoxShadow="0 18 50 0 #B3000000">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource Accent}"/>
            <StackPanel Spacing="12" Margin="18,15,18,18">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <v:Icon Data="{StaticResource IcFriends}" Stroke="{DynamicResource Ink}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Show this check-in to friends?" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock FontSize="13" Classes="soft" TextWrapping="Wrap" LineHeight="19"
                           Text="Friends see the gym and the day, never the time. You can change this on the Map."/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="btn outline small" HorizontalAlignment="Stretch" MinHeight="42" Content="Not now"
                            Command="{Binding DontShareCheckInsCommand}"/>
                    <Button Grid.Column="1" Classes="btn primary small" HorizontalAlignment="Stretch" MinHeight="42" Content="Share"
                            Command="{Binding ShareCheckInsCommand}"/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>

    <!-- Points history popup, over the whole page (sidebar included) -->
    <ContentControl Content="{Binding PointsHistory}" IsVisible="{Binding IsPointsHistoryOpen}"/>
    </Grid>
</UserControl>
