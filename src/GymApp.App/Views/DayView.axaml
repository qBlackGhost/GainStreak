<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.DayView"
             x:DataType="vm:DayViewModel">
    <!-- After the "Gym App" design canvas (WorkoutDay artboard): this day's exercises (drag to reorder) on the left,
         the exercise picker on the right. On a wide window the page fits the window and each list scrolls on its own,
         only when it is too long; when narrow, the cards stack and the page scrolls (DayView.axaml.cs). -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/GainStreakStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <!-- Chosen exercise rows -->
        <Style Selector="Border.exRow">
            <Setter Property="Padding" Value="6,10,12,10"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Phones: the row's name and sets open the exercise; a quiet trash removes it -->
        <Style Selector="Button.rowOpen">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.rowOpen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.rowRemove">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector=".phone Border.exRow"><Setter Property="Padding" Value="2,4,4,4"/></Style>
        <Style Selector="Border.exRow.dragging">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlHover}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Border.dropLine">
            <Setter Property="Height" Value="3"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border#Handle">
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Muscle group chips -->
        <Style Selector="Button.chip">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Light}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.chip.on">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- Picker tiles; added ones are disabled and dimmed, with a check -->
        <Style Selector="Button.tile">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.tile:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        </Style>

        <!-- Copy dialog: sources and the add / replace switch -->
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="40,0,14,0"/>
        </Style>

        <Style Selector="DockPanel#Page">
            <Setter Property="Margin" Value="40,32,40,32"/>
            <Setter Property="MaxWidth" Value="1400"/>
        </Style>
        <Style Selector="DockPanel.narrow DockPanel#Page">
            <Setter Property="Margin" Value="16,24,16,32"/>
        </Style>

        <!-- Wide: two columns that fill the window. Narrow (DayView.axaml.cs): stacked, the lists capped -->
        <Style Selector="Border#AddCard">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid.stack Border#ChosenCard">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid.stack Border#AddCard">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <!-- Room for the overlay scrollbar, so it doesn't sit on the tiles -->
        <Style Selector="ScrollViewer.list">
            <Setter Property="Padding" Value="0,0,12,0"/>
        </Style>
        <Style Selector="Grid.stack ScrollViewer.list">
            <Setter Property="MaxHeight" Value="480"/>
        </Style>
        <!-- In the phones' sheet: the card fills it and its list takes the rest of the height -->
        <Style Selector="Border#AddSheetBody Border#AddCard">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border#AddSheetBody ScrollViewer.list">
            <Setter Property="MaxHeight" Value="Infinity"/>
        </Style>
        <!-- Phones: the day's exercises fill the card and scroll with the page, not in a capped box of their own,
             and without the scrollbar's gap on the right -->
        <Style Selector=".phone Grid.stack Border#ChosenCard ScrollViewer.list">
            <Setter Property="MaxHeight" Value="Infinity"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Styles>
    <Grid Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
    <DockPanel>
        <v:Sidebar Current="Workouts"/>

        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Disabled">
        <DockPanel x:Name="Page">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,24">
                <Button Classes="btn outline" MinHeight="40" Padding="10,0,14,0" FontSize="14" HorizontalAlignment="Left"
                        Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <v:Icon Data="{StaticResource IcBack}" StrokeThickness="2.2" Width="16" Height="16"/>
                        <TextBlock Text="Workouts" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding Title}" FontSize="40" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource Fill2}" CornerRadius="6" Padding="10,3" VerticalAlignment="Center"
                                    IsVisible="{Binding WeekdaysText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding WeekdaysText}" FontSize="13" FontWeight="SemiBold" Classes="light"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="15" Classes="soft"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="mono muted wideOnly" Text="{Binding CountLabel}" FontSize="13" VerticalAlignment="Bottom"/>
                    <!-- Phones (the canvas): the count in an outlined pill -->
                    <Border Grid.Column="1" Classes="phoneOnly" Padding="10,5" CornerRadius="999" BorderBrush="{DynamicResource Control}"
                            BorderThickness="1" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CountShort}" Classes="mono soft" FontSize="12" FontWeight="Bold"/>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Info}" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold"
                           IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding Error}" Classes="error"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <Grid x:Name="Columns" ColumnDefinitions="*,1.2*" RowDefinitions="*,Auto" ColumnSpacing="24" RowSpacing="24">

                <!-- ===== This day's exercises ===== -->
                <Border x:Name="ChosenCard" Classes="card">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Exercises" Classes="h2"/>
                                <TextBlock Text="{Binding SetsLabel}" FontSize="13" Classes="muted"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="btn outline small wideOnly" MinHeight="40" VerticalAlignment="Top"
                                    Command="{Binding ToggleCopyCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <v:Icon Data="{StaticResource IcCopy}" StrokeThickness="2.2" Width="15" Height="15"/>
                                    <TextBlock Text="Copy from another day" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock DockPanel.Dock="Bottom" Classes="wideOnly" Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource Faint}"
                                   Text="Open an exercise to log its sets. Drag the handle to reorder (or use the arrow keys on it). Removing an exercise keeps its logged sets and PR."/>
                        <TextBlock DockPanel.Dock="Bottom" Classes="phoneOnly" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource Faint}"
                                   LineHeight="17" Text="Tap an exercise to open it and log its sets. Hold the handle to reorder. Removing an exercise keeps its logged sets and PR."/>
                        <!-- Phones (the canvas): the picker opens as a sheet; copy is down here instead of up top -->
                        <Grid DockPanel.Dock="Bottom" Classes="phoneOnly" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,14,0,0">
                            <Button Classes="btn primary" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding OpenAddCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <v:Icon Data="{StaticResource IcPlus}" StrokeThickness="2.6" Width="16" Height="16"/>
                                    <TextBlock Text="Add exercises" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="btn outline" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding ToggleCopyCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <v:Icon Data="{StaticResource IcCopy}" StrokeThickness="2.2" Width="16" Height="16"/>
                                    <TextBlock Text="Copy a day" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Panel>
                            <Panel IsVisible="{Binding IsEmpty}" MinHeight="200" VerticalAlignment="Top">
                                <Rectangle Stroke="{DynamicResource Control}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="14" RadiusY="14"/>
                                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="280">
                                    <v:Icon Data="{StaticResource IcDumbbell}" Stroke="{DynamicResource Faint}" StrokeThickness="1.8" Width="30" Height="30"
                                            HorizontalAlignment="Center"/>
                                    <TextBlock Text="No exercises yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Classes="muted wideOnly" Text="Pick from the list on the right, or copy another day's exercises." FontSize="13"
                                               TextAlignment="Center" LineHeight="19"/>
                                    <TextBlock Classes="muted phoneOnly" Text="Add from the list, or copy another day's exercises." FontSize="13"
                                               TextAlignment="Center" LineHeight="19"/>
                                </StackPanel>
                            </Panel>
                            <ScrollViewer Classes="list" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsEmpty}">
                                <ItemsControl x:Name="ChosenList" ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DayExerciseItemViewModel">
                                            <Grid RowDefinitions="Auto,Auto,Auto">
                                                <Border Classes="dropLine" Margin="0,-6,0,3" IsVisible="{Binding IsDropAbove}"/>
                                                <Border Grid.Row="1" Classes="exRow" Classes.dragging="{Binding IsDragging}">
                                                    <v:PhoneGrid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12"
                                                                 PhoneColumns="Auto,Auto,*,Auto" PhoneColumnSpacing="8">
                                                        <!-- Drag handle; also focusable, so the arrow keys move the row -->
                                                        <Border x:Name="Handle" Width="28" Height="44" CornerRadius="8" Focusable="True"
                                                                ToolTip.Tip="Drag to reorder" Tag="{Binding}"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Reorder {0}'}">
                                                            <Path Data="{StaticResource IcGrip}" Fill="{DynamicResource Faint}" Width="16" Height="20"
                                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <!-- The number: not on phones, where the name needs the room -->
                                                        <Border Grid.Column="1" Classes="wideOnly" Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Fill3}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Number}" Classes="mono light" FontSize="13" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Classes="wideOnly" Spacing="3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"/>
                                                            <!-- Wraps, so the planned sets go under the group on a phone -->
                                                            <WrapPanel ItemSpacing="8" LineSpacing="3">
                                                                <Border Background="{DynamicResource Fill3}" CornerRadius="5" Padding="7,1">
                                                                    <TextBlock Text="{Binding Group}" FontSize="12" FontWeight="SemiBold" Classes="light"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Planned}" FontSize="12" Classes="muted" VerticalAlignment="Center"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                        <!-- Phones (the canvas): the number, then the name and "Group · sets" opening the exercise -->
                                                        <TextBlock Grid.Column="1" Classes="mono muted phoneOnly" Text="{Binding Number}" FontSize="13"
                                                                   FontWeight="Bold" Width="18" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Classes="rowOpen phoneOnly" Command="{Binding OpenCommand}"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="12" Classes="muted" TextWrapping="Wrap">
                                                                    <Run Text="{Binding Group}" FontWeight="SemiBold" Foreground="{DynamicResource Soft}"/><Run Text=" · "/><Run Text="{Binding Planned}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="3" Classes="rowRemove phoneOnly" Command="{Binding RemoveCommand}"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Remove {0} from day'}">
                                                            <v:Icon Data="{StaticResource IcTrash}" StrokeThickness="2" Width="18" Height="18"/>
                                                        </Button>
                                                        <StackPanel Grid.Column="3" Classes="wideOnly" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Classes="btn light small" Content="Open" Command="{Binding OpenCommand}"/>
                                                            <Button Classes="btn outline small" Width="36" Height="36" MinHeight="36" Padding="0"
                                                                    Foreground="{DynamicResource Soft}" Command="{Binding RemoveCommand}"
                                                                    ToolTip.Tip="Remove from this day" AutomationProperties.Name="Remove from day">
                                                                <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.4" Width="15" Height="15"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </v:PhoneGrid>
                                                </Border>
                                                <Border Grid.Row="2" Classes="dropLine" Margin="0,3,0,-6" IsVisible="{Binding IsDropBelow}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Panel>
                    </DockPanel>
                </Border>

                <!-- ===== Add exercises ===== -->
                <Border x:Name="AddCard" Classes="card">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Add exercises" Classes="h2" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Panel>
                                    <Rectangle Stroke="{DynamicResource ControlHover}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="10" RadiusY="10"/>
                                    <Button Classes="btn small" MinHeight="40" Background="Transparent" Foreground="{DynamicResource Ink}"
                                            Command="{Binding NewExerciseCommand}" ToolTip.Tip="Create or manage your own exercises">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <v:Icon Data="{StaticResource IcPlus}" StrokeThickness="2.4" Width="14" Height="14"/>
                                            <TextBlock Text="New exercise" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Panel>
                                <!-- Phones: closes the sheet -->
                                <Button Classes="btn primary small phoneOnly" MinHeight="40" Content="Done" Command="{Binding CloseAddCommand}"/>
                                </StackPanel>
                            </Grid>
                            <Panel>
                                <TextBox Classes="field" PlaceholderText="Search exercises" Text="{Binding Search}"
                                         AutomationProperties.Name="Search exercises"/>
                                <v:Icon Data="{StaticResource IcSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="2.2"
                                        Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                            </Panel>
                            <ItemsControl ItemsSource="{Binding Filters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GroupFilter">
                                        <Button Classes="chip" Classes.on="{Binding IsSelected}" Content="{Binding Label}"
                                                Command="{Binding $parent[UserControl].((vm:DayViewModel)DataContext).SelectFilterCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ScrollViewer Classes="list" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="18">
                                <TextBlock Text="No exercises match. Add it with &quot;New exercise&quot;." FontSize="14" Classes="muted"
                                           IsVisible="{Binding NoPickerResults}"/>
                                <ItemsControl ItemsSource="{Binding PickerGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Spacing="18"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PickerGroup">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" LetterSpacing="1.2" Classes="muted"/>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><v:ResponsiveGrid MinItemWidth="200" Spacing="8"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PickerItemViewModel">
                                                            <Button Classes="tile" Command="{Binding AddCommand}">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                                    <v:Icon Grid.Column="1" Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}"
                                                                            StrokeThickness="2.8" Width="16" Height="16" IsVisible="{Binding IsAdded}"
                                                                            ToolTip.Tip="Added"/>
                                                                    <v:Icon Grid.Column="1" Data="{StaticResource IcPlus}" StrokeThickness="2.4"
                                                                            Width="16" Height="16" IsVisible="{Binding !IsAdded}"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
        </ScrollViewer>
    </DockPanel>

    <!-- Phones: the picker card (AddCard) moves in here, a sheet from the bottom over most of the screen
         (DayView.axaml.cs moves it) -->
    <Panel x:Name="AddSheet" IsVisible="{Binding IsAddOpen}">
        <Border Background="{DynamicResource Scrim}" PointerPressed="OnAddScrimPressed"/>
        <Border x:Name="AddSheetBody" VerticalAlignment="Bottom" Background="{DynamicResource PageBg}"
                CornerRadius="22,22,0,0" ClipToBounds="True"/>
    </Panel>

    <!-- Copy from another day -->
    <Border Classes="scrim" Background="{DynamicResource Scrim}" IsVisible="{Binding IsCopyOpen}" Padding="24">
        <v:Sheet Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" CornerRadius="18"
                Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Copy from another day" FontSize="22" FontWeight="ExtraBold"/>
                        <TextBlock Text="Copies the exercises and planned sets, never logged sets or PRs." FontSize="13" Classes="muted"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCopyCommand}" VerticalAlignment="Top"
                            ToolTip.Tip="Close" AutomationProperties.Name="Close">
                        <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.4"/>
                    </Button>
                </Grid>
                <TextBlock Text="You don't have exercises on other days yet." FontSize="14" Classes="muted"
                           IsVisible="{Binding !HasCopySources}"/>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CopySources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CopySourceItemViewModel">
                                <Button Classes="source" Classes.on="{Binding IsSelected}" Command="{Binding ChooseCommand}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Source.DayName}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Source.SplitName}" FontSize="12" Classes="muted"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="mono soft" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Spacing="8" IsVisible="{Binding !IsEmpty}">
                    <TextBlock Text="{Binding CopyModeQuestion}" FontSize="13" Classes="light"/>
                    <Border Padding="4" CornerRadius="12" Background="{DynamicResource Fill}">
                        <v:SegmentedPill SelectedIndex="{Binding IsReplaceMode, Converter={x:Static v:SegmentedPill.BoolToIndex}}"
                                         PillInset="0">
                            <Button Classes="seg" Classes.on="{Binding IsAppendMode}" MinHeight="38" Content="Add to the end"
                                    Command="{Binding SetAppendModeCommand}"/>
                            <Button Classes="seg" Classes.on="{Binding IsReplaceMode}" MinHeight="38" Content="Replace the list"
                                    Command="{Binding SetReplaceModeCommand}"/>
                        </v:SegmentedPill>
                    </Border>
                    <TextBlock Text="{Binding CopySkipNote}" FontSize="12" Classes="muted"/>
                </StackPanel>
                <!-- Cancel and Copy across the bottom, the same height, Copy the wider -->
                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="10">
                    <Button Classes="btn outline" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="Cancel" Command="{Binding CancelCopyCommand}"/>
                    <Button Grid.Column="1" Classes="btn primary" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="Copy exercises" Command="{Binding ConfirmCopyCommand}" IsEnabled="{Binding HasPendingCopy}"/>
                </Grid>
            </StackPanel>
        </v:Sheet>
    </Border>
    </Grid>
</UserControl>
