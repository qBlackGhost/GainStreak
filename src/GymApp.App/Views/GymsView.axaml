<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             x:Class="GymApp.App.Views.GymsView"
             x:DataType="vm:GymsViewModel">
    <!-- The Map screen, after the "Gym App" design canvas (Gyms board) and FRIENDS_GYM_MAP.md. On a large window it fits
         the screen: the map fills the left, the Friends card takes the leftover height on the right and scrolls inside.
         Below 1100 × 700 the page scrolls and the columns stack (GymsView.axaml.cs). -->
    <UserControl.Styles>
        <!-- The shared styles, here rather than app-wide so the other screens keep their own classes -->
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.mapCard">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style Selector="Border.overlay">
            <Setter Property="Background" Value="{DynamicResource Glass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Settings chips: the whole chip is the switch -->
        <Style Selector="Button.chip">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.chip.on">
            <Setter Property="Background" Value="{DynamicResource LimeTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LimeTintLineStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LimeTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LimeTintLineStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Border.track">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource Control}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.chip.on Border.track">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border.knob">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Inverse}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.chip.on Border.knob">
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Friends rows -->
        <Style Selector="Button.frow">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.frow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.frow:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="Button.frow.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.day">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{DynamicResource Fill2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Light}"/>
        </Style>
        <Style Selector="Border.day.today">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="TextElement.Foreground" Value="Black"/>
        </Style>
        <Style Selector="Border.groupDot">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Faint}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.groupDot.today">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border.groupDot.away">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Faint}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        </Style>
        <Style Selector="Button.square">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Large window: two columns that fit the screen. Small: stacked, the page scrolls (GymsView.axaml.cs) -->
        <Style Selector="WrapPanel#Chips">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid.stack WrapPanel#Chips">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style Selector="Border#HomeIcon">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border#HomeIcon.none">
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
        </Style>
        <Style Selector="Grid#RightColumn">
            <Setter Property="Grid.Column" Value="2"/>
        </Style>
        <Style Selector="Grid.stack Grid#RightColumn">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>
        <Style Selector="Grid.stack Border#MapCard">
            <Setter Property="Height" Value="600"/>
        </Style>
        <Style Selector="Grid.stack ScrollViewer#FriendsScroll">
            <Setter Property="MaxHeight" Value="360"/>
        </Style>
        <Style Selector="Grid#Page">
            <Setter Property="Margin" Value="32,24"/>
        </Style>
        <Style Selector="DockPanel.narrow Grid#Page">
            <Setter Property="Margin" Value="16,20"/>
        </Style>
    </UserControl.Styles>
    <Grid Background="{DynamicResource PageBg}" TextElement.Foreground="{DynamicResource Ink}">
    <DockPanel>
        <v:Sidebar Current="Map"/>

        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Disabled">
        <Grid x:Name="Page" RowDefinitions="Auto,Auto,*" RowSpacing="16">

            <!-- ===== Header: title and city; the two setting chips ===== -->
            <Grid x:Name="Header" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                <WrapPanel ItemSpacing="16" LineSpacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Map" FontSize="28" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <v:Icon Data="{StaticResource IcPin}" Stroke="{DynamicResource Soft}" Width="15" Height="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CityName}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="·" FontSize="14" Classes="soft" VerticalAlignment="Center"/>
                        <Button Classes="link" FontSize="14" Content="Change city" Command="{Binding ChangeCityCommand}"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel x:Name="Chips" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
                    <Button Classes="chip" Classes.on="{Binding ShareCheckIns}" Command="{Binding ToggleShareCommand}"
                            ToolTip.Tip="Friends see the gym and day of your check-ins from the last 30 days, never the time"
                            AutomationProperties.Name="Visible to friends">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <v:Icon Data="{StaticResource IcFriends}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Visible to friends" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ShareStateText}" FontSize="11" FontWeight="Medium" Opacity="0.8"/>
                            </StackPanel>
                            <Border Classes="track"><Border Classes="knob"/></Border>
                        </StackPanel>
                    </Button>
                    <Button Classes="chip" Classes.on="{Binding AskForGym}" Command="{Binding ToggleAskCommand}"
                            ToolTip.Tip="Ask which gym after every check-in, with your gym preselected. Off: your gym is logged by itself."
                            AutomationProperties.Name="Ask for gym">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <v:Icon Data="{StaticResource IcBell}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Ask for gym" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding AskStateText}" FontSize="11" FontWeight="Medium" Opacity="0.8"/>
                            </StackPanel>
                            <Border Classes="track"><Border Classes="knob"/></Border>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding Error}" Classes="error" FontSize="13"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Grid x:Name="Columns" Grid.Row="2">

                <!-- ===== Friends map ===== -->
                <Border x:Name="MapCard" Classes="mapCard">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <!-- Title and pills side by side; the code-behind puts the pills under the title when the card is narrow -->
                        <Grid x:Name="MapHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                            <WrapPanel ItemSpacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Friends map" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                <TextBlock Text="{Binding RangeTitle}" FontSize="13" Classes="muted" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </WrapPanel>
                            <WrapPanel x:Name="MapPills" Grid.Column="1" ItemSpacing="8" LineSpacing="8">
                                <Border Padding="3" CornerRadius="10" Background="{DynamicResource Fill}" Width="234">
                                    <v:SegmentedPill SelectedIndex="{Binding RangeIndex}" PillInset="0" PillCornerRadius="8">
                                        <Button Classes="seg" Classes.on="{Binding RangeIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=0}"
                                                MinHeight="32" Padding="0" CornerRadius="8" Content="Today" Command="{Binding SetRangeCommand}" CommandParameter="0"/>
                                        <Button Classes="seg" Classes.on="{Binding RangeIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=1}"
                                                MinHeight="32" Padding="0" CornerRadius="8" Content="7 days" Command="{Binding SetRangeCommand}" CommandParameter="1"/>
                                        <Button Classes="seg" Classes.on="{Binding RangeIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=2}"
                                                MinHeight="32" Padding="0" CornerRadius="8" Content="30 days" Command="{Binding SetRangeCommand}" CommandParameter="2"/>
                                    </v:SegmentedPill>
                                </Border>
                                <Border Padding="3" CornerRadius="10" Background="{DynamicResource Fill}" Width="184">
                                    <v:SegmentedPill SelectedIndex="{Binding ModeIndex}" PillInset="0" PillCornerRadius="8">
                                        <Button Classes="seg" Classes.on="{Binding ModeIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=0}"
                                                MinHeight="32" Padding="0" CornerRadius="8" Content="Latest" Command="{Binding SetModeCommand}" CommandParameter="0"/>
                                        <Button Classes="seg" Classes.on="{Binding ModeIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=1}"
                                                MinHeight="32" Padding="0" CornerRadius="8" Content="All visits" Command="{Binding SetModeCommand}" CommandParameter="1"/>
                                    </v:SegmentedPill>
                                </Border>
                            </WrapPanel>
                        </Grid>

                        <Border Grid.Row="1" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource ColdTint}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Grid>
                                <mapsui:MapControl x:Name="FriendMap"/>

                                <!-- Legend, bottom left; hidden while the gym card is open so they never overlap -->
                                <Border Classes="overlay" Padding="12,10" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        IsHitTestVisible="False" IsVisible="{Binding !HasSelection}">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="LAST CHECK-IN" FontSize="11" FontWeight="Bold" LetterSpacing="0.7" Classes="muted"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="avatar" Width="14" Height="14" CornerRadius="7"/>
                                            <TextBlock Text="Today" FontSize="12" Classes="light"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="avatar" Width="14" Height="14" CornerRadius="7" Opacity="0.6"/>
                                            <TextBlock Text="This week" FontSize="12" Classes="light"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="avatar" Width="14" Height="14" CornerRadius="7" Opacity="0.35"/>
                                            <TextBlock Text="Up to 30 days" FontSize="12" Classes="light"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource Accent}" BorderBrush="Black"
                                                    BorderThickness="2"/>
                                            <TextBlock Text="You" FontSize="12" Classes="light"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="10" Height="10" Margin="2,0" CornerRadius="5" Background="#6B7278" BorderBrush="{DynamicResource Surface}"
                                                    BorderThickness="2"/>
                                            <TextBlock Text="Gym" FontSize="12" Classes="light"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Today's gym changed -->
                                <Border Padding="14,8,8,8" CornerRadius="12" Margin="16,12" HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Background="{DynamicResource LimeTint}" BorderBrush="{DynamicResource LimeTintLine}" BorderThickness="1" BoxShadow="0 8 24 0 #80000000"
                                        IsVisible="{Binding Toast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <v:Icon Data="{StaticResource IcCheck}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.8"
                                                Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Toast}" FontSize="13" VerticalAlignment="Center" MaxWidth="420"/>
                                        <Button Classes="btn outline small" MinHeight="32" Content="Undo" Command="{Binding UndoToastCommand}"
                                                IsVisible="{Binding CanUndoToast}"/>
                                        <Button Classes="btn outline square" Foreground="{DynamicResource Soft}" Command="{Binding DismissToastCommand}"
                                                ToolTip.Tip="Close" AutomationProperties.Name="Close">
                                            <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.6" Width="12" Height="12"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Nothing to pin: a small note in the corner, so the map stays usable -->
                                <Border Classes="overlay" Padding="12,9" CornerRadius="10" MaxWidth="230" Margin="12"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                                        IsVisible="{Binding ShowMapNote}">
                                    <TextBlock Text="{Binding MapEmptyText}" FontSize="12" Classes="light" TextWrapping="Wrap" LineHeight="17"/>
                                </Border>

                                <!-- Gym card -->
                                <Border Padding="14" CornerRadius="14" Width="420" Margin="16,0,16,32" HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1"
                                        BoxShadow="0 12 40 0 #99000000" IsVisible="{Binding HasSelection}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding SelectedName}" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedDetail}" FontSize="12" Classes="muted"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="btn outline square" Foreground="{DynamicResource Soft}"
                                                    Command="{Binding CloseGymCardCommand}" ToolTip.Tip="Close" AutomationProperties.Name="Close">
                                                <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.6" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SelectedVisitors}" IsVisible="{Binding HasSelectedVisitors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MapFriendRowViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                        <Border Classes="avatar" Width="28" Height="28" CornerRadius="14" Opacity="{Binding Opacity}">
                                                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="13" Classes="soft" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock FontSize="13" Classes="muted" IsVisible="{Binding !HasSelectedVisitors}">
                                            <Run Text="No friends checked in here "/><Run Text="{Binding RangeWords}"/><Run Text="."/>
                                        </TextBlock>
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock FontSize="13" Classes="soft" VerticalAlignment="Center">
                                                    <Run Text="You: "/><Run Text="{Binding SelectedMine}" FontWeight="Bold" Foreground="{DynamicResource Ink}"/><Run Text=" this month"/>
                                                </TextBlock>
                                                <Button Grid.Column="1" Classes="btn small" Classes.primary="{Binding CanPickSelected}"
                                                        Classes.outline="{Binding !CanPickSelected}" MinHeight="36" Content="{Binding SelectedPickLabel}"
                                                        Command="{Binding TrainedHereTodayCommand}" IsEnabled="{Binding !IsSelectedToday}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="2" FontSize="12" Classes="muted"
                                   Text="Friends only see the gym and the day of a check-in, never the time. Custom gyms show by name only."/>
                    </Grid>
                </Border>

                <!-- ===== Right: Your gym, Friends, Your check-ins ===== -->
                <Grid x:Name="RightColumn" RowDefinitions="Auto,*,Auto" RowSpacing="16">

                    <!-- Your gym -->
                    <Border Classes="mapCard">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Your gym" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="btn outline small" MinHeight="34" Content="{Binding HomeGymButton}"
                                        Command="{Binding OpenHomeGymPickerCommand}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border x:Name="HomeIcon" Width="40" Height="40" CornerRadius="12" Classes.none="{Binding !HasHomeGym}">
                                    <Panel>
                                        <v:Icon Data="{StaticResource IcDumbbell}" Stroke="Black" StrokeThickness="2.4" Width="20" Height="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasHomeGym}"/>
                                        <v:Icon Data="{StaticResource IcDumbbell}" Stroke="{DynamicResource Faint}" StrokeThickness="2.4" Width="20" Height="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasHomeGym}"/>
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HomeGymName}" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding HomeGymDetail}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Grid>
                            <Border Padding="12,10" CornerRadius="12" Background="{DynamicResource Surface2}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Today" FontSize="12" Classes="muted"/>
                                        <TextBlock Text="{Binding TodayLabel}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="btn light small" MinHeight="34" Content="{Binding TodayButton}"
                                            Command="{Binding OpenTodayPickerCommand}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Friends -->
                    <Border Grid.Row="1" Classes="mapCard" Padding="18,16,18,12">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Friends" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FriendCountText}" FontSize="12" Classes="muted"/>
                                    <TextBlock Text="{Binding FriendsStale}" FontSize="12" Classes="muted" TextWrapping="Wrap"
                                               IsVisible="{Binding FriendsStale, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="3" CornerRadius="10" Background="{DynamicResource Fill}" Width="196" VerticalAlignment="Center">
                                    <v:SegmentedPill SelectedIndex="{Binding SortIndex}" PillInset="0" PillCornerRadius="8">
                                        <Button Classes="seg" Classes.on="{Binding SortIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=0}"
                                                MinHeight="32" Padding="0" CornerRadius="8" Command="{Binding SetSortCommand}" CommandParameter="0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <v:Icon Data="{StaticResource IcClock}" StrokeThickness="2.2" Width="14" Height="14"/>
                                                <TextBlock Text="Recent" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="seg" Classes.on="{Binding SortIndex, Converter={x:Static v:ProfileView.IsIndex}, ConverterParameter=1}"
                                                MinHeight="32" Padding="0" CornerRadius="8" Command="{Binding SetSortCommand}" CommandParameter="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <v:Icon Data="{StaticResource IcPin}" StrokeThickness="2.2" Width="14" Height="14"/>
                                                <TextBlock Text="By gym" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </v:SegmentedPill>
                                </Border>
                            </Grid>
                            <ScrollViewer x:Name="FriendsScroll" Grid.Row="1" MinHeight="96" Padding="0,0,10,0"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding FriendsEmptyText}" FontSize="13" Classes="muted" LineHeight="20" Margin="2,16"
                                               IsVisible="{Binding !HasFriendRows}"/>
                                    <ItemsControl ItemsSource="{Binding FriendGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MapFriendGroupViewModel">
                                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="2,6">
                                                        <Border Classes="groupDot" Classes.today="{Binding IsToday}" Classes.away="{Binding IsAway}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" FontWeight="Bold" LetterSpacing="0.6"
                                                                   Classes="muted" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Meta}" Classes="mono muted" FontSize="11"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MapFriendRowViewModel">
                                                                <Button Classes="frow" Classes.selected="{Binding IsSelected}" IsEnabled="{Binding CanShow}"
                                                                        Command="{Binding $parent[UserControl].((vm:GymsViewModel)DataContext).ShowFriendCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                                        <Border Classes="avatar" Opacity="{Binding Opacity}">
                                                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="Bold"
                                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Classes="muted"
                                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                        </StackPanel>
                                                                        <Border Grid.Column="2" Classes="day" Classes.today="{Binding IsToday}">
                                                                            <TextBlock Text="{Binding When}" FontSize="12" FontWeight="SemiBold"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Your check-ins -->
                    <Border Grid.Row="2" Classes="mapCard">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="Your check-ins" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="btn outline square" Command="{Binding PreviousMonthCommand}" AutomationProperties.Name="Previous month">
                                        <v:Icon Data="{StaticResource IcChevronLeft}" StrokeThickness="2.4" Width="14" Height="14"/>
                                    </Button>
                                    <TextBlock Text="{Binding MonthTitle}" MinWidth="108" TextAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               Classes="light" VerticalAlignment="Center"/>
                                    <Button Classes="btn outline square" Command="{Binding NextMonthCommand}" AutomationProperties.Name="Next month">
                                        <v:Icon Data="{StaticResource IcChevronRight}" StrokeThickness="2.4" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <Border Classes="tile"><StackPanel Spacing="2">
                                    <TextBlock Text="Workouts" FontSize="11" Classes="muted"/>
                                    <TextBlock Text="{Binding MonthWorkouts}" FontSize="22" FontWeight="ExtraBold"/>
                                </StackPanel></Border>
                                <Border Grid.Column="1" Classes="tile"><StackPanel Spacing="2">
                                    <TextBlock Text="At a gym" FontSize="11" Classes="muted"/>
                                    <TextBlock Text="{Binding MonthAtGym}" FontSize="22" FontWeight="ExtraBold"/>
                                </StackPanel></Border>
                                <Border Grid.Column="2" Classes="tile"><StackPanel Spacing="2">
                                    <TextBlock Text="No gym" FontSize="11" Classes="muted"/>
                                    <TextBlock Text="{Binding MonthNoGym}" FontSize="22" FontWeight="ExtraBold"/>
                                </StackPanel></Border>
                                <Border Grid.Column="3" Classes="tile"><StackPanel Spacing="2">
                                    <TextBlock Text="Gyms" FontSize="11" Classes="muted"/>
                                    <TextBlock Text="{Binding MonthGyms}" FontSize="22" FontWeight="ExtraBold"/>
                                </StackPanel></Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding MonthRows}" IsVisible="{Binding HasMonthRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MapMonthRow">
                                        <Grid ColumnDefinitions="*,1.1*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Height="6" MinHeight="6" CornerRadius="999" Minimum="0" Maximum="1"
                                                         Value="{Binding Share}" VerticalAlignment="Center" Background="{DynamicResource Track}"
                                                         Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VisitsText}" Classes="mono" FontSize="12" FontWeight="Bold"
                                                       MinWidth="18" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        </ScrollViewer>
    </DockPanel>

    <!-- Gym picker dialog, over the whole page -->
    <ContentControl Content="{Binding Picker}" IsVisible="{Binding IsPickerOpen}"/>
    </Grid>
</UserControl>
