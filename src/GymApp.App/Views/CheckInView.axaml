<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:svc="using:GymApp.Services"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.CheckInView"
             x:DataType="vm:CheckInViewModel">
    <!-- The "I went today" popup over Home (design: Main board, check-in dialog). Each exercise is a box that turns
         green when filled; each set is a chip you type kg and reps into, with last time's values as placeholders. -->
    <UserControl.Styles>
        <StyleInclude Source="/Views/IronlogStyles.axaml"/>

        <!-- Exercise box -->
        <Style Selector="Border.exercise">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.exercise.filled">
            <Setter Property="BorderBrush" Value="{DynamicResource LimeTintLine}"/>
            <Setter Property="Background" Value="{DynamicResource LimeTint}"/>
        </Style>

        <!-- Set chip: "1  60 kg × 8" -->
        <Style Selector="Border.chip">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.chip.warm">
            <Setter Property="BorderBrush" Value="Transparent"/>   <!-- the dashed outline is drawn underneath -->
        </Style>
        <Style Selector="Border.chip.done">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource Fill3}"/>
        </Style>
        <Style Selector="Border.chip.warm.done">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.chip:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
        </Style>
        <Style Selector="TextBlock.chipText">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.chip.done TextBlock.chipText">
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
        </Style>
        <Style Selector="TextBlock.chipTag">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- The kg and reps boxes inside a chip: no box of their own -->
        <Style Selector="TextBox.chipBox">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource Faint}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="6"/>
        </Style>
        <Style Selector="TextBox.chipBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.chipBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- "Use last time" / "Filled" -->
        <Style Selector="Button.chipBtn">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Log workout, greyed out until enough exercises are filled -->
        <Style Selector="Button.log">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="22,0"/>
        </Style>
        <Style Selector="Button.log:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Fill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        </Style>

        <Style Selector="ComboBox.day">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource PageBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Control}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Styles>
    <v:Sheet MaxWidth="560" MaxHeight="760" HorizontalAlignment="Stretch" VerticalAlignment="Center"
            Padding="24" CornerRadius="18" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Control}" BorderThickness="1"
            BoxShadow="0 24 80 0 #B3000000" TextElement.Foreground="{DynamicResource Ink}">
        <DockPanel>
            <!-- Title -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Black" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="icon" Width="36" Height="36" Padding="0" VerticalAlignment="Top"
                        Foreground="{DynamicResource Muted}" Command="{Binding CancelCommand}" IsCancel="True"
                        ToolTip.Tip="Close" AutomationProperties.Name="Close">
                    <v:Icon Data="{StaticResource IcX}" StrokeThickness="2.4" Width="18" Height="18"/>
                </Button>
            </Grid>

            <!-- Rest day: pick which workout you did -->
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,16" IsVisible="{Binding ShowDayPicker}">
                <TextBlock Text="Rest day. Which workout did you do?" FontSize="13" Classes="soft"/>
                <ComboBox Classes="day" ItemsSource="{Binding PickableDays}" SelectedItem="{Binding PickedDay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:CheckInDay">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Footer: progress and the button -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,16,0,0">
                <TextBlock Text="{Binding Error}" Classes="error" FontSize="13" TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding CounterText}" Classes="mono soft" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="btn primary log" Content="Log workout" Command="{Binding LogCommand}"
                            IsEnabled="{Binding CanLog}" IsVisible="{Binding HasExercises}"/>
                    <Button Grid.Column="1" Classes="btn primary log" Content="Go to Workouts" Command="{Binding OpenWorkoutsCommand}"
                            IsVisible="{Binding CanOpenWorkouts}"/>
                    <Button Grid.Column="1" Classes="btn primary log" Content="Go to Splits" Command="{Binding OpenSplitsCommand}"
                            IsVisible="{Binding CanOpenSplits}"/>
                </Grid>
            </StackPanel>

            <!-- Nothing to fill in yet -->
            <Border Classes="exercise" VerticalAlignment="Top"
                    IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding EmptyText}" FontSize="14" Classes="soft" TextWrapping="Wrap"/>
            </Border>

            <!-- Exercises, then the optional cardio; only this part scrolls -->
            <ScrollViewer IsVisible="{Binding HasExercises}" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <ItemsControl ItemsSource="{Binding Exercises}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CheckInExerciseViewModel">
                                <Border Classes="exercise" Classes.filled="{Binding IsFilled}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SubText}" FontSize="12" Classes="muted" TextWrapping="Wrap"
                                                           ToolTip.Tip="{Binding LastSessionText}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="btn outline chipBtn" Content="Use last time"
                                                    VerticalAlignment="Center" Command="{Binding FillFromPreviousCommand}"
                                                    IsVisible="{Binding ShowUseLast}"/>
                                            <Border Grid.Column="1" CornerRadius="8" Padding="12,0" MinHeight="36" VerticalAlignment="Center"
                                                    Background="{DynamicResource Accent}" IsVisible="{Binding IsFilled}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <v:Icon Data="{StaticResource IcCheck}" Stroke="Black" StrokeThickness="2.8" Width="12" Height="12"/>
                                                    <TextBlock Text="Filled" FontSize="12" FontWeight="SemiBold" Foreground="Black"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CheckInSetRowViewModel">
                                                    <Panel ToolTip.Tip="{Binding Label}">
                                                        <Rectangle Stroke="{DynamicResource Control}" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="8" RadiusY="8"
                                                                   IsVisible="{Binding IsWarmup}"/>
                                                        <Border Classes="chip" Classes.warm="{Binding IsWarmup}" Classes.done="{Binding IsComplete}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Classes="chipText chipTag" Text="{Binding Tag}"/>
                                                                <TextBox TextInputOptions.ReturnKeyType="Next" TextInputOptions.ContentType="Number" Classes="chipBox" Width="44" Text="{Binding WeightText}"
                                                                         PlaceholderText="{Binding WeightHint}"
                                                                         AutomationProperties.Name="{Binding Label, StringFormat='{}{0} kg'}"/>
                                                                <TextBlock Classes="chipText" Text=" kg ×"/>
                                                                <TextBox TextInputOptions.ReturnKeyType="Next" TextInputOptions.ContentType="Digits" Classes="chipBox" Width="34" Text="{Binding RepsText}"
                                                                         PlaceholderText="{Binding RepsHint}"
                                                                         AutomationProperties.Name="{Binding Label, StringFormat='{}{0} reps'}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Panel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding Info}" FontSize="12" Classes="muted" TextWrapping="Wrap"
                                                   IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Cardio: optional, never needed to log -->
                    <Border Classes="exercise cardio">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Cardio" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border CornerRadius="6" Padding="6,1" BorderThickness="1" BorderBrush="{DynamicResource Line2}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Optional" FontSize="11" FontWeight="SemiBold" Classes="muted"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding CardioHint}" FontSize="12" Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox TextInputOptions.ContentType="Digits" Classes="chipBox" Width="44" MaxLength="3" Text="{Binding CardioText}"
                                             PlaceholderText="0" AutomationProperties.Name="Cardio minutes"/>
                                    <TextBlock Classes="chipText" Text=" min"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </v:Sheet>
</UserControl>
