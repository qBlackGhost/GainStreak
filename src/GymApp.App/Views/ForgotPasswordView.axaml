<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymApp.App.ViewModels"
             xmlns:v="using:GymApp.App.Views"
             x:Class="GymApp.App.Views.ForgotPasswordView"
             x:DataType="vm:ForgotPasswordViewModel">
    <!-- Forgot password, from Log in: the email, then the code and a new password -->
    <UserControl.Styles>
        <StyleInclude Source="/Views/AuthStyles.axaml"/>
    </UserControl.Styles>
    <Panel Background="{DynamicResource PageBg}">
    <Ellipse Classes="authGlow phoneOnly"/>
    <ScrollViewer TextElement.Foreground="{DynamicResource Ink}">
        <StackPanel Classes="authColumn" Spacing="20">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <Image Source="{StaticResource GainStreakLogo}" Width="56" Height="56" HorizontalAlignment="Center"/>
                <TextBlock FontSize="22" FontWeight="ExtraBold" LetterSpacing="0.6" HorizontalAlignment="Center"><Run Text="GAIN"/><Run Text="STREAK" Foreground="{DynamicResource AccentInk}"/></TextBlock>
            </StackPanel>
            <Border Classes="card authCard">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Reset your password" FontSize="30" FontWeight="ExtraBold"/>
                        <TextBlock Text="We'll email you a code." FontSize="14" Classes="soft" IsVisible="{Binding IsAskingEmail}"/>
                    </StackPanel>
                    <Border Classes="formError" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <v:Icon Data="{StaticResource IcInfo}" Stroke="{DynamicResource ErrorText}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Error}" FontSize="13" Foreground="{DynamicResource ErrorText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Notice}" FontSize="13" Foreground="{DynamicResource AccentInk}" TextWrapping="Wrap"
                               IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <StackPanel Spacing="18" IsVisible="{Binding IsAskingEmail}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Email" Classes="fieldLabel"/>
                            <Panel>
                                <TextBox TextInputOptions.ReturnKeyType="Done" TextInputOptions.ContentType="Email" Classes="field" MaxLength="254" PlaceholderText="you@example.com"
                                         Text="{Binding Email}" AutomationProperties.Name="Email"/>
                                <v:Icon Classes="fieldIcon" Data="{StaticResource IcMail}"/>
                            </Panel>
                        </StackPanel>
                        <Button Classes="btn primary block" Content="Send code" Command="{Binding SendCodeCommand}" IsDefault="{Binding IsAskingEmail}"/>
                    </StackPanel>
                    <StackPanel Spacing="18" IsVisible="{Binding IsEnteringCode}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Code from the email" Classes="fieldLabel"/>
                            <Panel>
                                <TextBox TextInputOptions.ReturnKeyType="Next" TextInputOptions.ContentType="Digits" Classes="field" MaxLength="6" PlaceholderText="6 digits" Text="{Binding Code}"
                                         AutomationProperties.Name="Code"/>
                                <v:Icon Classes="fieldIcon" Data="{StaticResource IcLock}"/>
                            </Panel>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="New password" Classes="fieldLabel" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="link showPassword phoneOnly" Content="{Binding PasswordView.Label}"
                                        Command="{Binding PasswordView.ToggleCommand}"/>
                            </Grid>
                            <Panel>
                                <TextBox TextInputOptions.ReturnKeyType="Done" TextInputOptions.ContentType="Password" Classes="field" MaxLength="128" PasswordChar="{Binding PasswordView.Mask}"
                                         PlaceholderText="8 to 128 characters" Text="{Binding NewPassword}" AutomationProperties.Name="New password"/>
                                <v:Icon Classes="fieldIcon" Data="{StaticResource IcLock}"/>
                            </Panel>
                            <TextBlock Classes="fieldError" Text="{Binding NewPasswordError}"
                                       IsVisible="{Binding NewPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <Button Classes="btn primary block" Content="Change password" Command="{Binding ResetCommand}" IsDefault="{Binding IsEnteringCode}"/>
                        <Button Classes="link" Content="Use another email" FontSize="14" HorizontalAlignment="Center" Command="{Binding UseAnotherEmailCommand}"/>
                    </StackPanel>
                    <Button Classes="link" Content="Back to Log in" FontSize="14" HorizontalAlignment="Center" Command="{Binding BackCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Panel>
</UserControl>
