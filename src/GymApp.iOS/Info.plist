<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>GainStreak</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/AppIcon.appiconset</string>
	<!-- The system's launch screen: the flame on the page colour, until the app's own SplashView draws -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
	</dict>
	<!-- The live workout's Live Activity (0.20.0): the Dynamic Island and the Lock Screen show the percent done -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Apple Health's permission texts (Phase 20); HealthKit throws without them -->
	<key>NSHealthShareUsageDescription</key>
	<string>GainStreak reads your weight, height, birth date, sex and steps to fill in your profile and suggest your activity level. It stays on your phone.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>GainStreak saves your workouts, cardio sessions and weigh-ins to Health.</string>
	<!-- HTTPS only, so no export-compliance questions on upload -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GainStreak checks that you're at one of your gyms during a workout and notices when you're travelling. Your location stays on your phone unless you ask for gyms near you.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
