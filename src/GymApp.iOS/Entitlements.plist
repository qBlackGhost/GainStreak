<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Keychain, where KeychainTokenStore keeps the session token. Without it every write fails with
	     errSecMissingEntitlement (found in 16c) -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.gainstreak.app</string>
	</array>
	<!-- Apple Health (Phase 20). Signed builds need the App ID com.gainstreak.app to have the HealthKit capability,
	     and a profile made after it was added -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- A Simulator build is signed ad hoc and .NET leaves this out, so HealthKit refused everything (found in 20a).
	     Device builds get the same value from the profile -->
	<key>application-identifier</key>
	<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
