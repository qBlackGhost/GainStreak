<Project Sdk="Microsoft.NET.Sdk">
  <!-- The iOS head (16c): starts the shared GymApp.App on iOS 16 and later -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GymApp.iOS</RootNamespace>
    <ApplicationId>com.gainstreak.app</ApplicationId>
    <ApplicationTitle>GainStreak</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- CFBundleVersion: only goes up. build/release-mobile.sh sets it to the commit count -->
    <ApplicationVersion>1</ApplicationVersion>
    <DefaultDebugServerUrl>http://localhost:5080</DefaultDebugServerUrl>
    <!-- Everything is compiled ahead of time; the interpreter runs only code generated at runtime ("-all" interprets no
         assembly). EF Core needs it: it turns every LINQ query into code at runtime, and iOS can't run that otherwise
         ("Query wasn't precompiled and dynamic code isn't supported", found in 16c). Decided in 16c over EF's
         experimental precompiled queries. The compiled model (GymApp.Data/CompiledModels) still saves model building -->
    <MtouchInterpreter>-all</MtouchInterpreter>
    <!-- Trim the SDK as a device build does: with the interpreter on, a Simulator build would otherwise trim nothing
         and take over 30 minutes -->
    <MtouchLink>SdkOnly</MtouchLink>
    <!-- Keychain access (KeychainTokenStore); without it the Keychain refuses every write -->
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- .NET for iOS 27.1 (the newest workload, Nov 2026) asks for Xcode 27.1 and refuses to build with this Mac's 27.2.
         A point release apart builds and runs fine (checked in 0.18.1 on the Simulator, Debug and Release). Drop this
         once a workload for Xcode 27.2 ships; -p:ValidateXcodeVersion=true turns the check back on for one build -->
    <ValidateXcodeVersion Condition="'$(ValidateXcodeVersion)' == ''">false</ValidateXcodeVersion>
  </PropertyGroup>

  <!-- Entitlements need a signed app. The Simulator takes an ad-hoc signature, so it needs no Apple certificate; device
       and TestFlight builds sign with the distribution certificate and profile build/release-mobile.sh passes in -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('iossimulator'))">
    <CodesignKey>-</CodesignKey>
  </PropertyGroup>

  <!-- Friend notifications (Phase 22): APNs' sandbox for Debug builds, production for TestFlight and the App Store.
       Signed builds need Push Notifications on the App ID com.gainstreak.app, and profiles made after it was added -->
  <ItemGroup>
    <CustomEntitlements Include="aps-environment" Type="String" Value="development" Condition="'$(Configuration)' != 'Release'" />
    <CustomEntitlements Include="aps-environment" Type="String" Value="production" Condition="'$(Configuration)' == 'Release'" />
  </ItemGroup>

  <!-- A free Apple account (Personal Team) on your own phone: build/run-on-phone.sh passes -p:FreeAppleAccount=true.
       Personal Teams can't have Push Notifications or Associated Domains, so this build drops them (no friend pushes,
       invite links open Safari), and it needs a bundle id of its own (com.gainstreak.app is the store's App ID; override
       with -p:FreeBundleId=...). Its profiles come from Xcode (see the script) and expire after 7 days -->
  <PropertyGroup Condition="'$(FreeAppleAccount)' == 'true'">
    <ApplicationId Condition="'$(FreeBundleId)' != ''">$(FreeBundleId)</ApplicationId>
    <ApplicationId Condition="'$(FreeBundleId)' == ''">com.gainstreak.app.dev</ApplicationId>
  </PropertyGroup>
  <ItemGroup Condition="'$(FreeAppleAccount)' == 'true'">
    <CustomEntitlements Remove="aps-environment" />
    <CustomEntitlements Include="com.apple.developer.associated-domains" Type="Remove" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GymApp.App\GymApp.App.csproj" />
  </ItemGroup>

  <!-- The live workout's Live Activity (0.20.0): Swift from src/GymApp.iOS.LiveActivity, built by its build.sh before
       this project builds. The bridge framework is what IosLiveActivity calls; the widget extension draws the Dynamic
       Island. Device builds for TestFlight also need the extension's own App Store profile (App ID
       com.gainstreak.app.LiveActivity): -p:LiveActivityProvisioningProfile=<path to its .mobileprovision> -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LiveActivityDir>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory), '..', 'GymApp.iOS.LiveActivity'))</LiveActivityDir>
    <LiveActivitySdk Condition="$(RuntimeIdentifier.StartsWith('iossimulator'))">iphonesimulator</LiveActivitySdk>
    <LiveActivitySdk Condition="'$(LiveActivitySdk)' == ''">iphoneos</LiveActivitySdk>
    <LiveActivityOut>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), 'obj', 'liveactivity', $(Configuration), $(LiveActivitySdk)))</LiveActivityOut>
  </PropertyGroup>

  <ItemGroup>
    <LiveActivitySource Include="$(LiveActivityDir)**\*.swift;$(LiveActivityDir)build.sh" />
    <NativeReference Include="$(LiveActivityOut)/GainStreakLiveActivityBridge.framework">
      <Kind>Framework</Kind>
      <SmartLink>false</SmartLink>
    </NativeReference>
    <AdditionalAppExtensions Include="$(LiveActivityOut)">
      <Name>GainStreakLiveActivity</Name>
      <BuildOutput>.</BuildOutput>
      <CodesignWarnIfNoEntitlements>false</CodesignWarnIfNoEntitlements>
    </AdditionalAppExtensions>
  </ItemGroup>

  <!-- What the Swift build stamps into the bundles: a change rebuilds it -->
  <Target Name="WriteLiveActivitySettings">
    <PropertyGroup>
      <LiveActivitySettings>$(LiveActivityOut).settings</LiveActivitySettings>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(LiveActivityOut)))" />
    <WriteLinesToFile File="$(LiveActivitySettings)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="$(ApplicationDisplayVersion);$(ApplicationVersion);$(ApplicationId);$(LiveActivityProvisioningProfile)" />
  </Target>

  <Target Name="BuildLiveActivity" BeforeTargets="PrepareForBuild" DependsOnTargets="WriteLiveActivitySettings"
          Inputs="@(LiveActivitySource);$(LiveActivitySettings)" Outputs="$(LiveActivityOut)/GainStreakLiveActivity.appex/Info.plist">
    <Error Condition="'$(LiveActivitySdk)' == 'iphoneos' and '$(CodesignProvision)' != '' and '$(LiveActivityProvisioningProfile)' == ''"
           Text="A signed device build needs the Live Activity extension's own profile: -p:LiveActivityProvisioningProfile=&lt;path to the com.gainstreak.app.LiveActivity .mobileprovision&gt;" />
    <Exec Command="&quot;$(LiveActivityDir)build.sh&quot; $(LiveActivitySdk) &quot;$(LiveActivityOut)&quot; &quot;$(ApplicationDisplayVersion)&quot; &quot;$(ApplicationVersion)&quot; &quot;$(ApplicationId)&quot; &quot;$(LiveActivityProvisioningProfile)&quot;" />
  </Target>

  <Import Project="..\MobileHead.targets" />
</Project>
